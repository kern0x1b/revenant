#!/bin/sh
set -eu

root=$(cd "$(dirname "$0")" && pwd)
package=$root/packages/x/xmake
recipe=$package/xmake.lua

common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
if [ -n "$common" ]; then
    checkout=$(dirname "$common")
else
    checkout=$root
fi
gitdir=$(git -C "$root" rev-parse --path-format=absolute --git-dir 2>/dev/null || true)
if [ -n "${REVENANT_CACHE:-}" ]; then
    cache=$REVENANT_CACHE
elif [ -n "$common" ] && [ "$gitdir" != "$common" ]; then
    cache=$root/.cache
else
    cache=$checkout/.cache
fi
case $cache in
    /*) ;;
    *) cache=$(pwd)/$cache ;;
esac
REVENANT_CACHE=$cache
export REVENANT_CACHE
store=${REVENANT_STORE:-}
if [ -z "$store" ]; then
    if [ -z "${HOME:-}" ]; then
        echo "xmakew: HOME is unset, so the shared store has no default place: set REVENANT_STORE to an absolute path" >&2
        exit 1
    fi
    store=$HOME/.revenant/store
fi
case $store in
    /*) ;;
    *)
        echo "xmakew: REVENANT_STORE is $store, which is not an absolute path" >&2
        exit 1
        ;;
esac
physical() {
    head=${1%/}
    rest=""
    while [ -n "$head" ] && [ ! -d "$head" ]; do
        rest=/$(basename "$head")$rest
        head=$(dirname "$head")
    done
    real=$(cd "${head:-/}" && pwd -P)
    [ "$real" != / ] || real=""
    printf '%s%s\n' "$real" "$rest"
}
case "$(physical "$cache")/" in
    "$(physical "$store")"/*)
        echo "xmakew: REVENANT_CACHE is $cache, which is the shared store $store or lies inside it: the cache is trimmed to REVENANT_CACHE_GB and would evict the installs of the store, so nothing was started. REVENANT_CACHE is the cache of one checkout (by default <checkout>/.cache); the store is REVENANT_STORE, and the two are different folders" >&2
        exit 1
        ;;
esac
REVENANT_STORE=$store
export REVENANT_STORE
GIT_CEILING_DIRECTORIES=$cache:$store${GIT_CEILING_DIRECTORIES:+:$GIT_CEILING_DIRECTORIES}
export GIT_CEILING_DIRECTORIES

url=$(sed -n 's/^ *add_urls("\([^"]*\)").*/\1/p' "$recipe")
commit=$(sed -n 's/^ *add_versions("[^"]*", *"\([0-9a-f]*\)").*/\1/p' "$recipe")
patches=$(sed -n 's/^ *{"\([^"]*\.patch\)", *"\([0-9a-f]*\)"}.*/\1 \2/p' "$recipe")
if [ -z "$url" ] || [ -z "$commit" ]; then
    echo "xmakew: no url or commit in $recipe" >&2
    exit 1
fi

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$@"
    else
        shasum -a 256 "$@"
    fi
}

patchset() {
    marked=""
    while read -r name checksum; do
        [ -n "$name" ] || continue
        declared=$(awk '/^---$/{exit} /^Changes-build-output: (yes|no)$/{print $2}' "$1/$name" | head -n 1)
        if [ "$declared" = yes ]; then
            marked="$marked$name $checksum
"
        elif [ "$declared" != no ]; then
            echo "xmakew: $name does not declare Changes-build-output: yes or no" >&2
            exit 1
        fi
    done <<EOF
$3
EOF
    if [ -n "$marked" ]; then
        printf '%s\n%s' "$2" "$marked" | sha256 | cut -d' ' -f1
    fi
}

if [ "${1:-}" = --patchset ]; then
    patchset "$2" "$3" "$4"
    exit 0
fi

key=$( (printf '%s\n%s\n' "$commit" "$patches"; cat "$root/xmakew") | sha256 | cut -c1-16)
digest=$(patchset "$package/patches" "$commit" "$patches")
xmakes=$store/xmake
prefix=$xmakes/$key

holder=$xmakes/$key.holder

start_of() {
    echo $(ps -o lstart= -p "$1" 2>/dev/null)
}

holder_of() {
    pid=""
    started=""
    began=""
    if [ -r "$holder" ]; then
        read -r pid started began < "$holder" || true
    fi
    if [ -z "$pid" ] || [ -z "$started" ] || [ -z "$began" ]; then
        echo "whose holder recorded no process (it has only just started, or it is an older xmakew)"
    elif [ "$(start_of "$pid")" = "$began" ]; then
        echo "which process $pid has held for $(( $(date +%s) - started )) s (its log is $xmakes/$key.log)"
    else
        echo "which process $pid held for $(( $(date +%s) - started )) s and which has ended (its number is free or another process has it now), while a process it started still holds the lock (its log is $xmakes/$key.log)"
    fi
}

exclusively() {
    lockfile=$1
    shift
    limit=${REVENANT_XMAKE_BUILD_WAIT:-1800}
    poll=${REVENANT_XMAKE_BUILD_POLL:-30}
    case $limit$poll in
        *[!0-9]*|"")
            echo "xmakew: REVENANT_XMAKE_BUILD_WAIT is $limit and REVENANT_XMAKE_BUILD_POLL is $poll; both are whole numbers of seconds" >&2
            return 1 ;;
    esac
    if [ "$limit" -lt 1 ] || [ "$poll" -lt 1 ]; then
        echo "xmakew: REVENANT_XMAKE_BUILD_WAIT is $limit and REVENANT_XMAKE_BUILD_POLL is $poll; both must be at least 1 second" >&2
        return 1
    fi
    if command -v flock >/dev/null 2>&1; then
        locker=flock
    elif command -v lockf >/dev/null 2>&1; then
        locker=lockf
    else
        echo "xmakew: neither flock nor lockf is installed, so two builds of the xmake could not be kept apart" >&2
        return 1
    fi
    waited=0
    while :; do
        status=0
        if [ "$locker" = flock ]; then
            flock -E 75 -w "$poll" "$lockfile" "$@" || status=$?
        else
            lockf -s -k -t "$poll" "$lockfile" "$@" || status=$?
        fi
        if [ "$status" -ne 75 ]; then
            return "$status"
        fi
        waited=$((waited + poll))
        echo "xmakew: waited $waited s for the build of xmake $key, $(holder_of)" >&2
        if [ "$waited" -ge "$limit" ]; then
            echo "xmakew: gave up on the build of xmake $key after $waited s: if it has hung, stop the process above (and any make or compiler it started) and run this again; REVENANT_XMAKE_BUILD_WAIT sets how many seconds to wait (1800 by default)" >&2
            return 1
        fi
    done
}

build_xmake() {
    if [ -x "$prefix/bin/xmake" ]; then
        return 0
    fi
    work=$xmakes/$key.build.$$
    log=$xmakes/$key.log
    mkdir -p "$work/src"
    trap 'rm -rf "$work" "$holder" "$holder.$$"' EXIT INT TERM
    printf '%s %s %s\n' "$$" "$(date +%s)" "$(start_of "$$")" > "$holder.$$"
    mv "$holder.$$" "$holder"
    echo "xmakew: building xmake $commit with its patches into $prefix, log in $log" >&2
    {
        git -C "$work/src" init -q
        git -C "$work/src" remote add origin "$url"
        git -C "$work/src" fetch -q --depth 1 origin "$commit"
        git -C "$work/src" -c advice.detachedHead=false checkout -q FETCH_HEAD
        git -C "$work/src" submodule -q update --init --recursive --depth 1
    } > "$log" 2>&1
    printf '%s\n' "$patches" | while read -r name checksum; do
        [ -n "$name" ] || continue
        actual=$(sha256 "$package/patches/$name" | cut -d' ' -f1)
        if [ "$actual" != "$checksum" ]; then
            echo "xmakew: $name has the checksum $actual, the recipe says $checksum" >&2
            exit 1
        fi
        git -C "$work/src" apply "$package/patches/$name"
    done
    (
        cd "$work/src"
        ./configure --prefix="$work/install"
        make -j"${XMAKE_MAX_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
        make install
        mkdir -p "$work/install/share/xmake"
        printf '%s\n' "$digest" > "$work/install/share/xmake/revenant-patch-set"
        mkdir -p "$work/lua"
        for file in core/src/lua/lua/*.c core/src/lua/lua/*.h; do
            case ${file##*/} in
                onelua.c) ;;
                *) cp "$file" "$work/lua/" ;;
            esac
        done
        if [ "$(uname -s)" = Darwin ]; then
            system=LUA_USE_MACOSX libs=-lm
        else
            system=LUA_USE_LINUX libs="-lm -ldl"
        fi
        cc -O2 -DLUA_COMPAT_5_1 -DLUA_COMPAT_5_2 -DLUA_COMPAT_5_3 -D$system -o "$work/install/bin/lua" "$work"/lua/*.c $libs
    ) >> "$log" 2>&1
    rm -rf "$prefix"
    mv "$work/install" "$prefix"
    rm -rf "$work" "$log" "$holder"
    trap - EXIT INT TERM
}

if [ "${1:-}" = --build-xmake ]; then
    build_xmake
    exit 0
fi

project=$root
previous=""
for argument in "$@"; do
    case $previous in
        -P | --project) project=$argument ;;
    esac
    case $argument in
        --project=*) project=${argument#--project=} ;;
        -P?*) project=${argument#-P} ;;
    esac
    previous=$argument
done
case $project in
    /*) ;;
    *) project=$(pwd)/$project ;;
esac
lock=$project/xmake-requires.lock
if [ -f "$lock" ]; then
    here=$(physical "$root")
    head=$(git -C "$root" rev-parse HEAD 2>/dev/null || true)
    pins=$(awk '
        /^[ \t]*\["/ { inside = ($0 ~ /^[ \t]*\["revenant@/); commit = ""; next }
        inside && /^[ \t]*commit = "/ { value = $0; sub(/^[^"]*"/, "", value); sub(/".*$/, "", value); commit = value }
        inside && /^[ \t]*url = "/ { value = $0; sub(/^[^"]*"/, "", value); sub(/".*$/, "", value); print (commit == "" ? "-" : commit) " " value; inside = 0 }
    ' "$lock" | sort | uniq -c)
    stale=""
    while read -r count pinned address; do
        [ -n "$count" ] || continue
        case $address in
            /*) [ "$(physical "$address")" = "$here" ] || stale="$stale$count $pinned $address
" ;;
        esac
        if [ -z "$stale" ] && [ -n "$head" ] && [ "$pinned" != - ] && [ "$pinned" != "$head" ]; then
            stale="$count $pinned $address
"
        fi
    done <<EOF
$pins
EOF
    if [ -n "$stale" ]; then
        read -r count pinned address <<EOF
$stale
EOF
        where=" at commit $pinned"
        [ "$pinned" != - ] || where=" with no commit recorded"
        echo "xmakew: $lock names the revenant package repository $address$where for $count package entries (more may differ), but this xmakew is the checkout $here at commit ${head:-unknown}: with package.requires_lock xmake reads the package recipes from the locked repository and commit, not from this checkout, so the build would run this checkout's toolchain over the recipes of another pin and install what that pin asks for (hours of compiling for packages nothing here uses). Nothing was started. Refresh the lock for this checkout: delete $lock, run the build once (xmakew build -P $project -y <target>) so that xmake writes a new lock with this checkout as the repository, look at its diff and commit it together with the pin." >&2
        exit 1
    fi
fi

for part in xmake xmake-global; do
    if [ ! -L "$cache/$part" ] && [ -e "$cache/$part" ]; then
        seeder=""
        for candidate in "$cache"/xmake/*/bin/xmake "$store"/xmake/*/bin/xmake; do
            if [ -x "$candidate" ]; then
                seeder=$candidate
                break
            fi
        done
        echo "xmakew: $cache/$part is a package store of its own, made before the shared store $store, and nothing reads it any more: remove $cache/xmake and $cache/xmake-global (the installs come again from the prebuilt releases or are built once), or keep the installs by seeding the shared store from this cache, once, while $store does not exist, with the seed command below; never point REVENANT_CACHE or REVENANT_STORE at the other one's folder (docs/guides/machine.md, 'The shared store')" >&2
        if [ -n "$seeder" ]; then
            echo "xmakew: seed: cd '$root' && '$seeder' l -P . tools/private_cache.lua '$store' --from '$cache' --only xmake,xmake-global" >&2
        else
            echo "xmakew: $cache/xmake holds no xmake to run the seeding with, so remove the folders" >&2
        fi
        exit 1
    fi
done

for part in xmake xmake-global; do
    mkdir -p "$store/$part" "$cache"
    if [ -L "$cache/$part" ]; then
        [ "$(readlink "$cache/$part")" = "$store/$part" ] || ln -sfn "$store/$part" "$cache/$part"
    else
        ln -sfn "$store/$part" "$cache/$part"
    fi
done

if [ ! -x "$prefix/bin/xmake" ]; then
    exclusively "$xmakes/$key.lock" "$root/xmakew" --build-xmake
fi

XMAKE_GLOBALDIR=$store/xmake-global
export XMAKE_GLOBALDIR

scratch_stamp=$cache/.scratch-swept
if [ -z "$(find "$scratch_stamp" -mmin -1440 2>/dev/null)" ]; then
    "$prefix/bin/xmake" l -P "$root" "$root/tools/clean.lua" --scratch || echo "xmakew: the scratch retention did not finish" >&2
fi

run_xmake() {
    case " $* " in
        *" -P "* | *" --project"*)
            "$prefix/bin/xmake" "$@"
            ;;
        *)
            if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
                command=$1
                shift
                "$prefix/bin/xmake" "$command" -P "$root" "$@"
            else
                "$prefix/bin/xmake" -P "$root" "$@"
            fi
            ;;
    esac
}

case ${1:-} in
    f | build | rebuild | test | install | run | package | deb)
        if [ -z "${REVENANT_BUDGET_HELD:-}" ]; then
            status=0
            "$prefix/bin/xmake" l -P "$root" "$root/tools/budget.lua" run --class normal --jobs 6 --min 2 -- "$root/xmakew" "$@" || status=$?
            exit $status
        fi
        "$prefix/bin/xmake" l -P "$root" "$root/tools/cache.lua" guard "$root" || exit 1
        status=0
        run_xmake "$@" || status=$?
        "$prefix/bin/xmake" l -P "$root" "$root/tools/cache.lua" record "$root" || echo "xmakew: the cache record did not finish" >&2
        exit $status
        ;;
esac
run_xmake "$@"
