{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "600000"
  },
  "permissions": {
    "deny": [
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f *)",
      "Bash(git rebase *)",
      "Bash(git commit --amend *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(pkill -f *)",
      "Bash(sed -i *)",
      "Bash(perl -i *)"
    ]
  },
  "autoMemoryEnabled": false,
  "extraKnownMarketplaces": {
    "xmake-skills": {
      "source": {
        "source": "github",
        "repo": "xmake-io/xmake-skills",
        "ref": "master"
      }
    }
  },
  "enabledPlugins": {
    "xmake-skills@xmake-skills": true
  }
}
