+-- get the information of the given installed version of an addon, whether it is active or not
+--
+-- @return  the addon information, e.g. {version = "1.0.2", repo = {...}}, @see addon.register
+--
+function addon.versioninfo(name, version)
+    local addoninfo = addon._registry()[addon.dirname(name)]
+    return addoninfo and addoninfo.versions and addoninfo.versions[version]
+end
