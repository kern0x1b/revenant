 tests/actions/addon/test.lua                  | 100 +++++++++++-------
 xmake/core/package/addon.lua                  |   6 +-
 .../modules/import/core/package/addon.lua     |   1 +
 .../action/addon/impl/install_addons.lua      |   2 +-
 .../private/action/addon/impl/xrepo.lua       |   2 +-
 .../action/require/impl/actions/install.lua   |  16 ++-
