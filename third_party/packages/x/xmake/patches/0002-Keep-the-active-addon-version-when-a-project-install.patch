diff --git a/xmake/modules/private/action/require/impl/register_packages.lua b/xmake/modules/private/action/require/impl/register_packages.lua
index 2cc50d2..64d447f 100644
--- a/xmake/modules/private/action/require/impl/register_packages.lua
+++ b/xmake/modules/private/action/require/impl/register_packages.lua
@@ -22,6 +22,7 @@
 import("core.project.project")
 import("core.cache.localcache")
 import("core.package.addon")
+import("private.action.require.impl.actions.install", {alias = "action_install"})
 
 -- register required package environments
 -- envs: bin path for *.dll, program ..
@@ -143,7 +144,7 @@ function main(packages)
     -- activate the required versions of the installed addons, so that the projects lock them,
     -- @see xmake/modules/private/action/addon/impl/install_addons.lua
     for _, instance in ipairs(packages) do
-        if instance:is_addon() and instance:exists() then
+        if instance:is_addon() and instance:exists() and action_install.activates_addon(instance) then
             addon.activate(instance:name(), instance:version_str() or "latest")
         end
     end
