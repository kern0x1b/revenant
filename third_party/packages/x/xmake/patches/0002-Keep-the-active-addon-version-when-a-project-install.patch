-                os.runv("xmake", {"addon", "--install", "-y", "custom-include 2.0.0"})
-                t:are_equal(_active_version("custom-include"), "2.0.0")
-                _with_project("autofetch-release", function (projectdir)
-
-                    -- the declared version has been installed, so we only need to lock it and load it
-                    t:require(os.iorunv("xmake", {"config", "-y"}):find("custom-include: release 1.0.0 is loaded", 1, true))
-                    t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
-
-                    -- installing the other version again activates it, but it must not change this project
-                    os.runv("xmake", {"addon", "--install", "--force", "-y", "custom-include 2.0.0"})
-                    t:are_equal(_active_version("custom-include"), "2.0.0")
-                    t:require(os.iorunv("xmake", {"config", "-y"}):find("custom-include: release 1.0.0 is loaded", 1, true))
-                    t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
-
-                    -- and the upgrade resolves the declaration again, not the active version
-                    os.runv("xmake", {"addon", "--upgrade", "-y"})
-                    t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
-                end)
-            end)
-        end,
-        finally
-        {
-            -- @note try() swallows the errors if we do not re-raise them here
-            function (ok, errors)
-                os.tryrm(gitdir)
-                if not ok then
-                    raise(errors)
-                end
-            end
-        }
-    }
+    _with_releases("custom-include", {"1.0.0", "2.0.0"}, function ()
+        os.runv("xmake", {"addon", "--install", "-y", "custom-include 1.0.0"})
+        os.runv("xmake", {"addon", "--install", "-y", "custom-include 2.0.0"})
+        t:are_equal(_active_version("custom-include"), "2.0.0")
+        _with_project("autofetch-release", function (projectdir)
+
+            -- the declared version has been installed, so we only need to lock it and load it
+            t:require(os.iorunv("xmake", {"config", "-y"}):find("custom-include: release 1.0.0 is loaded", 1, true))
+            t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
+
+            -- installing the other version again activates it, but it must not change this project
+            os.runv("xmake", {"addon", "--install", "--force", "-y", "custom-include 2.0.0"})
+            t:are_equal(_active_version("custom-include"), "2.0.0")
+            t:require(os.iorunv("xmake", {"config", "-y"}):find("custom-include: release 1.0.0 is loaded", 1, true))
+            t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
+
+            -- and the upgrade resolves the declaration again, not the active version
+            os.runv("xmake", {"addon", "--upgrade", "-y"})
+            t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
+        end)
+    end)
+end
+
+-- a project installs the version which it declares for itself, the machine keeps its active version,
+-- the other projects and the commands outside of a project still use it
+function test_autofetch_keep_active_version(t)
+    _with_releases("custom-include", {"1.0.0", "2.0.0"}, function ()
+        os.runv("xmake", {"addon", "--install", "-y", "custom-include 2.0.0"})
+        _with_project("autofetch-release", function (projectdir)
+
+            -- the declared version is not installed yet, the project installs, locks and loads it
+            local output = os.iorunv("xmake", {"config", "-y"})
+            t:require(output:find("this project needs the addons", 1, true))
+            t:require(output:find("custom-include: release 1.0.0 is loaded", 1, true))
+            t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
+            t:are_equal(_active_version("custom-include"), "2.0.0")
+        end)
+    end)
 end
 
 -- a locked version which is not installed must not hide the addon
diff --git a/xmake/core/package/addon.lua b/xmake/core/package/addon.lua
index 0c81c82a6..6d0f4cbce 100644
--- a/xmake/core/package/addon.lua
+++ b/xmake/core/package/addon.lua
@@ -728,7 +728,7 @@ end
 --
 -- @param name      the addon name
 -- @param version   the addon version, e.g. "1.0.1", "latest"
--- @param opt       the options, e.g. {description = "...", deps = {"foo"}}
+-- @param opt       the options, e.g. {description = "...", deps = {"foo"}, activate = false}
 --
 -- @note the addon manifest(addon.lua) is only read when installing, everything which
 -- is needed later is recorded here, so we never parse it again
@@ -763,8 +763,11 @@ function addon.register(name, version, opt)
         return false, errors
     end
 
-    -- we can install several versions of an addon at the same time,
-    -- and the version which we install now is always the active one
+    -- we can install several versions of an addon at the same time, and the version which we
+    -- install now becomes the active one, unless it is only installed for a project which locks it,
+    -- @see private/action/require/impl/actions/install.lua
+    --
+    -- @note an addon always has an active version, so its first version is always activated
     local registry = addon._registry()
     local entry = registry[dirname]
     if entry == nil or entry.versions == nil then
@@ -772,7 +775,9 @@ function addon.register(name, version, opt)
         registry[dirname] = entry
     end
     entry.versions[version] = addoninfo
-    entry.active = version
+    if opt.activate ~= false or entry.versions[entry.active] == nil then
+        entry.active = version
+    end
     addon._save(registry)
     return true
 end
