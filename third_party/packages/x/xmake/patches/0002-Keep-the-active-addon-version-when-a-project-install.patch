diff --git a/tests/actions/addon/test.lua b/tests/actions/addon/test.lua
index 6da1da2..ae3627d 100644
--- a/tests/actions/addon/test.lua
+++ b/tests/actions/addon/test.lua
@@ -166,7 +166,37 @@ function _release(name, versions, gitdir)
         git({"commit", "-q", "-m", version})
         body = body .. ("\n    add_versions(%q, %q)"):format(version, git({"rev-parse", "HEAD"}):trim())
     end
-    return body
+    return body .. ([[
+
+    on_test(function (package)
+        import("core.package.addon")
+        local addoninfo = addon.addons()[%q]
+        assert(addoninfo and addoninfo.version == package:version_str(), "the addon sees %%s while installing %%s!",
+            addoninfo and addoninfo.version, package:version_str())
+    end)]]):format(name)
+end
+
+function _with_releases(name, versions, func)
+    local gitdir = os.tmpfile() .. ".addon-release"
+    os.tryrm(gitdir)
+    try
+    {
+        function ()
+            _with_repo({[name] = _release(name, versions, gitdir)}, function ()
+                _remove(name)
+                func()
+            end)
+        end,
+        finally
+        {
+            function (ok, errors)
+                os.tryrm(gitdir)
+                if not ok then
+                    raise(errors)
+                end
+            end
+        }
+    }
 end
 
 function _active_version(name)
@@ -531,42 +561,38 @@ function test_autofetch_declared_version(t)
 end
 
 function test_autofetch_lock_declared_version(t)
-    local gitdir = os.tmpfile() .. ".addon-release"
-    os.tryrm(gitdir)
-    local recipes = {["custom-include"] = _release("custom-include", {"1.0.0", "2.0.0"}, gitdir)}
-    try
-    {
-        function ()
-            _with_repo(recipes, function ()
-                _remove("custom-include")
-                os.runv("xmake", {"addon", "--install", "-y", "custom-include 1.0.0"})
-                os.runv("xmake", {"addon", "--install", "-y", "custom-include 2.0.0"})
-                t:are_equal(_active_version("custom-include"), "2.0.0")
-                _with_project("autofetch-release", function (projectdir)
-
-                    t:require(os.iorunv("xmake", {"config", "-y"}):find("custom-include: release 1.0.0 is loaded", 1, true))
-                    t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
-
-                    os.runv("xmake", {"addon", "--install", "--force", "-y", "custom-include 2.0.0"})
-                    t:are_equal(_active_version("custom-include"), "2.0.0")
-                    t:require(os.iorunv("xmake", {"config", "-y"}):find("custom-include: release 1.0.0 is loaded", 1, true))
-                    t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
-
-                    os.runv("xmake", {"addon", "--upgrade", "-y"})
-                    t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
-                end)
-            end)
-        end,
-        finally
-        {
-            function (ok, errors)
-                os.tryrm(gitdir)
-                if not ok then
-                    raise(errors)
-                end
-            end
-        }
-    }
+    _with_releases("custom-include", {"1.0.0", "2.0.0"}, function ()
+        os.runv("xmake", {"addon", "--install", "-y", "custom-include 1.0.0"})
+        os.runv("xmake", {"addon", "--install", "-y", "custom-include 2.0.0"})
+        t:are_equal(_active_version("custom-include"), "2.0.0")
+        _with_project("autofetch-release", function (projectdir)
+
+            t:require(os.iorunv("xmake", {"config", "-y"}):find("custom-include: release 1.0.0 is loaded", 1, true))
+            t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
+
+            os.runv("xmake", {"addon", "--install", "--force", "-y", "custom-include 2.0.0"})
+            t:are_equal(_active_version("custom-include"), "2.0.0")
+            t:require(os.iorunv("xmake", {"config", "-y"}):find("custom-include: release 1.0.0 is loaded", 1, true))
+            t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
+
+            os.runv("xmake", {"addon", "--upgrade", "-y"})
+            t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
+        end)
+    end)
+end
+
+function test_autofetch_keep_active_version(t)
+    _with_releases("custom-include", {"1.0.0", "2.0.0"}, function ()
+        os.runv("xmake", {"addon", "--install", "-y", "custom-include 2.0.0"})
+        _with_project("autofetch-release", function (projectdir)
+
+            local output = os.iorunv("xmake", {"config", "-y"})
+            t:require(output:find("this project needs the addons", 1, true))
+            t:require(output:find("custom-include: release 1.0.0 is loaded", 1, true))
+            t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
+            t:are_equal(_active_version("custom-include"), "2.0.0")
+        end)
+    end)
 end
 
 -- a locked version which is not installed must not hide the addon
diff --git a/xmake/core/package/addon.lua b/xmake/core/package/addon.lua
index e0b2e3d..05c7e5c 100644
--- a/xmake/core/package/addon.lua
+++ b/xmake/core/package/addon.lua
@@ -759,8 +759,6 @@ function addon.register(name, version, opt)
         return false, errors
     end
 
-    -- we can install several versions of an addon at the same time,
-    -- and the version which we install now is always the active one
     local registry = addon._registry()
     local entry = registry[dirname]
     if entry == nil or entry.versions == nil then
@@ -768,7 +766,9 @@ function addon.register(name, version, opt)
         registry[dirname] = entry
     end
     entry.versions[version] = addoninfo
-    entry.active = version
+    if opt.activate ~= false or entry.versions[entry.active] == nil then
+        entry.active = version
+    end
     addon._save(registry)
     return true
 end
diff --git a/xmake/core/sandbox/modules/import/core/package/addon.lua b/xmake/core/sandbox/modules/import/core/package/addon.lua
index d967738..6bf9529 100644
--- a/xmake/core/sandbox/modules/import/core/package/addon.lua
+++ b/xmake/core/sandbox/modules/import/core/package/addon.lua
@@ -37,6 +37,7 @@ sandbox_core_package_addon.addons            = addon.addons
 sandbox_core_package_addon.versions          = addon.versions
 sandbox_core_package_addon.activate          = addon.activate
 sandbox_core_package_addon.versioninfo       = addon.versioninfo
+sandbox_core_package_addon.pin               = addon.pin
 sandbox_core_package_addon.unregister        = addon.unregister
 
 -- get the manifest of the given addon directory, e.g. <sourcedir>/addon.lua
diff --git a/xmake/modules/private/action/addon/impl/install_addons.lua b/xmake/modules/private/action/addon/impl/install_addons.lua
index aa00788..0c9e8d5 100644
--- a/xmake/modules/private/action/addon/impl/install_addons.lua
+++ b/xmake/modules/private/action/addon/impl/install_addons.lua
@@ -147,7 +147,7 @@ function main(projectdir, datafile, opt)
     try
     {
         function ()
-            xrepo_addon("install", requires, {includes = rcfile})
+            xrepo_addon("install", requires, {includes = rcfile, envs = {XMAKE_IN_ADDONS_AUTOFETCH = "1"}})
         end,
         finally
         {
diff --git a/xmake/modules/private/action/addon/impl/xrepo.lua b/xmake/modules/private/action/addon/impl/xrepo.lua
index 46ada2d..2c62062 100644
--- a/xmake/modules/private/action/addon/impl/xrepo.lua
+++ b/xmake/modules/private/action/addon/impl/xrepo.lua
@@ -53,5 +53,5 @@ function main(action, names, opt)
     end
 
     table.join2(argv, names)
-    os.execv(os.programfile(), argv, {curdir = opt.curdir or addon.workdir()})
+    os.execv(os.programfile(), argv, {curdir = opt.curdir or addon.workdir(), envs = opt.envs})
 end
diff --git a/xmake/modules/private/action/require/impl/actions/install.lua b/xmake/modules/private/action/require/impl/actions/install.lua
index eb5aea2..13a0326 100644
--- a/xmake/modules/private/action/require/impl/actions/install.lua
+++ b/xmake/modules/private/action/require/impl/actions/install.lua
@@ -284,6 +284,11 @@ function _merge_staticlibs(package)
     end
 end
 
+function activates_addon(package)
+    return not (os.getenv("XMAKE_IN_ADDONS_AUTOFETCH") and package:is_toplevel()
+                and package:requireinfo().version ~= "latest")
+end
+
 -- register the installed addon, so that xmake can find its payloads, e.g. plugins
 --
 -- @note the addon manifest(addon.lua) is only read when installing it, everything which
@@ -318,14 +323,21 @@ function _register_addon(package)
         end
     end
 
+    local version = package:version_str() or "latest"
+    local activate = activates_addon(package)
+
     -- we also record where it comes from, so that the projects can lock it,
     -- @see xmake/modules/private/action/addon/impl/install_addons.lua
     local repo = package:repo()
-    addon.register(package:name(), package:version_str() or "latest",
-        {description = description, deps = deps,
+    addon.register(package:name(), version,
+        {description = description, deps = deps, activate = activate,
          repo = repo and {url = repo:url(), commit = repo:commit(), branch = repo:branch()} or nil,
          manifest_deps = manifest and manifest.deps or nil,
          globalmodules = manifest and #manifest.globalmodules > 0 and manifest.globalmodules or nil})
+
+    if not activate then
+        addon.pin(package:name(), version)
+    end
 end
 
