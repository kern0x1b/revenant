diff --git a/tests/actions/addon/test.lua b/tests/actions/addon/test.lua
index 6f78cfc3d..25d0783b0 100644
--- a/tests/actions/addon/test.lua
+++ b/tests/actions/addon/test.lua
@@ -152,7 +152,8 @@ end
 -- release the given addon fixture with the given versions, and get the recipe which distributes them
 --
 -- every version is a commit of a git repository which only differs by `includes/release`,
--- so a project can tell which version it really loads, e.g. includes("@addon/custom-include/release")
+-- so a project can tell which version it really loads, e.g. includes("@addon/custom-include/release"),
+-- and the recipe tests that the addon sees the version which is being installed
 --
 -- @note the repository is created in the given directory, the caller needs to remove it
 --
@@ -173,7 +174,41 @@ function _release(name, versions, gitdir)
         git({"commit", "-q", "-m", version})
         body = body .. ("\n    add_versions(%q, %q)"):format(version, git({"rev-parse", "HEAD"}):trim())
     end
-    return body
+    return body .. ([[
+
+    on_test(function (package)
+        import("core.package.addon")
+        local addoninfo = addon.addons()[%q]
+        assert(addoninfo and addoninfo.version == package:version_str(), "the addon sees %%s while installing %%s!",
+            addoninfo and addoninfo.version, package:version_str())
+    end)]]):format(name)
+end
+
+-- run the given function with a repository which distributes the given releases of an addon fixture
+--
+-- @note none of them is installed when it starts, @see _release()
+function _with_releases(name, versions, func)
+    local gitdir = os.tmpfile() .. ".addon-release"
+    os.tryrm(gitdir)
+    try
+    {
+        function ()
+            _with_repo({[name] = _release(name, versions, gitdir)}, function ()
+                _remove(name)
+                func()
+            end)
+        end,
+        finally
+        {
+            -- @note try() swallows the errors if we do not re-raise them here
+            function (ok, errors)
+                os.tryrm(gitdir)
+                if not ok then
+                    raise(errors)
+                end
+            end
+        }
+    }
 end
 
 -- get the version of the given addon which is used outside of any project, i.e. the active one
@@ -542,46 +577,44 @@ end
 -- a project locks the installed version which it declares, the machine may have activated
 -- another one, e.g. a later install of the same addon for another project
 function test_autofetch_lock_declared_version(t)
-    local gitdir = os.tmpfile() .. ".addon-release"
-    os.tryrm(gitdir)
-    local recipes = {["custom-include"] = _release("custom-include", {"1.0.0", "2.0.0"}, gitdir)}
-    try
