From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kern0x1b <kern0x1b@users.noreply.github.com>
Date: Mon, 19 Oct 2026 18:11:23 +0200
Subject: [PATCH 6/7] Keep a project's addon pin strict, fall back only for an
 inherited one

addon.addons() took `versions[pinned] or versions[active]` for every pin, so
a version which the project had pinned from its lock and which was no longer
installed silently became the machine's active version. Upstream leaves the
addon out, and the project fails as "not installed". The fallback was meant
for the pins which a child process inherits through XMAKE_ADDONS_PINNED,
e.g. a child with another XMAKE_GLOBALDIR.

The inherited pins are now kept apart from this process's own
(addon._inherited()). An own pin is strict, as upstream. An inherited pin
whose version is not installed falls back to the active version with a
warning naming both. addon.pin(..., {inherit = true}) passes on the inherited
pins together with its own.

_installed_version() lost the reason when semver.select() raised, `try`
swallowed it; it returns it now, and the "not installed" assert of
_lock_addons() prints it, e.g. "unable to select version for range '>=3.0'".

Tests: test_autofetch_lock_removed_version, the project pins its locked
1.0.0, then 1.0.0 is removed, the addon must be "not installed" and not the
active 2.0.0; test_inherited_pin_missing_version, an inherited pin of 9.9.9
falls back to the active version and says so. Without this change, on the
previous commits, the first gets 2.0.0 and the second gets no warning.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/actions/addon/test.lua                  | 36 ++++++++++++
 xmake/core/package/addon.lua                  | 56 +++++++++++++------
 .../action/addon/impl/install_addons.lua      | 23 ++++++--
 3 files changed, 94 insertions(+), 21 deletions(-)

diff --git a/tests/actions/addon/test.lua b/tests/actions/addon/test.lua
index 08b28056b..3d0cf3042 100644
--- a/tests/actions/addon/test.lua
+++ b/tests/actions/addon/test.lua
@@ -678,6 +678,42 @@ target("hello")
     end)
 end
 
+-- a version which the project has pinned is strict, if it is not installed any more, this addon is not
+-- installed for the project, the active version must not stand in for it
+--
+-- @note a project only pins the installed versions, @see project._pin_addons(), so we remove the locked one
+-- after the project has pinned it, e.g. another process removes it while we are running
+function test_autofetch_lock_removed_version(t)
+    _with_releases("custom-include", {"1.0.0", "2.0.0"}, function ()
+        os.runv("xmake", {"addon", "--install", "-y", "custom-include 1.0.0"})
+        os.runv("xmake", {"addon", "--install", "-y", "custom-include 2.0.0"})
+        _with_project("autofetch-release", function (projectdir)
+            t:require(os.iorunv("xmake", {"config", "-y"}):find("custom-include: release 1.0.0 is loaded", 1, true))
+            local script = [[
+                import("core.package.addon")
+                assert(addon.addons()["custom-include"].version == "1.0.0", "the locked version is not pinned!")
+                addon.unregister("custom-include", "1.0.0")
+                local addoninfo = addon.addons()["custom-include"]
+                print(addoninfo and addoninfo.version or "not installed")]]
+            -- @note the option menu loads this project too, it prints the version which it includes first
+            local lines = os.iorunv("xmake", {"lua", "-c", script}):trim():split("\n")
+            t:are_equal(lines[#lines]:trim(), "not installed")
+        end)
+    end)
+end
+
+-- a version which the parent process has pinned may not be installed for this process, e.g. it uses
+-- another XMAKE_GLOBALDIR, so the active version stands in for it, and we are told so
+function test_inherited_pin_missing_version(t)
+    _with_addons({"custom-include"}, function ()
+        local script = "import(\"core.package.addon\"); print(addon.addons()[\"custom-include\"].version)"
+        local output = os.iorunv("xmake", {"lua", "-c", script}, {curdir = os.scriptdir(),
+            envs = {XMAKE_ADDONS_PINNED = string.serialize({["custom-include"] = "9.9.9"}, {strip = true, indent = false})}})
+        t:are_equal(output:split("\n")[1]:trim(), "latest")
+        t:require(output:find("the version 9.9.9 which the parent process has pinned is not installed, we use the active version latest", 1, true))
+    end)
+end
+
 -- the declared addons are checked, e.g. the reserved names
 function test_autofetch_invalid(t)
     _with_project("autofetch-badname", function ()
diff --git a/xmake/core/package/addon.lua b/xmake/core/package/addon.lua
index 1283d7117..f71bacfa1 100644
--- a/xmake/core/package/addon.lua
+++ b/xmake/core/package/addon.lua
@@ -474,27 +474,36 @@ function addon._registry(opt)
     return registry
 end
 
--- get the pinned versions of this process, e.g. {["esp32"] = "1.0.2"}
---
--- @note the parent process may have pinned some versions for its child processes too,
--- @see addon.pin
---
+-- get the versions which this process has pinned, e.g. {["esp32"] = "1.0.2"}
 function addon._pinned()
     local pinned = addon._PINNED
     if pinned == nil then
         pinned = {}
-        local inherited = os.getenv("XMAKE_ADDONS_PINNED")
-        if inherited then
+        addon._PINNED = pinned
+    end
+    return pinned
+end
+
+-- get the versions which the parent process has pinned for its child processes, e.g. {["esp32"] = "1.0.2"}
+--
+-- @see addon.pin
+--
+function addon._inherited()
+    local inherited = addon._INHERITED
+    if inherited == nil then
+        inherited = {}
+        local envpinned = os.getenv("XMAKE_ADDONS_PINNED")
+        if envpinned then
             local errors
-            pinned, errors = inherited:deserialize()
-            if not pinned then
-                utils.warning("XMAKE_ADDONS_PINNED(%s) is ignored, %s", inherited, errors or "it is invalid")
-                pinned = {}
+            inherited, errors = envpinned:deserialize()
+            if not inherited then
+                utils.warning("XMAKE_ADDONS_PINNED(%s) is ignored, %s", envpinned, errors or "it is invalid")
+                inherited = {}
             end
         end
-        addon._PINNED = pinned
+        addon._INHERITED = inherited
     end
-    return pinned
+    return inherited
 end
 
 -- pin the active version of the given addon for this process
@@ -511,7 +520,8 @@ function addon.pin(name, version, opt)
     pinned[addon.dirname(name)] = version
     addon._ADDONS = nil
     if opt and opt.inherit then
-        os.setenv("XMAKE_ADDONS_PINNED", string.serialize(pinned, {strip = true, indent = false}))
+        -- we pass on the versions which our parent has pinned too, ours override them
+        os.setenv("XMAKE_ADDONS_PINNED", string.serialize(table.join(addon._inherited(), pinned), {strip = true, indent = false}))
     end
 end
 
@@ -560,13 +570,25 @@ function addon.addons(opt)
     if addons == nil then
         addons = {}
         local pinned = addon._pinned()
+        local inherited = addon._inherited()
         for dirname, addoninfo in pairs(addon._registry()) do
             -- the project may lock another version of it, @see addon.pin
             --
-            -- @note the version which the parent process has pinned may not be installed here,
-            -- e.g. the child process uses another XMAKE_GLOBALDIR, so we use the active one
+            -- @note a version which this process has pinned is strict, if it is not installed any more,
+            -- this addon is not installed for the project which locks it, we must not use another one
             local versions = addoninfo.versions or {}
-            local versioninfo = versions[pinned[dirname]] or versions[addoninfo.active]
+            local version = pinned[dirname]
+            if version == nil then
+                -- @note the version which the parent process has pinned may not be installed here,
+                -- e.g. the child process uses another XMAKE_GLOBALDIR, so we use the active one
+                version = inherited[dirname]
+                if version and versions[version] == nil then
+                    utils.warning("addon(%s): the version %s which the parent process has pinned is not installed, we use the active version %s!",
+                        dirname, version, addoninfo.active)
+                    version = nil
+                end
+            end
+            local versioninfo = versions[version or addoninfo.active]
             if versioninfo then
                 addons[dirname] = versioninfo
             end
diff --git a/xmake/modules/private/action/addon/impl/install_addons.lua b/xmake/modules/private/action/addon/impl/install_addons.lua
index def2e3c27..87b4add58 100644
--- a/xmake/modules/private/action/addon/impl/install_addons.lua
+++ b/xmake/modules/private/action/addon/impl/install_addons.lua
@@ -62,6 +62,8 @@ function _installed_version(requirestr, installed)
 
     -- the local and git installs have no semantic version, e.g. `latest`, `master`,
     -- so we can only select them by their names like the branches
+    --
+    -- @note semver.select() raises if none of them is selected, we return why, @see _lock_addons()
     local versions = {}
     local branches = {}
     for _, version in ipairs(addon.versions(name)) do
@@ -70,7 +72,20 @@ function _installed_version(requirestr, installed)
             return version
         end
     end
-    return try { function () return semver.select(range, versions, {}, branches) end }
+    local errors
+    local version = try
+    {
+        function ()
+            return semver.select(range, versions, {}, branches)
+        end,
+        catch
+        {
+            function (e)
+                errors = e
+            end
+        }
+    }
+    return version, errors
 end
 
 -- lock the installed addons, so that we always get the same ones
@@ -90,9 +105,9 @@ function _lock_addons(projectdir, requires)
     local installed = addon.addons({force = true, unpinned = true})
     for _, requirestr in ipairs(requires) do
         local name = addons.requirename(requirestr)
-        local version = _installed_version(requirestr, installed)
-        local addoninfo = assert(version and addon.versioninfo(name, version), "addon(%s) is not installed! the installed versions: %s",
-            requirestr, table.concat(addon.versions(name), ", "))
+        local version, errors = _installed_version(requirestr, installed)
+        local addoninfo = assert(version and addon.versioninfo(name, version), "addon(%s) is not installed! the installed versions: %s%s",
+            requirestr, table.concat(addon.versions(name), ", "), errors and (", " .. tostring(errors)) or "")
         local oldversion = locked[name] and locked[name].version
         if oldversion and oldversion ~= addoninfo.version then
             cprint("${color.success}upgrade ${bright}%s${clear}: %s -> %s", name, oldversion, addoninfo.version)
