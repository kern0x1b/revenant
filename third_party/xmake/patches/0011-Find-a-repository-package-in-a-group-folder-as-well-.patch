From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kern0x1b <kern0x1b@users.noreply.github.com>
Date: Tue, 20 Oct 2026 03:40:23 +0200
Subject: [PATCH] Find a repository package in a group folder as well as under
 its letter

A repository keeps a package in packages/<first letter>/<name>, and xmake
looked for it there and nowhere else. A repository which files its packages
by what they are, e.g. packages/libraries/zlib, could not be used at all.

A package is now looked up in this order, for packages as for addons:

    packages/<name>/xmake.lua
    packages/<group>/<name>/xmake.lua
    packages/<first letter>/<name>/xmake.lua

A group is a folder of the root whose name is longer than one letter and
which is not a package itself, so a classic repository is read exactly as
before. A name which two groups of one repository both hold is an error
that names both folders, never a silent pick.

repository.find_packagedir() does the lookup and repository.list_packagedirs()
the listing. Every place that resolved or enumerated repository packages
uses them: packagedir() for require, info, fetch, install, download and
on_fetch, the locked repository of a lock file, the artifacts manifest,
and the quick search cache behind xmake require --search, xrepo search
and the completion of package names.
---
 .../action/require/impl/repository.lua        | 97 +++++++++++++++++--
 .../private/xrepo/quick_search/cache.lua      | 21 +---
 2 files changed, 95 insertions(+), 23 deletions(-)

diff --git a/xmake/modules/private/action/require/impl/repository.lua b/xmake/modules/private/action/require/impl/repository.lua
index d17bdb5..6642ddd 100644
--- a/xmake/modules/private/action/require/impl/repository.lua
+++ b/xmake/modules/private/action/require/impl/repository.lua
@@ -27,6 +27,89 @@ import("core.package.repository")
 import("devel.git")
 import("net.proxy")
 
+function _is_packagedir(dir)
+    return os.isfile(path.join(dir, "xmake.lua"))
+end
+
+function _groupdirs(rootdir)
+    local groupdirs = {}
+    for _, dir in ipairs(os.dirs(path.join(rootdir, "*"))) do
+        if #path.filename(dir) > 1 and not _is_packagedir(dir) then
+            table.insert(groupdirs, dir)
+        end
+    end
+    return groupdirs
+end
+
+function _letterdirs(rootdir)
+    local letterdirs = {}
+    for _, dir in ipairs(os.dirs(path.join(rootdir, "*"))) do
+        if #path.filename(dir) == 1 and not _is_packagedir(dir) then
+            table.insert(letterdirs, dir)
+        end
+    end
+    return letterdirs
+end
+
+function find_packagedir(rootdir, packagename, filename)
+    filename = filename or "xmake.lua"
+    local dir = path.join(rootdir, packagename)
+    if os.isfile(path.join(dir, filename)) then
+        return dir
+    end
+    local found
+    for _, groupdir in ipairs(_groupdirs(rootdir)) do
+        dir = path.join(groupdir, packagename)
+        if os.isfile(path.join(dir, filename)) then
+            if found then
+                raise("package(%s) is in two groups of %s: %s and %s", packagename, rootdir, found, dir)
+            end
+            found = dir
+        end
+    end
+    if found then
+        return found
+    end
+    dir = path.join(rootdir, packagename:sub(1, 1), packagename)
+    if os.isfile(path.join(dir, filename)) then
+        return dir
+    end
+end
+
+function list_packagedirs(rootdir)
+    local found = {}
+    local grouped = {}
+    for _, groupdir in ipairs(_groupdirs(rootdir)) do
+        for _, file in ipairs(os.files(path.join(groupdir, "*", "xmake.lua"))) do
+            local dir = path.directory(file)
+            local packagename = path.filename(dir)
+            if grouped[packagename] then
+                raise("package(%s) is in two groups of %s: %s and %s", packagename, rootdir, grouped[packagename], dir)
+            end
+            grouped[packagename] = dir
+        end
+    end
+    for _, file in ipairs(os.files(path.join(rootdir, "*", "xmake.lua"))) do
+        local dir = path.directory(file)
+        found[path.filename(dir)] = dir
+    end
+    for packagename, dir in pairs(grouped) do
+        found[packagename] = found[packagename] or dir
+    end
+    for _, letterdir in ipairs(_letterdirs(rootdir)) do
+        for _, file in ipairs(os.files(path.join(letterdir, "*", "xmake.lua"))) do
+            local dir = path.directory(file)
+            local packagename = path.filename(dir)
+            found[packagename] = found[packagename] or dir
+        end
+    end
+    local packagedirs = {}
+    for packagename, dir in table.orderpairs(found) do
+        table.insert(packagedirs, {name = packagename, dir = dir})
+    end
+    return packagedirs
+end
+
 -- get package directory from the locked repository
 function _get_packagedir_from_locked_repo(packagename, locked_repo)
 
@@ -101,8 +184,8 @@ function _get_packagedir_from_locked_repo(packagename, locked_repo)
     -- find package directory
     local foundir
     if ok then
-        local dir = path.join(repodir_local, "packages", packagename:sub(1, 1), packagename)
-        if os.isdir(dir) and os.isfile(path.join(dir, "xmake.lua")) then
+        local dir = find_packagedir(path.join(repodir_local, "packages"), packagename)
+        if dir then
             local repo = repository.load(reponame, locked_repo.url, locked_repo.branch, false)
             foundir = {dir, repo}
             vprint("lock package(%s) in %s from repository(%s)/%s", packagename, dir, locked_repo.url, locked_repo.commit)
@@ -189,8 +272,8 @@ function packagedir(packagename, opt)
         -- find the package directory from repositories
         if not foundir then
             for _, repo in ipairs(repositories()) do
-                local dir = path.join(repo:directory(), rootdir, packagename:sub(1, 1), packagename)
-                if os.isdir(dir) and os.isfile(path.join(dir, "xmake.lua")) and (not reponame or reponame == repo:name()) then
+                local dir = (not reponame or reponame == repo:name()) and find_packagedir(path.join(repo:directory(), rootdir), packagename)
+                if dir then
                     foundir = {dir, repo}
                     break
                 end
@@ -218,9 +301,9 @@ end
 function artifacts_manifest(packagename, version)
     packagename = packagename:lower()
     for _, repo in ipairs(repositories()) do
-        local manifestfile = path.join(repo:directory(), "packages", packagename:sub(1, 1), packagename, version, "manifest.txt")
-        if os.isfile(manifestfile) then
-            return io.load(manifestfile)
+        local dir = find_packagedir(path.join(repo:directory(), "packages"), packagename, path.join(version, "manifest.txt"))
+        if dir then
+            return io.load(path.join(dir, version, "manifest.txt"))
         end
     end
 end
diff --git a/xmake/modules/private/xrepo/quick_search/cache.lua b/xmake/modules/private/xrepo/quick_search/cache.lua
index feba8cd..8a556b4 100644
--- a/xmake/modules/private/xrepo/quick_search/cache.lua
+++ b/xmake/modules/private/xrepo/quick_search/cache.lua
@@ -34,27 +34,16 @@ function _cachekey(packagename, kind)
     return kind == "addon" and ("addon::" .. packagename) or packagename
 end
 
--- search package directories from repositories
---
--- the packages are stored in <repodir>/packages/<first-letter>/<name>,
--- and the addons are stored in <repodir>/addons/<first-letter>/<name>
---
 function _list_package_dirs()
-    -- find the package directories from all repositories
     local unique = {}
     local packageinfos = {}
     for _, repo in ipairs(repository.repositories()) do
         for _, rootinfo in ipairs({{rootdir = "packages"}, {rootdir = "addons", kind = "addon"}}) do
-            for _, file in ipairs(os.files(path.join(repo:directory(), rootinfo.rootdir, "*", "*", "xmake.lua"))) do
-                local dir = path.directory(file)
-                local subdirname = path.basename(path.directory(dir))
-                if #subdirname == 1 then -- ignore l/luajit/port/xmake.lua
-                    local packagename = path.filename(dir)
-                    local cachekey = _cachekey(packagename, rootinfo.kind)
-                    if not unique[cachekey] then
-                        table.insert(packageinfos, {name = packagename, kind = rootinfo.kind, repo = repo, packagedir = dir})
-                        unique[cachekey] = true
-                    end
+            for _, packageinfo in ipairs(repository.list_packagedirs(path.join(repo:directory(), rootinfo.rootdir))) do
+                local cachekey = _cachekey(packageinfo.name, rootinfo.kind)
+                if not unique[cachekey] then
+                    table.insert(packageinfos, {name = packageinfo.name, kind = rootinfo.kind, repo = repo, packagedir = packageinfo.dir})
+                    unique[cachekey] = true
                 end
             end
         end
