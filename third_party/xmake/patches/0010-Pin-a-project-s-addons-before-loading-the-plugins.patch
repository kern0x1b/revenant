From 38c3403e1ab29e1c2b1d557ffda9fefe1a4f55a4 Mon Sep 17 00:00:00 2001
From: kern0x1b <kern0x1b@users.noreply.github.com>
Date: Wed, 23 Sep 2026 23:10:40 +0200
Subject: [PATCH 10/11] Pin a project's addons before loading the plugins

The command menu (core/main.lua) loads the tasks first, task.tasks() reads the
plugin directories of the addons once and caches them in task._DIRECTORIES,
and only then project.tasks() loads the project, which pins the versions of
its lock. addon.pin() does not clear the task cache, so a command in a project
which locks another version of an addon than the active one, e.g.
`xmake emulate` with charon locked at v0.8.10, ran the plugin of the active
version, and the modules which it imports came with it.

The menu now pins the project's locked versions, project._pin_addons(),
before it loads the tasks, so the plugin directories are those of the pinned
versions. project._load() pins them again later, it is the same pin.

Test: test_autofetch_lock_plugin_version, the released versions of the fixture
now also carry a plugin which prints its version; 1.0.0 and 2.0.0 installed,
2.0.0 active, the project locks 1.0.0: in the project the plugin of 1.0.0
runs, outside of it that of 2.0.0. tests/actions/addon 24/24 with it; with the
scripts of 39d7488ea the plugin in the project is not that of 1.0.0.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 AGENTS.md                    |  1 +
 tests/actions/addon/test.lua | 31 ++++++++++++++++++++++++++++++-
 xmake/core/main.lua          |  7 +++++++
 3 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/AGENTS.md b/AGENTS.md
index cb8861ed1..b7c77ee15 100644
--- a/AGENTS.md
+++ b/AGENTS.md
@@ -24,6 +24,7 @@ documents: `README.md`, `CONTRIBUTING.md`, <https://xmake.io>.
     version of each addon, the per-process pins;
   - `xmake/core/project/addons.lua` and `xmake/core/project/project.lua` — a project's
     `xmake-addons.lock`, its auto-fetch and pinning;
+  - `xmake/core/main.lua` — the command menu, it pins the lock before it reads the addon plugins;
   - `xmake/modules/private/action/addon/impl/install_addons.lua` — the auto-fetch installer, it
     writes the lock;
   - `xmake/modules/private/action/require/impl/actions/install.lua` (`_register_addon`) — the
diff --git a/tests/actions/addon/test.lua b/tests/actions/addon/test.lua
index 5f0de5f57..ce0a7275c 100644
--- a/tests/actions/addon/test.lua
+++ b/tests/actions/addon/test.lua
@@ -108,13 +108,19 @@ end
 
 -- release the given addon fixture with the given versions, and get the recipe which distributes them
 --
--- every version is a commit of a git repository which only differs by `includes/release`,
+-- every version is a commit of a git repository which only differs by `includes/release` and `plugins/release`,
 -- so a project can tell which version it really loads, e.g. includes("@addon/custom-include/release"),
+-- and which plugin it runs, @see _release_task(),
 -- and the recipe tests that the addon sees the version which is being installed, in the installer
 -- and in a child process, e.g. the `on_test` scripts which run `xmake create -t ...`
 --
 -- @note the repository is created in the given directory, the caller needs to remove it
 --
+-- get the plugin task which tells us the version of the given released addon, e.g. `custom_include_release`
+function _release_task(name)
+    return (name:gsub("[^%w]", "_")) .. "_release"
+end
+
 function _release(name, versions, gitdir)
     os.cp(_addondir(name), gitdir)
     local function git(argv)
@@ -125,6 +131,10 @@ function _release(name, versions, gitdir)
     for _, version in ipairs(versions) do
         io.writefile(path.join(gitdir, "includes", "release", "xmake.lua"),
             ("print(\"%s: release %s is loaded\")\n"):format(name, version))
+        io.writefile(path.join(gitdir, "plugins", "release", "xmake.lua"),
+            ("task(%q)\n    set_category(\"plugin\")\n    set_menu {usage = \"xmake %s\", description = \"Tell the release.\"}\n"
+             .. "    on_run(function () print(\"%s: the plugin of release %s runs\") end)\n"):format(
+                _release_task(name), _release_task(name), name, version))
         git({"add", "-A"})
         git({"commit", "-q", "-m", version})
         body = body .. ("\n    add_versions(%q, %q)"):format(version, git({"rev-parse", "HEAD"}):trim())
@@ -517,6 +527,25 @@ function test_autofetch_lock_bare_declaration(t)
     end)
 end
 
+-- xmake finds the plugins of the addons before it loads the project, so a project which locks another version
+-- of an addon than the active one must still run the plugin of the locked version
+function test_autofetch_lock_plugin_version(t)
+    _with_releases("custom-include", {"1.0.0", "2.0.0"}, function ()
+        os.runv("xmake", {"addon", "--install", "-y", "custom-include 1.0.0"})
+        os.runv("xmake", {"addon", "--install", "-y", "custom-include 2.0.0"})
+        t:are_equal(_active_version("custom-include"), "2.0.0")
+        _with_project("autofetch-version", function (projectdir)
+            t:require(os.iorunv("xmake", {"config", "-y"}):find("custom-include: release 1.0.0 is loaded", 1, true))
+            t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
+            local taskname = _release_task("custom-include")
+            t:require(os.iorunv("xmake", {taskname}):find("custom-include: the plugin of release 1.0.0 runs", 1, true))
+
+            -- and the commands outside of the project still run the plugin of the active version
+            t:require(os.iorunv("xmake", {taskname}, {curdir = os.scriptdir()}):find("custom-include: the plugin of release 2.0.0 runs", 1, true))
+        end)
+    end)
+end
+
 -- a locked version which is not installed must not hide the addon
 --
 -- @note the auto-fetch installs the locked version, but the commands which do not load
diff --git a/xmake/core/main.lua b/xmake/core/main.lua
index 0c38840de..c94727c0c 100644
--- a/xmake/core/main.lua
+++ b/xmake/core/main.lua
@@ -51,6 +51,13 @@ local menu =
 
     -- the tasks: xmake [task]
 ,   function ()
+
+        -- the addons provide the plugins too, and this project may lock the other versions of them
+        -- than the active ones, so we need to pin them before we load the tasks, it loads the project later,
+        -- @see project._pin_addons(), task._directories()
+        if xmake.in_main_thread() and os.isfile(project.rootfile()) then
+            project._pin_addons()
+        end
         local tasks = task.tasks() or {}
         if xmake.in_main_thread() then
             local ok, project_tasks = pcall(project.tasks)
