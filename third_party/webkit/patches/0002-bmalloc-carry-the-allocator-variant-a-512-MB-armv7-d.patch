+
+class Allocator {
+public:
+    Allocator(Heap*, Deallocator&);
+    ~Allocator();
+
+    void* tryAllocate(size_t);
+    void* allocate(size_t);
+    void* tryAllocate(size_t alignment, size_t);
+    void* allocate(size_t alignment, size_t);
