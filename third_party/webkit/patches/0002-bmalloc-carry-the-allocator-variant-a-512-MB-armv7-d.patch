+
+namespace bmalloc_ios6 {
+
+void StaticMutex::lockSlowCase()
+{
+    static const size_t aLot = 256;
+    
+    if (!m_isSpinning.test_and_set()) {
+        auto clear = makeScopeExit([&] { m_isSpinning.clear(); });
+
+        for (size_t i = 0; i < aLot; ++i) {
+            if (try_lock())
+                return;
+        }
+    }
+
+    while (!try_lock())
+        std::this_thread::yield();
+}
+
+}
