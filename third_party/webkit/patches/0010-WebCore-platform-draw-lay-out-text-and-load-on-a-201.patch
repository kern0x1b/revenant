+double& LegacyTileCache::lastPreparedToDraw()
+{
+    static double when;
+    return when;
+}
+
+bool LegacyTileCache::mainThreadShouldWaitForEngine()
+{
+    if (g_webkitIOS6PendingDrawWork)
+        return true;
