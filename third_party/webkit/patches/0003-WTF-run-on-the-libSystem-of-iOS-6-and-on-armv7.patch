     using ArgumentTypes = std::tuple<Args...>;
 
+
+#if USE(JSVALUE64)
     static constexpr unsigned cCallArity() { return arity; }
+#else
+
+    static constexpr unsigned cCallArity() { return computeCCallSlots<Args...>(); }
+#endif
+
 };
 
