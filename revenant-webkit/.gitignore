# Build trees. Every one of these is reproducible from conan build and the
# packages it installs, and together they are several gigabytes.
/build/
build-jsc32/
**/test_package/build*/
**/test_package/CMakeUserPresets.json

*.log
*.o
*.a
*.dylib
*.tar
*.tar.gz

.DS_Store
__pycache__/
# The device's address and password. device.env.example is the tracked template;
# every other variant, including hand-kept backups, is personal.
device.env*
device.*.env
!device.env.example

# Local device screenshots captured during work — may show device content
.claude/screenshots/
sweep-shots/
**/shots/
*-shots/

# A sweep list is the operator's, never the repository's.
tests/device/sweep-sites.txt
