{
  "manifest_version": 3,
  "name": "The web-extension probe's manifest",
  "short_name": "probe",
  "version": "1.2.3",
  "description": "What the host answers for an extension is asked of THIS manifest, so the answers are a property of this file and of nothing else. Every key here is one the 26.2 SDK's WKWebExtension reads, and each is here to be measured: a manifest with one permission and one host permission answers a different set of records than one with three of each.",
  "default_locale": "en",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://example.com/*",
    "*://*.example.org/*"
  ],
  "action": {
    "default_title": "The probe's action",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://example.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'"
  },
  "commands": {
    "the-probe-command": {
      "suggested_key": {
        "default": "Ctrl+Shift+P"
      },
      "description": "The command the probe measures"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page.html"
      ],
      "matches": [
        "https://example.com/*"
      ]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
