//===--- SpatialGeometry.swift.gyb -----------*- swift -*-===//
//
// The boxes, the points and the rays of Spatial, once for each of the framework's two scalars.
// Each type here is a union of a named struct and a `simd` vector in the SDK's C headers
// (usr/include/Spatial/Structures.h), so every `vector` member is that storage read one way or
// another and a `simd_packed_*` initialiser fills it side by side.
//
// The algorithms are the headers' own, named at each one; where the SDK's Swift interface body and
// the running system disagree, the system wins (COORDINATION section 5), so the sign of
// `Point3D - Vector3D` was read off the host rather than copied.
//
//===----------------------------------------------------------------------===//

import Foundation
import simd

% for scalar, vector, packed, matrix, matrix3, quat, suffix in [("Double", "simd_double3", "simd_packed_double4", "simd_double4x4", "simd_double3x3", "simd_quatd", ""), ("Float", "simd_float3", "simd_packed_float4", "simd_float4x4", "simd_float3x3", "simd_quatf", "Float")]:

// MARK: - Size3D${suffix}

/// An extent in three dimensions, held as the three edges of a box from its origin.
@frozen
public struct Size3D${suffix}: ${"Primitive3D, Volumetric, Primitive3DProtocol, AdditiveArithmetic, Hashable, Codable, CustomStringConvertible, CustomReflectable, Sendable" if suffix == "" else "Primitive3DProtocolFloat, AdditiveArithmetic, Hashable, Codable, CustomStringConvertible, CustomReflectable, Sendable"} {
    public typealias Scalar = ${scalar}
    public typealias AffineTransform = AffineTransform3D${suffix}
    public typealias ProjectiveTransform = ProjectiveTransform3D${suffix}
    public typealias Pose = Pose3D${suffix}
    public typealias Rect = Rect3D${suffix}
    public typealias Vector = Vector3D${suffix}
    public typealias Point = Point3D${suffix}
    public typealias Size = Size3D${suffix}
    public typealias Rotation = Rotation3D${suffix}
    public typealias Quaternion = ${quat}
    public typealias AxisEnumeration = AxisWithFactors${suffix}

    public var width: ${scalar}
    public var height: ${scalar}
    public var depth: ${scalar}

    public init() { self.init(width: 0, height: 0, depth: 0) }

    public init(width: ${scalar} = 0, height: ${scalar} = 0, depth: ${scalar} = 0) {
        self.width = width
        self.height = height
        self.depth = depth
    }

    public init(_ xyz: ${vector}) { self.init(width: xyz.x, height: xyz.y, depth: xyz.z) }
    public init(_ source: ${packed}) { self.init(width: source.x, height: source.y, depth: source.z) }
    public init(_ point: Point3D${suffix}) { self.init(width: point.x, height: point.y, depth: point.z) }
    public init(_ xyz: Vector3D${suffix}) { self.init(width: xyz.x, height: xyz.y, depth: xyz.z) }

    public static let zero = Size3D${suffix}()
    public static let one = Size3D${suffix}(width: 1, height: 1, depth: 1)
    public static let infinity = Size3D${suffix}(width: .infinity, height: .infinity, depth: .infinity)

    public var vector: ${vector} {
        get { ${vector}(width, height, depth) }
        set { width = newValue.x; height = newValue.y; depth = newValue.z }
    }

    @available(*, deprecated, renamed: "vector")
    public var simd: ${vector} {
        get { vector }
        set { vector = newValue }
    }

    /// The size itself: a box's extent is its own size.
    public var size: Size3D${suffix} { self }

    public var isZero: Bool { width == 0 && height == 0 && depth == 0 }
    public var isFinite: Bool { width.isFinite && height.isFinite && depth.isFinite }
    public var isNaN: Bool { width.isNaN || height.isNaN || depth.isNaN }

    public static func + (lhs: Size3D${suffix}, rhs: Size3D${suffix}) -> Size3D${suffix} {
        Size3D${suffix}(lhs.vector + rhs.vector)
    }

    public static func - (lhs: Size3D${suffix}, rhs: Size3D${suffix}) -> Size3D${suffix} {
        Size3D${suffix}(lhs.vector - rhs.vector)
    }

    public static prefix func - (size: Size3D${suffix}) -> Size3D${suffix} {
        Size3D${suffix}(-size.vector)
    }

    public static func * (lhs: ${scalar}, rhs: Size3D${suffix}) -> Size3D${suffix} { Size3D${suffix}(lhs * rhs.vector) }
    public static func * (lhs: Size3D${suffix}, rhs: ${scalar}) -> Size3D${suffix} { Size3D${suffix}(lhs.vector * rhs) }
    public static func / (lhs: Size3D${suffix}, rhs: ${scalar}) -> Size3D${suffix} { Size3D${suffix}(lhs.vector / rhs) }
    public static func += (lhs: inout Size3D${suffix}, rhs: Size3D${suffix}) { lhs = lhs + rhs }
    public static func -= (lhs: inout Size3D${suffix}, rhs: Size3D${suffix}) { lhs = lhs - rhs }
    public static func *= (lhs: inout Size3D${suffix}, rhs: ${scalar}) { lhs = lhs * rhs }
    public static func /= (lhs: inout Size3D${suffix}, rhs: ${scalar}) { lhs = lhs / rhs }

    public static func * (lhs: AffineTransform3D${suffix}, rhs: Size3D${suffix}) -> Size3D${suffix} { rhs.applying(lhs) }
    public static func * (lhs: ProjectiveTransform3D${suffix}, rhs: Size3D${suffix}) -> Size3D${suffix} { rhs.applying(lhs) }
    public static func * (lhs: Pose3D${suffix}, rhs: Size3D${suffix}) -> Size3D${suffix} { rhs.applying(lhs) }

    public static func == (lhs: Size3D${suffix}, rhs: Size3D${suffix}) -> Bool {
        lhs.width == rhs.width && lhs.height == rhs.height && lhs.depth == rhs.depth
    }

    public func scaledBy(x: ${scalar} = 1, y: ${scalar} = 1, z: ${scalar} = 1) -> Size3D${suffix} {
        Size3D${suffix}(width: width * x, height: height * y, depth: depth * z)
    }

    public mutating func scaleBy(x: ${scalar} = 1, y: ${scalar} = 1, z: ${scalar} = 1) {
        self = scaledBy(x: x, y: y, z: z)
    }

    public func scaled(by scale: Size3D${suffix}) -> Size3D${suffix} {
        scaledBy(x: scale.width, y: scale.height, z: scale.depth)
    }

    public mutating func scale(by scale: Size3D${suffix}) { self = scaled(by: scale) }
    public func uniformlyScaled(by scale: ${scalar}) -> Size3D${suffix} { scaledBy(x: scale, y: scale, z: scale) }
    public mutating func uniformlyScale(by scale: ${scalar}) { self = uniformlyScaled(by: scale) }

    public func sheared(_ shear: AxisWithFactors${suffix}) -> Size3D${suffix} {
        Size3D${suffix}(Vector3D${suffix}(x: width, y: height, z: depth).sheared(shear).vector)
    }

    public mutating func shear(_ shear: AxisWithFactors${suffix}) { self = sheared(shear) }

    public func rotated(by rotation: Rotation3D${suffix}) -> Size3D${suffix} {
        applying(rotation.affineTransform)
    }

    public func rotated(by quaternion: ${quat}) -> Size3D${suffix} {
        applying(Rotation3D${suffix}(quaternion).affineTransform)
    }

    public func rotated(by rotation: Rotation3D${suffix}, around pivot: Point3D${suffix}) -> Size3D${suffix} {
        Rect3D${suffix}(origin: .zero, size: self).rotated(by: rotation, around: pivot).size
    }

    public func rotated(by quaternion: ${quat}, around pivot: Point3D${suffix}) -> Size3D${suffix} {
        rotated(by: Rotation3D${suffix}(quaternion), around: pivot)
    }

    public mutating func rotate(by rotation: Rotation3D${suffix}) { self = rotated(by: rotation) }
    public mutating func rotate(by quaternion: ${quat}) { self = rotated(by: quaternion) }

    /// A size has no position, so translating it moves nothing.
    public func translated(by vector: Vector3D${suffix}) -> Size3D${suffix} { self }

    /// A size's direction is its diagonal, so the rotation that takes one size onto another is the
    /// one that turns that diagonal onto the other's.
    public func rotation(to other: Size3D${suffix}) -> Rotation3D${suffix} {
        Vector3D${suffix}(x: width, y: height, z: depth)
            .rotation(to: Vector3D${suffix}(x: other.width, y: other.height, z: other.depth))
    }

    @available(*, deprecated, message: "Use the `Vector3D` variant.")
    public func translated(by size: Size3D${suffix}) -> Size3D${suffix} { self + size }

    public mutating func translate(by vector: Vector3D${suffix}) { }
    public mutating func translate(by size: Size3D${suffix}) { self += size }

    public func applying(_ transform: AffineTransform3D${suffix}) -> Size3D${suffix} { applying(matrix: transform.matrix4x4) }
    public func applying(_ transform: ProjectiveTransform3D${suffix}) -> Size3D${suffix} { applying(matrix: transform.matrix4x4) }
    public func applying(_ pose: Pose3D${suffix}) -> Size3D${suffix} { applying(matrix: pose.matrix) }
    public func applying(_ scaledPose: ScaledPose3D${suffix}) -> Size3D${suffix} { applying(matrix: scaledPose.matrix) }

    public func unapplying(_ transform: AffineTransform3D${suffix}) -> Size3D${suffix} { unapplying(matrix: transform.matrix4x4) }
    public func unapplying(_ transform: ProjectiveTransform3D${suffix}) -> Size3D${suffix} { unapplying(matrix: transform.matrix4x4) }
    public func unapplying(_ pose: Pose3D${suffix}) -> Size3D${suffix} { unapplying(matrix: pose.matrix) }
    public func unapplying(_ scaledPose: ScaledPose3D${suffix}) -> Size3D${suffix} { unapplying(matrix: scaledPose.matrix) }

    public mutating func apply(_ transform: AffineTransform3D${suffix}) { self = applying(transform) }
    public mutating func apply(_ transform: ProjectiveTransform3D${suffix}) { self = applying(transform) }
    public mutating func apply(_ pose: Pose3D${suffix}) { self = applying(pose) }
    public mutating func unapply(_ transform: AffineTransform3D${suffix}) { self = unapplying(transform) }
    public mutating func unapply(_ transform: ProjectiveTransform3D${suffix}) { self = unapplying(transform) }
    public mutating func unapply(_ pose: Pose3D${suffix}) { self = unapplying(pose) }

    /// `SPSize3DApplyAffineTransform`: an extent is a column vector of `w = 0`, so the translation
    /// of the matrix does not reach it.
    func applying(matrix: ${matrix}) -> Size3D${suffix} {
        Size3D${suffix}(first3(simd_mul(matrix, SIMD4<${scalar}>(vector, 0))))
    }

    func unapplying(matrix: ${matrix}) -> Size3D${suffix} {
        guard let inverse = invertedMatrix(matrix) else { return self }
        return applying(matrix: inverse)
    }

    public func contains(_ other: Self) -> Bool {
        other.width >= 0 && other.height >= 0 && other.depth >= 0 &&
            other.width <= width && other.height <= height && other.depth <= depth
    }

    public func contains(point: Point3D${suffix}) -> Bool {
        let p = point.vector
        return p.x >= 0 && p.x <= width && p.y >= 0 && p.y <= height && p.z >= 0 && p.z <= depth
    }

    /// Any of the points, not all of them: the host answers true for a box of 2x3x4 and the two
    /// points (9, 9, 9) and (1, 1, 1), where the first is outside and the second inside.
    public func contains(anyOf points: [Point3D${suffix}]) -> Bool {
        points.contains { contains(point: $0) }
    }

    public func union(_ other: Self) -> Self {
        Size3D${suffix}(width: max(width, other.width),
                        height: max(height, other.height),
                        depth: max(depth, other.depth))
    }

    public mutating func formUnion(_ other: Self) { self = union(other) }

    /// The overlap, or `nil` when the two do not overlap at all: the SDK answers `nil` for a zero
    /// result, which is what an empty intersection gives.
    public func intersection(_ other: Self) -> Self? {
        let overlap = Size3D${suffix}(width: min(width, other.width),
                                      height: min(height, other.height),
                                      depth: min(depth, other.depth))
        return overlap != .zero ? overlap : nil
    }

    public mutating func formIntersection(_ other: Self) { self = intersection(other) ?? .zero }

    public func hash(into hasher: inout Hasher) {
        hasher.combine(width)
        hasher.combine(height)
        hasher.combine(depth)
    }

    private enum CodingKeys: String, CodingKey { case width, height, depth }

    public func encode(to encoder: any Encoder) throws {
        var container = encoder.container(keyedBy: CodingKeys.self)
        try container.encode(width, forKey: .width)
        try container.encode(height, forKey: .height)
        try container.encode(depth, forKey: .depth)
    }

    public init(from decoder: any Decoder) throws {
        let container = try decoder.container(keyedBy: CodingKeys.self)
        self.init(width: try container.decode(${scalar}.self, forKey: .width),
                  height: try container.decode(${scalar}.self, forKey: .height),
                  depth: try container.decode(${scalar}.self, forKey: .depth))
    }

    public var description: String { "(width: \(width), height: \(height), depth: \(depth))" }
    public var customMirror: Mirror { Mirror(self, children: ["width": width, "height": height, "depth": depth]) }
}

// MARK: - Point3D${suffix}

/// A position in three dimensions.
@frozen
public struct Point3D${suffix}: ${"Primitive3D, Translatable3D, Primitive3DProtocol, ClampableWithinRectProtocol, Hashable, Codable, CustomStringConvertible, CustomReflectable, Sendable" if suffix == "" else "Primitive3DProtocolFloat, Translatable3DProtocolFloat, ClampableWithinRectProtocolFloat, Hashable, Codable, CustomStringConvertible, CustomReflectable, Sendable"} {
    public typealias Scalar = ${scalar}
    public typealias AffineTransform = AffineTransform3D${suffix}
    public typealias ProjectiveTransform = ProjectiveTransform3D${suffix}
    public typealias Pose = Pose3D${suffix}
    public typealias Rect = Rect3D${suffix}
    public typealias Vector = Vector3D${suffix}
    public typealias Point = Point3D${suffix}
    public typealias Size = Size3D${suffix}
    public typealias Rotation = Rotation3D${suffix}
    public typealias Quaternion = ${quat}
    public typealias AxisEnumeration = AxisWithFactors${suffix}

    public var x: ${scalar}
    public var y: ${scalar}
    public var z: ${scalar}

    public init() { self.init(x: 0, y: 0, z: 0) }
    public init(x: ${scalar}, y: ${scalar}, z: ${scalar}) {
        self.x = x
        self.y = y
        self.z = z
    }

    public init(_ xyz: ${vector}) { self.init(x: xyz.x, y: xyz.y, z: xyz.z) }
    public init(_ source: ${packed}) { self.init(x: source.x, y: source.y, z: source.z) }
    public init(_ vector: Vector3D${suffix}) { self.init(vector.vector) }
    public init(_ coords: SphericalCoordinates3D${suffix}) {
        self.init(SphericalCoordinates3D${suffix}.cartesian(in: coords))
    }
    public init(_ size: Size3D${suffix}) { self.init(size.vector) }

    public static let zero = Point3D${suffix}()
    public static let infinity = Point3D${suffix}(x: .infinity, y: .infinity, z: .infinity)

    public var vector: ${vector} {
        get { ${vector}(x, y, z) }
        set { x = newValue.x; y = newValue.y; z = newValue.z }
    }

    @available(*, deprecated, renamed: "vector")
    public var simd: ${vector} {
        get { vector }
        set { vector = newValue }
    }

    @available(*, deprecated, message: "This property is deprecated")
    public var origin: Point3D${suffix} { self }

    public var isZero: Bool { x == 0 && y == 0 && z == 0 }
    public var isFinite: Bool { x.isFinite && y.isFinite && z.isFinite }
    public var isNaN: Bool { x.isNaN || y.isNaN || z.isNaN }

    public func distance(to other: Point3D${suffix}) -> ${scalar} {
        simd_distance(self.vector, other.vector)
    }

    /// The rotation about the origin that takes this point onto the other one, which is the
    /// rotation of one vector onto the other. The archived version took the difference of the two
    /// points and asked for the rotation onto zero, which is no rotation at all: the difference of
    /// the two points and zero are the same direction, so the answer was the zero rotation at
    /// best and a division by a zero length at worst - (nan) for the host's 0.53837148800168244.
    public func rotation(to other: Point3D${suffix}) -> Rotation3D${suffix} {
        Vector3D${suffix}(vector).rotation(to: Vector3D${suffix}(other.vector))
    }

    public static func - (lhs: Point3D${suffix}, rhs: Point3D${suffix}) -> Vector3D${suffix} {
        Vector3D${suffix}(x: lhs.x - rhs.x, y: lhs.y - rhs.y, z: lhs.z - rhs.z)
    }

    /// The negation of a point, which `SPPose3DGetInverse` needs and the host's framework has.
    public static prefix func - (point: Point3D${suffix}) -> Point3D${suffix} {
        Point3D${suffix}(x: -point.x, y: -point.y, z: -point.z)
    }

    public static func + (lhs: Point3D${suffix}, rhs: Vector3D${suffix}) -> Point3D${suffix} {
        Point3D${suffix}(x: lhs.x + rhs.x, y: lhs.y + rhs.y, z: lhs.z + rhs.z)
    }

    public static func += (lhs: inout Point3D${suffix}, rhs: Vector3D${suffix}) { lhs = lhs + rhs }
    public static func -= (lhs: inout Point3D${suffix}, rhs: Vector3D${suffix}) { lhs = lhs - rhs }

    public func uniformlyScaled(by scale: ${scalar}) -> Point3D${suffix} {
        Point3D${suffix}(x: x * scale, y: y * scale, z: z * scale)
    }

    public mutating func uniformlyScale(by scale: ${scalar}) { self = uniformlyScaled(by: scale) }

    public func translated(by vector: Vector3D${suffix}) -> Point3D${suffix} {
        Point3D${suffix}(x: x + vector.x, y: y + vector.y, z: z + vector.z)
    }

    @available(*, deprecated, message: "Use `Vector3D` variant.")
    public func translated(by size: Size3D${suffix}) -> Point3D${suffix} { self + Vector3D${suffix}(size) }

    public mutating func translate(by vector: Vector3D${suffix}) { self = translated(by: vector) }
    public mutating func translate(by size: Size3D${suffix}) { self = translated(by: Vector3D${suffix}(size)) }

    public func rotated(by rotation: Rotation3D${suffix}) -> Point3D${suffix} {
        applying(rotation.affineTransform)
    }

    public func rotated(by quaternion: ${quat}) -> Point3D${suffix} {
        applying(Rotation3D${suffix}(quaternion).affineTransform)
    }

    public func rotated(by rotation: Rotation3D${suffix}, around pivot: Point3D${suffix}) -> Point3D${suffix} {
        Point3D${suffix}(x: pivot.x + (self - pivot).rotated(by: rotation).x,
                       y: pivot.y + (self - pivot).rotated(by: rotation).y,
                       z: pivot.z + (self - pivot).rotated(by: rotation).z)
    }

    public func rotated(by quaternion: ${quat}, around pivot: Point3D${suffix}) -> Point3D${suffix} {
        rotated(by: Rotation3D${suffix}(quaternion), around: pivot)
    }

    public mutating func rotate(by rotation: Rotation3D${suffix}) { self = rotated(by: rotation) }
    public mutating func rotate(by quaternion: ${quat}) { self = rotated(by: quaternion) }

    public func applying(_ transform: AffineTransform3D${suffix}) -> Point3D${suffix} { applying(matrix: transform.matrix4x4) }
    public func applying(_ transform: ProjectiveTransform3D${suffix}) -> Point3D${suffix} { applying(matrix: transform.matrix4x4) }
    public func applying(_ pose: Pose3D${suffix}) -> Point3D${suffix} { applying(matrix: pose.matrix) }
    public func applying(_ scaledPose: ScaledPose3D${suffix}) -> Point3D${suffix} { applying(matrix: scaledPose.matrix) }

    public func unapplying(_ transform: AffineTransform3D${suffix}) -> Point3D${suffix} { unapplying(matrix: transform.matrix4x4) }
    public func unapplying(_ transform: ProjectiveTransform3D${suffix}) -> Point3D${suffix} { unapplying(matrix: transform.matrix4x4) }
    public func unapplying(_ pose: Pose3D${suffix}) -> Point3D${suffix} { unapplying(matrix: pose.matrix) }
    public func unapplying(_ scaledPose: ScaledPose3D${suffix}) -> Point3D${suffix} { unapplying(matrix: scaledPose.matrix) }

    public mutating func apply(_ transform: AffineTransform3D${suffix}) { self = applying(transform) }
    public mutating func apply(_ transform: ProjectiveTransform3D${suffix}) { self = applying(transform) }
    public mutating func apply(_ pose: Pose3D${suffix}) { self = applying(pose) }
    public mutating func unapply(_ transform: AffineTransform3D${suffix}) { self = unapplying(transform) }
    public mutating func unapply(_ transform: ProjectiveTransform3D${suffix}) { self = unapplying(transform) }
    public mutating func unapply(_ pose: Pose3D${suffix}) { self = unapplying(pose) }

    /// `SPPoint3DApplyAffineTransform`: a point is a column vector of `w = 1`, which is how the
    /// translation of the matrix reaches it.
    func applying(matrix: ${matrix}) -> Point3D${suffix} {
        Point3D${suffix}(first3(simd_mul(matrix, SIMD4<${scalar}>(vector, 1))))
    }

    func unapplying(matrix: ${matrix}) -> Point3D${suffix} {
        guard let inverse = invertedMatrix(matrix) else { return self }
        return applying(matrix: inverse)
    }

    public func clamped(to rect: Rect3D${suffix}) -> Point3D${suffix} {
        Point3D${suffix}(x: min(max(x, rect.minX), rect.maxX),
                        y: min(max(y, rect.minY), rect.maxY),
                        z: min(max(z, rect.minZ), rect.maxZ))
    }

    public mutating func clamp(to rect: Rect3D${suffix}) { self = clamped(to: rect) }

    public static func == (lhs: Point3D${suffix}, rhs: Point3D${suffix}) -> Bool {
        lhs.x == rhs.x && lhs.y == rhs.y && lhs.z == rhs.z
    }

    public func hash(into hasher: inout Hasher) {
        hasher.combine(x)
        hasher.combine(y)
        hasher.combine(z)
    }

    private enum CodingKeys: String, CodingKey { case x, y, z }

    public func encode(to encoder: any Encoder) throws {
        var container = encoder.container(keyedBy: CodingKeys.self)
        try container.encode(x, forKey: .x)
        try container.encode(y, forKey: .y)
        try container.encode(z, forKey: .z)
    }

    public init(from decoder: any Decoder) throws {
        let container = try decoder.container(keyedBy: CodingKeys.self)
        self.init(x: try container.decode(${scalar}.self, forKey: .x),
                  y: try container.decode(${scalar}.self, forKey: .y),
                  z: try container.decode(${scalar}.self, forKey: .z))
    }

    public var description: String { "(x: \(x), y: \(y), z: \(z))" }
    public var customMirror: Mirror { Mirror(self, children: ["x": x, "y": y, "z": z]) }
}

// MARK: - Rect3D${suffix}

/// A box in three dimensions, held as a corner and the three edges that run from it. An edge may be
/// negative, which is what `standardized` is for.
@frozen
public struct Rect3D${suffix}: ${"Primitive3D, Translatable3D, Volumetric, Primitive3DProtocol, Hashable, Codable, CustomStringConvertible, CustomReflectable, Sendable" if suffix == "" else "Primitive3DProtocolFloat, Translatable3DProtocolFloat, VolumetricProtocolFloat, Hashable, Codable, CustomStringConvertible, CustomReflectable, Sendable"} {
    public typealias Scalar = ${scalar}
    public typealias AffineTransform = AffineTransform3D${suffix}
    public typealias ProjectiveTransform = ProjectiveTransform3D${suffix}
    public typealias Pose = Pose3D${suffix}
    public typealias Rect = Rect3D${suffix}
    public typealias Vector = Vector3D${suffix}
    public typealias Point = Point3D${suffix}
    public typealias Size = Size3D${suffix}
    public typealias Rotation = Rotation3D${suffix}
    public typealias Quaternion = ${quat}
    public typealias AxisEnumeration = AxisWithFactors${suffix}

    public var origin: Point3D${suffix}
    public var size: Size3D${suffix}

    public init() { self.init(origin: Point3D${suffix}.zero, size: Size3D${suffix}.zero) }

    public init(origin: Point3D${suffix}, size: Size3D${suffix}) {
        self.origin = origin
        self.size = size
    }

    public init(origin: Vector3D${suffix} = .zero, size: Vector3D${suffix}) {
        self.init(origin: Point3D${suffix}(origin), size: Size3D${suffix}(size))
    }

    public init(origin: ${vector} = .zero, size: ${vector}) {
        self.init(origin: Point3D${suffix}(origin), size: Size3D${suffix}(size))
    }

    public init(center: Point3D${suffix}, size: Size3D${suffix}) {
        self.init(origin: Point3D${suffix}(x: center.x - size.width / 2,
                                            y: center.y - size.height / 2,
                                            z: center.z - size.depth / 2), size: size)
    }

    public init(center: Vector3D${suffix} = .zero, size: Vector3D${suffix}) {
        self.init(center: Point3D${suffix}(center), size: Size3D${suffix}(size))
    }

    public init(center: ${vector} = .zero, size: ${vector}) {
        self.init(center: Point3D${suffix}(center), size: Size3D${suffix}(size))
    }

    /// `SPRect3DMakeFromPoints`: the box that holds them all, and an empty box when given none.
    public init(points: [Point3D${suffix}]) {
        guard let first = points.first else {
            self.init(origin: Point3D${suffix}.zero, size: Size3D${suffix}.zero)
            return
        }
        var low = first.vector
        var high = first.vector
        for point in points.dropFirst() {
            low = simd_min(low, point.vector)
            high = simd_max(high, point.vector)
        }
        self.init(origin: Point3D${suffix}(low), size: Size3D${suffix}(high - low))
    }

    public static let zero = Rect3D${suffix}()
    public static let infinity = Rect3D${suffix}(origin: Point3D${suffix}.infinity, size: Size3D${suffix}.infinity)

    public var isZero: Bool { origin.isZero && size.isZero }
    public var isFinite: Bool { origin.isFinite && size.isFinite }
    public var isNaN: Bool { origin.isNaN || size.isNaN }

    /// `SPRect3DIsEmpty`: at least two of the three edges are exactly zero.
    public var isEmpty: Bool {
        let edges = [size.width, size.height, size.depth]
        return edges.filter { $0 == 0 }.count >= 2
    }

    /// `SPRect3DGetMinimum`: the corner, moved back along every edge that runs negative.
    public var min: Point3D${suffix} {
        Point3D${suffix}(origin.vector + simd_min(${vector}(repeating: 0), size.vector))
    }

    /// `SPRect3DGetMaximum`: the corner, moved along every edge that runs positive.
    public var max: Point3D${suffix} {
        Point3D${suffix}(origin.vector + simd_max(${vector}(repeating: 0), size.vector))
    }

    public var minX: ${scalar} { min.x }
    public var minY: ${scalar} { min.y }
    public var minZ: ${scalar} { min.z }
    public var maxX: ${scalar} { max.x }
    public var maxY: ${scalar} { max.y }
    public var maxZ: ${scalar} { max.z }
    public var midX: ${scalar} { origin.x + size.width / 2 }
    public var midY: ${scalar} { origin.y + size.height / 2 }
    public var midZ: ${scalar} { origin.z + size.depth / 2 }

    /// `SPRect3DGetCenter`
    public var center: Point3D${suffix} {
        Point3D${suffix}(origin.vector + size.vector / 2)
    }

    /// `SPRect3DStandardize`: the same box, with every edge positive.
    public var standardized: Rect3D${suffix} {
        Rect3D${suffix}(origin: min, size: Size3D${suffix}(simd_abs(size.vector)))
    }

    /// `SPRect3DIntegral`: the smallest box with whole edges that holds this one.
    public var integral: Rect3D${suffix} {
        let standardized = self.standardized
        let origin = floor3(standardized.min.vector)
        return Rect3D${suffix}(origin: Point3D${suffix}(origin),
                                size: Size3D${suffix}(ceil3(standardized.max.vector) - origin))
    }

    /// `SPRect3DGetCornerPoints`, in the order the header lists them.
    public var cornerPoints: [Point3D${suffix}] {
        let corner = origin.vector
        let w = size.width
        let h = size.height
        let d = size.depth
        return [
            Point3D${suffix}(corner),
            Point3D${suffix}(corner + ${vector}(0, h, 0)),
            Point3D${suffix}(corner + ${vector}(w, h, 0)),
            Point3D${suffix}(corner + ${vector}(w, 0, 0)),
            Point3D${suffix}(corner + ${vector}(0, 0, d)),
            Point3D${suffix}(corner + ${vector}(0, h, d)),
            Point3D${suffix}(corner + ${vector}(w, h, d)),
            Point3D${suffix}(corner + ${vector}(w, 0, d)),
        ]
    }

    public static func == (lhs: Rect3D${suffix}, rhs: Rect3D${suffix}) -> Bool {
        lhs.origin == rhs.origin && lhs.size == rhs.size
    }

    public static func * (lhs: AffineTransform3D${suffix}, rhs: Rect3D${suffix}) -> Rect3D${suffix} { rhs.applying(lhs) }
    public static func * (lhs: ProjectiveTransform3D${suffix}, rhs: Rect3D${suffix}) -> Rect3D${suffix} { rhs.applying(lhs) }
    public static func * (lhs: Pose3D${suffix}, rhs: Rect3D${suffix}) -> Rect3D${suffix} { rhs.applying(lhs) }

    /// The origin is scaled with the size: the host turns the box from origin (-1, -2, -3) and
    /// size (2, 3, 4) into origin (-2, -4, -6) and size (4, 6, 8), which is a scaling about the
    /// world origin and not one about the box's own.
    public func scaledBy(x: ${scalar} = 1, y: ${scalar} = 1, z: ${scalar} = 1) -> Rect3D${suffix} {
        let moved = Vector3D${suffix}(origin.vector).scaledBy(x: x, y: y, z: z)
        return Rect3D${suffix}(origin: Point3D${suffix}(moved), size: size.scaledBy(x: x, y: y, z: z))
    }

    public mutating func scaleBy(x: ${scalar} = 1, y: ${scalar} = 1, z: ${scalar} = 1) {
        self = scaledBy(x: x, y: y, z: z)
    }

    public func scaled(by scale: Size3D${suffix}) -> Rect3D${suffix} { scaledBy(x: scale.width, y: scale.height, z: scale.depth) }
    public mutating func scale(by scale: Size3D${suffix}) { self = scaled(by: scale) }
    public func uniformlyScaled(by scale: ${scalar}) -> Rect3D${suffix} { scaledBy(x: scale, y: scale, z: scale) }
    public mutating func uniformlyScale(by scale: ${scalar}) { self = uniformlyScaled(by: scale) }

    public func sheared(_ shear: AxisWithFactors${suffix}) -> Rect3D${suffix} {
        applying(shearMatrix(for: shear))
    }

    public mutating func shear(_ shear: AxisWithFactors${suffix}) { self = sheared(shear) }

    public func translated(by vector: Vector3D${suffix}) -> Rect3D${suffix} {
        Rect3D${suffix}(origin: origin + vector, size: size)
    }

    @available(*, deprecated, message: "Use the `Vector3D` variant.")
    public func translated(by size: Size3D${suffix}) -> Rect3D${suffix} {
        Rect3D${suffix}(origin: origin, size: self.size + size)
    }

    public mutating func translate(by vector: Vector3D${suffix}) { self = translated(by: vector) }
    public mutating func translate(by size: Size3D${suffix}) { self.size += size }

    public func rotated(by rotation: Rotation3D${suffix}) -> Rect3D${suffix} { applying(rotation.affineTransform) }
    public func rotated(by quaternion: ${quat}) -> Rect3D${suffix} { applying(Rotation3D${suffix}(quaternion).affineTransform) }

    public func rotated(by rotation: Rotation3D${suffix}, around pivot: Point3D${suffix}) -> Rect3D${suffix} {
        let corner = Point3D${suffix}(x: origin.x - pivot.x, y: origin.y - pivot.y, z: origin.z - pivot.z)
        let turned = Rect3D${suffix}(origin: Point3D${suffix}(corner.vector).rotated(by: rotation), size: self.size)
        return Rect3D${suffix}(origin: Point3D${suffix}(x: turned.origin.x + pivot.x,
                                                           y: turned.origin.y + pivot.y,
                                                           z: turned.origin.z + pivot.z),
                            size: turned.size)
    }

    public func rotated(by quaternion: ${quat}, around pivot: Point3D${suffix}) -> Rect3D${suffix} {
        rotated(by: Rotation3D${suffix}(quaternion), around: pivot)
    }

    public mutating func rotate(by rotation: Rotation3D${suffix}) { self = rotated(by: rotation) }
    public mutating func rotate(by quaternion: ${quat}) { self = rotated(by: quaternion) }

    /// `SPRect3DRotationTo`: the rotation that takes this box's origin onto the other's.
    public func rotation(to other: Rect3D${suffix}) -> Rotation3D${suffix} {
        origin.rotation(to: other.origin)
    }

    public func applying(_ transform: AffineTransform3D${suffix}) -> Rect3D${suffix} { applying(matrix: transform.matrix4x4) }
    public func applying(_ transform: ProjectiveTransform3D${suffix}) -> Rect3D${suffix} { applying(matrix: transform.matrix4x4) }
    public func applying(_ pose: Pose3D${suffix}) -> Rect3D${suffix} { applying(matrix: pose.matrix) }
    public func applying(_ scaledPose: ScaledPose3D${suffix}) -> Rect3D${suffix} { applying(matrix: scaledPose.matrix) }

    public func unapplying(_ transform: AffineTransform3D${suffix}) -> Rect3D${suffix} { unapplying(matrix: transform.matrix4x4) }
    public func unapplying(_ transform: ProjectiveTransform3D${suffix}) -> Rect3D${suffix} { unapplying(matrix: transform.matrix4x4) }
    public func unapplying(_ pose: Pose3D${suffix}) -> Rect3D${suffix} { unapplying(matrix: pose.matrix) }
    public func unapplying(_ scaledPose: ScaledPose3D${suffix}) -> Rect3D${suffix} { unapplying(matrix: scaledPose.matrix) }

    public mutating func apply(_ transform: AffineTransform3D${suffix}) { self = applying(transform) }
    public mutating func apply(_ transform: ProjectiveTransform3D${suffix}) { self = applying(transform) }
    public mutating func apply(_ pose: Pose3D${suffix}) { self = applying(pose) }
    public mutating func unapply(_ transform: AffineTransform3D${suffix}) { self = unapplying(transform) }
    public mutating func unapply(_ transform: ProjectiveTransform3D${suffix}) { self = unapplying(transform) }
    public mutating func unapply(_ pose: Pose3D${suffix}) { self = unapplying(pose) }

    /// `SPRect3DApplyAffineTransform`: the box that holds the eight turned corners.
    func applying(matrix: ${matrix}) -> Rect3D${suffix} {
        Rect3D${suffix}(points: cornerPoints.map { Point3D${suffix}(first3(simd_mul(matrix, SIMD4<${scalar}>($0.vector, 1)))) })
    }

    /// `SPRect3DUnapplyAffineTransform` gives up on a transform that is not rectilinear, because
    /// pulling a turned box back through one is not a box; the SDK answers the box unchanged.
    func unapplying(matrix: ${matrix}) -> Rect3D${suffix} {
        let three = ${matrix3}(columns: (first3(matrix.columns.0), first3(matrix.columns.1), first3(matrix.columns.2)))
        guard AffineTransform3D${suffix}(matrix: simd_matrix(three.columns.0, three.columns.1,
                                                            three.columns.2, first3(matrix.columns.3))).isRectilinear,
              let inverse = invertedMatrix(matrix) else { return self }
        return applying(matrix: inverse)
    }

    private func shearMatrix(for shear: AxisWithFactors${suffix}) -> AffineTransform3D${suffix} {
        AffineTransform3D${suffix}(shear: shear)
    }

    public func contains(_ other: Self) -> Bool {
        let low = min.vector
        let high = max.vector
        let otherLow = other.min.vector
        let otherHigh = other.max.vector
        return low.x <= otherLow.x && low.y <= otherLow.y && low.z <= otherLow.z &&
            high.x >= otherHigh.x && high.y >= otherHigh.y && high.z >= otherHigh.z
    }

    public func contains(point: Point3D${suffix}) -> Bool {
        let low = min.vector
        let high = max.vector
        let p = point.vector
        return low.x <= p.x && low.y <= p.y && low.z <= p.z &&
            high.x >= p.x && high.y >= p.y && high.z >= p.z
    }

    /// Any of the points, not all of them: the host answers true for a box of 2x3x4 and the two
    /// points (9, 9, 9) and (1, 1, 1), where the first is outside and the second inside.
    public func contains(anyOf points: [Point3D${suffix}]) -> Bool {
        points.contains { contains(point: $0) }
    }

    public func union(_ other: Self) -> Self {
        let left = standardized
        let right = other.standardized
        let origin = simd_min(left.origin.vector, right.origin.vector)
        return Rect3D${suffix}(origin: Point3D${suffix}(origin),
                              size: Size3D${suffix}(simd_max(left.max.vector, right.max.vector) - origin))
    }

    public mutating func formUnion(_ other: Self) { self = union(other) }

    /// `SPRect3DIntersection` answers `nil` when the two do not meet, which it decides by the
    /// smallest edge of the overlap.
    public func intersection(_ other: Self) -> Self? {
        let left = standardized
        let right = other.standardized
        let origin = simd_max(left.origin.vector, right.origin.vector)
        let size = simd_min(left.max.vector, right.max.vector) - origin
        guard simd_reduce_min(size) >= 0 else { return nil }
        return Rect3D${suffix}(origin: Point3D${suffix}(origin), size: Size3D${suffix}(size))
    }

    public mutating func formIntersection(_ other: Self) { self = intersection(other) ?? .zero }

    public func intersects(_ other: Self) -> Bool {
        intersection(other) != nil
    }

    /// `SPRect3DInset`: moved in by `dXYZ` on every side, which can turn an edge negative.
    public func inset(by dXYZ: Size3D${suffix}) -> Rect3D${suffix} {
        let rect = standardized
        let inset = dXYZ.vector
        return Rect3D${suffix}(origin: Point3D${suffix}(rect.origin.vector + inset),
                              size: Size3D${suffix}(rect.size.vector - 2 * inset))
    }

    public mutating func formInset(by dXYZ: Size3D${suffix}) { self = inset(by: dXYZ) }

    public func hash(into hasher: inout Hasher) {
        hasher.combine(origin)
        hasher.combine(size)
    }

    private enum CodingKeys: String, CodingKey { case origin, size }

    public func encode(to encoder: any Encoder) throws {
        var container = encoder.container(keyedBy: CodingKeys.self)
        try container.encode(origin, forKey: .origin)
        try container.encode(size, forKey: .size)
    }

    public init(from decoder: any Decoder) throws {
        let container = try decoder.container(keyedBy: CodingKeys.self)
        self.init(origin: try container.decode(Point3D${suffix}.self, forKey: .origin),
                  size: try container.decode(Size3D${suffix}.self, forKey: .size))
    }

    public var description: String {
        "(origin: \(origin), size: \(size))"
    }

    public var customMirror: Mirror {
        Mirror(self, children: ["origin": origin, "size": size])
    }
}

// MARK: - Ray3D${suffix}

/// A half line: a point it starts at, and the direction it runs in.
@frozen
public struct Ray3D${suffix}: ${"Primitive3D, Primitive3DProtocol, Translatable3DProtocol, Hashable, Codable, CustomStringConvertible, CustomReflectable, Sendable" if suffix == "" else "Primitive3DProtocolFloat, Translatable3DProtocolFloat, Hashable, Codable, CustomStringConvertible, CustomReflectable, Sendable"} {
    public typealias Scalar = ${scalar}
    public typealias AffineTransform = AffineTransform3D${suffix}
    public typealias ProjectiveTransform = ProjectiveTransform3D${suffix}
    public typealias Pose = Pose3D${suffix}
    public typealias Rect = Rect3D${suffix}
    public typealias Vector = Vector3D${suffix}
    public typealias Point = Point3D${suffix}
    public typealias Size = Size3D${suffix}
    public typealias Rotation = Rotation3D${suffix}
    public typealias Quaternion = ${quat}
    public typealias AxisEnumeration = AxisWithFactors${suffix}

    public var origin: Point3D${suffix}
    public var direction: Vector3D${suffix}

    public init() { self.init(origin: .zero, direction: .zero) }

    public init(origin: Point3D${suffix} = .zero, direction: Vector3D${suffix}) {
        self.origin = origin
        // `SPRay3DMake` normalises a direction that has a length and leaves a direction of zero
        // length at zero. Normalising unconditionally does not: the host's
        // Ray3D(origin: .zero, direction: .zero).direction is (0, 0, 0) and its isZero is true,
        // where dividing (0, 0, 0) by its own length of zero gives (nan, nan, nan) and a zero ray
        // that is not zero.
        let length = direction.length
        self.direction = length.isFinite && length > 0 ? direction.normalized : direction
    }

    public init(origin: ${vector} = .zero, direction: ${vector}) {
        self.init(origin: Point3D${suffix}(origin), direction: Vector3D${suffix}(direction))
    }

    public static let zero = Ray3D${suffix}()
    public static let infinity = Ray3D${suffix}(origin: .infinity, direction: .infinity)

    public var isZero: Bool { origin.isZero && direction.isZero }
    public var isFinite: Bool { origin.isFinite && direction.isFinite }
    public var isNaN: Bool { origin.isNaN || direction.isNaN }

    public static func == (lhs: Ray3D${suffix}, rhs: Ray3D${suffix}) -> Bool {
        lhs.origin == rhs.origin && lhs.direction == rhs.direction
    }

    public static func * (lhs: Pose3D${suffix}, rhs: Ray3D${suffix}) -> Ray3D${suffix} { rhs.applying(lhs) }

    public func translated(by vector: Vector3D${suffix}) -> Ray3D${suffix} {
        Ray3D${suffix}(origin: origin + vector, direction: direction)
    }

    @available(*, deprecated, message: "Use the `Vector3D` variant.")
    public func translated(by size: Size3D${suffix}) -> Ray3D${suffix} { self.translated(by: Vector3D${suffix}(size)) }

    public mutating func translate(by vector: Vector3D${suffix}) { self = translated(by: vector) }
    public mutating func translate(by size: Size3D${suffix}) { self = translated(by: Vector3D${suffix}(size)) }

    public func rotated(by rotation: Rotation3D${suffix}) -> Ray3D${suffix} { applying(rotation.affineTransform) }
    public func rotated(by quaternion: ${quat}) -> Ray3D${suffix} { applying(Rotation3D${suffix}(quaternion).affineTransform) }

    public func rotated(by rotation: Rotation3D${suffix}, around pivot: Point3D${suffix}) -> Ray3D${suffix} {
        let turned = (origin - pivot).rotated(by: rotation)
        return Ray3D${suffix}(origin: Point3D${suffix}(x: pivot.x + turned.x, y: pivot.y + turned.y,
                                                     z: pivot.z + turned.z),
                             direction: direction.rotated(by: rotation))
    }

    public func rotated(by quaternion: ${quat}, around pivot: Point3D${suffix}) -> Ray3D${suffix} {
        rotated(by: Rotation3D${suffix}(quaternion), around: pivot)
    }

    /// `Rotatable3DProtocol` asks a ray for the rotation between two of them, which is the one
    /// between their directions. The framework's own newer release no longer gives `Ray3D` this,
    /// but the protocol of the target still requires it, so a ray that conforms answers it.
    public func rotation(to other: Ray3D${suffix}) -> Rotation3D${suffix} {
        direction.rotation(to: other.direction)
    }

    public mutating func rotate(by rotation: Rotation3D${suffix}) { self = rotated(by: rotation) }
    public mutating func rotate(by quaternion: ${quat}) { self = rotated(by: quaternion) }

    public func applying(_ transform: AffineTransform3D${suffix}) -> Ray3D${suffix} { applying(matrix: transform.matrix4x4) }
    public func applying(_ transform: ProjectiveTransform3D${suffix}) -> Ray3D${suffix} { applying(matrix: transform.matrix4x4) }
    public func applying(_ pose: Pose3D${suffix}) -> Ray3D${suffix} { applying(matrix: pose.matrix) }
    public func applying(_ scaledPose: ScaledPose3D${suffix}) -> Ray3D${suffix} { applying(matrix: scaledPose.matrix) }

    public func unapplying(_ transform: AffineTransform3D${suffix}) -> Ray3D${suffix} { unapplying(matrix: transform.matrix4x4) }
    public func unapplying(_ transform: ProjectiveTransform3D${suffix}) -> Ray3D${suffix} { unapplying(matrix: transform.matrix4x4) }
    public func unapplying(_ pose: Pose3D${suffix}) -> Ray3D${suffix} { unapplying(matrix: pose.matrix) }
    public func unapplying(_ scaledPose: ScaledPose3D${suffix}) -> Ray3D${suffix} { unapplying(matrix: scaledPose.matrix) }

    public mutating func apply(_ transform: AffineTransform3D${suffix}) { self = applying(transform) }
    public mutating func apply(_ transform: ProjectiveTransform3D${suffix}) { self = applying(transform) }
    public mutating func apply(_ pose: Pose3D${suffix}) { self = applying(pose) }
    public mutating func unapply(_ transform: AffineTransform3D${suffix}) { self = unapplying(transform) }
    public mutating func unapply(_ transform: ProjectiveTransform3D${suffix}) { self = unapplying(transform) }
    public mutating func unapply(_ pose: Pose3D${suffix}) { self = unapplying(pose) }

    /// `SPRay3DApplyAffineTransform`: the start travels, the direction only turns.
    func applying(matrix: ${matrix}) -> Ray3D${suffix} {
        Ray3D${suffix}(
            origin: Point3D${suffix}(first3(simd_mul(matrix, SIMD4<${scalar}>(origin.vector, 1)))),
            direction: Vector3D${suffix}(first3(simd_mul(matrix, SIMD4<${scalar}>(direction.vector, 0)))))
    }

    func unapplying(matrix: ${matrix}) -> Ray3D${suffix} {
        guard let inverse = invertedMatrix(matrix) else { return self }
        return applying(matrix: inverse)
    }

    /// `SPRay3DIntersectsRect`: the slab test, which lets a direction component of zero divide by
    /// itself and so does the arithmetic say what that means.
    public func intersects(_ rect: Rect3D${suffix}) -> Bool {
        let inverseDirection = ${vector}(repeating: 1) / direction.vector
        let low = rect.min.vector
        let high = rect.max.vector
        let near = inverseDirection.x < 0 ? high : low
        let far = inverseDirection.x < 0 ? low : high
        let origin = self.origin.vector
        let tx0 = (near.x - origin.x) * inverseDirection.x
        let tx1 = (far.x - origin.x) * inverseDirection.x
        let ny = inverseDirection.y < 0 ? high : low
        let fy = inverseDirection.y < 0 ? low : high
        let ty0 = (ny.y - origin.y) * inverseDirection.y
        let ty1 = (fy.y - origin.y) * inverseDirection.y
        let nz = inverseDirection.z < 0 ? high : low
        let fz = inverseDirection.z < 0 ? low : high
        let tz0 = (nz.z - origin.z) * inverseDirection.z
        let tz1 = (fz.z - origin.z) * inverseDirection.z
        let tmin = max(max(min(tx0, tx1), min(ty0, ty1)), min(tz0, tz1))
        let tmax = min(min(max(tx0, tx1), max(ty0, ty1)), max(tz0, tz1))
        return tmax >= tmin
    }

    /// `SPRay3DIntersectsSphere`: the discriminant of the ray against the sphere, kept positive.
    public func intersects(sphereOrigin: Point3D${suffix}, sphereRadius: ${scalar}) -> Bool {
        let x = origin.vector - sphereOrigin.vector
        let y = 4 * simd_dot(direction.vector, direction.vector)
        let z = 2 * simd_dot(x, direction.vector)
        let w = simd_dot(x, x) - sphereRadius * sphereRadius
        return (z * z - y * w) > 0
    }

    public func contains(_ point: Point3D${suffix}) -> Bool {
        Vector3D${suffix}(point.vector - origin.vector).rotated(by: Rotation3D${suffix}(from: direction, to: Vector3D${suffix}.forward)) == .zero
    }

    public func hash(into hasher: inout Hasher) {
        hasher.combine(origin)
        hasher.combine(direction)
    }

    private enum CodingKeys: String, CodingKey { case origin, direction }

    public func encode(to encoder: any Encoder) throws {
        var container = encoder.container(keyedBy: CodingKeys.self)
        try container.encode(origin, forKey: .origin)
        try container.encode(direction, forKey: .direction)
    }

    public init(from decoder: any Decoder) throws {
        let container = try decoder.container(keyedBy: CodingKeys.self)
        self.init(origin: try container.decode(Point3D${suffix}.self, forKey: .origin),
                  direction: try container.decode(Vector3D${suffix}.self, forKey: .direction))
    }

    public var description: String {
        "(origin: \(origin), direction: \(direction))"
    }

    public var customMirror: Mirror {
        Mirror(self, children: ["origin": origin, "direction": direction])
    }
}

% end
