-    DEPENDS ${gyb_tool} ${gyb_tool}.py ${GYB_DEPENDS} ${gyb_expand_deps}
+    DEPENDS ${GYB_DEPENDS} ${gyb_expand_deps}
     COMMENT "Generating GYB source ${fname} from ${source}"
     WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}")
 endfunction()
