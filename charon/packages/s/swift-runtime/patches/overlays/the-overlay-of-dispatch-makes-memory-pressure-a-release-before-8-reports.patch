+/* The memory pressure source type, which iOS 8 brought. */
+SWIFT_DISPATCH_WEAK_SOURCE_TYPE(MEMORYPRESSURE, _dispatch_source_type_memorypressure)
+
+/* What reported memory pressure before it: libdispatch has exported this source type since iOS 4.3 and the SDK no longer
