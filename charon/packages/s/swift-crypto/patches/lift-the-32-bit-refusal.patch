-        #if os(iOS) && (arch(arm) || arch(i386))
-        fatalError("Unsupported architecture")
-        #else
         return HKDF<H>.deriveKey(inputKeyMaterial: SymmetricKey(data: ss), salt: salt, info: sharedInfo, outputByteCount: outputByteCount)
