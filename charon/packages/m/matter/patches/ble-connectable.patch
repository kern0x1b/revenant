diff --git a/src/platform/Darwin/BleConnectionDelegateImpl.mm b/src/platform/Darwin/BleConnectionDelegateImpl.mm
--- a/src/platform/Darwin/BleConnectionDelegateImpl.mm
+++ b/src/platform/Darwin/BleConnectionDelegateImpl.mm
@@ -408,10 +408,15 @@
         return;
     }
 
+    // Charon: iOS 6.1.3's CoreBluetooth never puts the key in an advertisement (CBAdvertisementDataIsConnectable is
+    // absent there, the key is "kCBAdvDataIsConnectable" on the releases that have it), so an absent key is no answer
+    // that the advertisement is not connectable. A commissionable device is connectable, so an absent key counts as
+    // YES here; a connect that then fails is not reported by this file, which has no didFailToConnectPeripheral.
     NSNumber * isConnectable = [advertisementData objectForKey:CBAdvertisementDataIsConnectable];
-    MATTER_LOG_METRIC_END(kMetricBLEDiscoveredPeripheral, [isConnectable boolValue]);
+    BOOL connectable = isConnectable ? [isConnectable boolValue] : YES;
+    MATTER_LOG_METRIC_END(kMetricBLEDiscoveredPeripheral, connectable);
 
-    if ([isConnectable boolValue] == NO) {
+    if (!connectable) {
         ChipLogError(Ble, "A device (%p) with a matching Matter UUID has been discovered but it is not connectable.", peripheral);
         return;
     }
