# Where the phone is and how to reach it. Copy to device.env, which is ignored
# by git, and edit. Charon's device module reads it if it exists.
#
# The default root password on a jailbroken device is well known and is not
# written here: change it on the device and put the new one below, or leave
# DEVICE_PASSWORD unset and use an SSH key, which is what the scripts prefer.

# Over WiFi:
DEVICE_HOST=phone.local          # or its address on your network
DEVICE_PORT=22

# Over USB, with iproxy 2222:22 running:
# DEVICE_HOST=127.0.0.1
# DEVICE_PORT=2222

# Leave unset to use an SSH key from the agent.
# DEVICE_PASSWORD=

# The phone's UDID, used to bring the USB tunnel back when it dies. Optional
# when only one device is attached; required when there are two, because the
# scripts will not guess which one to tunnel to.
# DEVICE_UDID=<udid>
