#version 100
precision highp float;
precision highp int;
uniform highp float revenant_flip;
uniform vec2 revenant_target;
uniform vec2 src_size;
uniform sampler2D src;
void main() {
    vec4 position;
    int t0;
    float t1;
    vec2 t2;
    int t3;
    float t4;
    vec2 t5;
    vec2 t6;
    vec2 t7;
    vec4 t8;
    vec2 t9;
    vec2 t10;
    vec2 t11;
    vec2 t12;
    float t13;
    vec2 t14;
    vec2 t15;
    vec2 t16;
    vec4 t17;
    vec4 t18;
    position = gl_FragCoord;
    position.y = revenant_flip > 0.0 ? revenant_target.y - gl_FragCoord.y : gl_FragCoord.y;
    t0 = int(src_size.x);
    t1 = float(t0);
    t2 = vec2(0.0);
    t2.x = t1;
    t3 = int(src_size.y);
    t4 = float(t3);
    t5 = t2;
    t5.y = t4;
    t6 = vec2((position).x, (position).y);
    t7 = (t6 / t5);
    t8 = texture2D(src, t7);
    t9 = vec2((t8).x, (t8).y);
    t10 = vec2(t9);
    t11 = vec2((t8).z, (t8).w);
    t12 = vec2(t11);
    t13 = float((t8).w);
    t14 = vec2(0.0);
    t14.x = t13;
    t15 = vec2((t14).x, (t14).x);
    t16 = mix(t10, t12, t15);
    t17 = vec4((t16).x, (t16).y, 0.0, 0.0);
    t18 = vec4((t17).x, (t17).y, (vec4(0.0, 0.0, 0.0, 1.0)).z, (vec4(0.0, 0.0, 0.0, 1.0)).w);
    gl_FragColor = t18;
}
