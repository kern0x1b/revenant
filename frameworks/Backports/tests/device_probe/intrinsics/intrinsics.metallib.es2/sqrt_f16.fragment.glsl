#version 100
precision highp float;
precision highp int;
uniform float revenant_flip;
uniform vec2 revenant_target;
uniform vec2 src_size;
uniform sampler2D src;
void main() {
    vec4 position;
    int t0;
    float t1;
    vec2 t2;
    int t3;
    float t4;
    vec2 t5;
    vec2 t6;
    vec2 t7;
    vec4 t8;
    float t9;
    float t10;
    vec4 t11;
    position = gl_FragCoord;
    position.y = revenant_flip > 0.0 ? revenant_target.y - gl_FragCoord.y : gl_FragCoord.y;
    t0 = int(src_size.x);
    t1 = float(t0);
    t2 = vec2(0.0);
    t2.x = t1;
    t3 = int(src_size.y);
    t4 = float(t3);
    t5 = t2;
    t5.y = t4;
    t6 = vec2((position).x, (position).y);
    t7 = (t6 / t5);
    t8 = texture2D(src, t7);
    t9 = sqrt((t8).x);
    t10 = float(t9);
    t11 = vec4(0.0, 0.0, 0.0, 1.0);
    t11.x = t10;
    gl_FragColor = t11;
}
