diff -ruN a/swift-system-1.8.1/Sources/CSystem/csystem_port.c b/swift-system-1.8.1/Sources/CSystem/csystem_port.c
--- a/Sources/CSystem/csystem_port.c
+++ b/Sources/CSystem/csystem_port.c
@@ -0,0 +1,59 @@
+// The calls the port's libSystem lacks at iOS 6.1.3, routed through apple-compat (fstatat, unlinkat, fdopendir) and
+// through weak references (the mach port guards: the 6.1.3 export list has no wrapper for them).
+#include <dirent.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <mach/mach.h>
+#include <toolchain/fdopendir.h>
+#include <toolchain/fstatat.h>
+#include <toolchain/unlinkat.h>
+#include "CSystemDarwin.h"
+
+#pragma weak mach_port_guard
+#pragma weak mach_port_unguard
+#pragma weak mach_port_destruct
+
+int csystem_fstatat(int fd, const char *path, struct stat *buffer, int flags)
+{
+    return fstatat(fd, path, buffer, flags);
+}
+
+int csystem_unlinkat(int fd, const char *path, int flag)
+{
+    return unlinkat(fd, path, flag);
+}
+
+DIR *csystem_fdopendir(int fd)
+{
+    return fdopendir(fd);
+}
+
+kern_return_t csystem_mach_port_guard(mach_port_name_t name, mach_port_context_t guard, boolean_t strict)
+{
+    if (&mach_port_guard == NULL) {
+        return KERN_NOT_SUPPORTED;
+    }
+    return mach_port_guard(mach_task_self(), name, guard, strict);
+}
+
+kern_return_t csystem_mach_port_unguard(mach_port_name_t name, mach_port_context_t guard)
+{
+    if (&mach_port_unguard == NULL) {
+        return KERN_NOT_SUPPORTED;
+    }
+    return mach_port_unguard(mach_task_self(), name, guard);
+}
+
+kern_return_t csystem_mach_port_destruct(mach_port_name_t name, mach_port_delta_t delta, mach_port_context_t guard)
+{
+    if (&mach_port_destruct == NULL) {
+        return KERN_NOT_SUPPORTED;
+    }
+    return mach_port_destruct(mach_task_self(), name, delta, guard);
+}
+
+// The task port, read in C: a Swift reference to the C global mach_task_self_ is refused in Swift 6 mode.
+mach_port_t csystem_mach_task_self(void)
+{
+    return mach_task_self();
+}
