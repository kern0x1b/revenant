-import Darwin
+// os_unfair_lock arrived in iOS 10, macOS 10.12, tvOS 10 and watchOS 3, and the SDK's declaration carries those releases,
+// so importing it holds this library to them. A runtime that ships with the program runs on older releases, where Charon's
+// libc++abi exports the same three calls, one copy for the process; they are named here instead, and the lock is the single
+// 32-bit word os_unfair_lock is (OS_UNFAIR_LOCK_INIT is a zero word).
+@_extern(c, "os_unfair_lock_lock")
+@usableFromInline
+internal func _os_unfair_lock_lock(_ lock: UnsafeMutablePointer<UInt32>)
+
+@_extern(c, "os_unfair_lock_trylock")
+@usableFromInline
+internal func _os_unfair_lock_trylock(_ lock: UnsafeMutablePointer<UInt32>) -> Bool
+
+@_extern(c, "os_unfair_lock_unlock")
+@usableFromInline
+internal func _os_unfair_lock_unlock(_ lock: UnsafeMutablePointer<UInt32>)
 
 @available(SwiftStdlib 6.0, *)
 @frozen
 @_staticExclusiveOnly
 public struct _MutexHandle: ~Copyable {
   @usableFromInline
-  let value: _Cell<os_unfair_lock>
+  let value: _Cell<UInt32>
 
   @available(SwiftStdlib 6.0, *)
   @_alwaysEmitIntoClient
   @_transparent
   public init() {
-    value = _Cell(os_unfair_lock())
+    value = _Cell(0)
   }
 
   @available(SwiftStdlib 6.0, *)
   @_alwaysEmitIntoClient
   @_transparent
   internal borrowing func _lock() {
-    unsafe os_unfair_lock_lock(value._address)
+    unsafe _os_unfair_lock_lock(value._address)
   }
 
   @available(SwiftStdlib 6.0, *)
   @_alwaysEmitIntoClient
   @_transparent
   internal borrowing func _tryLock() -> Bool {
-    unsafe os_unfair_lock_trylock(value._address)
+    unsafe _os_unfair_lock_trylock(value._address)
   }
 
   @available(SwiftStdlib 6.0, *)
   @_alwaysEmitIntoClient
   @_transparent
   internal borrowing func _unlock() {
-    unsafe os_unfair_lock_unlock(value._address)
+    unsafe _os_unfair_lock_unlock(value._address)
   }
 }
