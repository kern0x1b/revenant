@@ -37,7 +37,9 @@ set(${PROJECT_NAME}_VENDOR_MODULE_DIR "${CMAKE_SOURCE_DIR}/../cmake/modules/vend
   CACHE FILEPATH "Location for private build system extension")
 
 find_package(SwiftCore REQUIRED)
-find_package(SwiftOverlay REQUIRED)
+# The C library's Swift overlay ships in the SDK only from iOS 13 on, and this library needs nothing from it: the lock it
