@@ -43,6 +43,16 @@ if (LIBCXXABI_ENABLE_THREADS AND (UNIX OR FUCHSIA) AND NOT (APPLE OR CYGWIN)
   )
 endif()
 
+if (APPLE AND LIBCXXABI_ENABLE_EMULATED_TLS)
+  if (NOT LIBCXXABI_ENABLE_THREADS)
+    message(FATAL_ERROR "LIBCXXABI_ENABLE_EMULATED_TLS keeps thread-local storage behind pthread keys and needs LIBCXXABI_ENABLE_THREADS")
+  endif()
+  list(APPEND LIBCXXABI_SOURCES
+    cxa_thread_atexit.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/../../compiler-rt/lib/builtins/emutls.c
+  )
+endif()
+
 set(LIBCXXABI_HEADERS
   ../include/cxxabi.h
 )
