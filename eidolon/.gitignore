.DS_Store
__pycache__/

# Personal / device data — never tracked. Only the example is.
device.env*
device.*.env
!device.env.example
local.env

# Local screenshots may show device content
**/shots/
*-shots/

# Machine-local work areas and installed packages (several gigabytes, reproducible)
/xmake-global/
/.xmake/
/build/
/charon-main/
/src/
/runs.noindex/
/scratch/
/shots/

# Research artefacts: raw output of the firmware-cache analysis holds symbol lists from Apple's binaries
/a/
/check.lua

# Build output
**/out/
**/out-*/
**/runs.noindex/
/rtpkg/build/
/rtpkg/.xmake/
/eidolon/.xmake/
/eidolon/xmake-addons.lock
/rtpkg/*.log
/rtpkg/xmake-addons.lock
*.o
*.a
*.dylib
*.log
*.tar
*.tar.gz

# Apple's SDK content, copied locally by bridge/prepare-fw.sh: never committed
/bridge/fw/
# generated by bridge/surface-swiftui.sh from the SDK 26.2 interfaces, read by bridge/api-invented.lua
/bridge/apple-26-surface.tsv
# Generated by the scripts in bridge/
/bridge/api/
/bridge/arm64/
/bridge/demo-arm64
/bridge/objc.txt
/bridge/ours.txt
/bridge/ours-evo.txt
/bridge/undef.txt
/bridge/swiftui-demangled.txt
/bridge/missing-demangled.txt
/device-shots/
/device-shots-ipad/

# SwiftPM build output of the surface walker
/bridge/tools/surftool/.build/
/bridge/tools/surftool/swift-syntax/
/bridge/tools/surftool/Package.resolved
