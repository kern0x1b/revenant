From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kern0x1b <kern0x1b@users.noreply.github.com>
Date: Tue, 20 Oct 2026 12:00:00 +0200
Subject: [PATCH] Configure without running Python

The CMake configure ran Python three times: find_package(Python) probes the
interpreter, every framework's unified source bundles were computed by
generate-unified-source-bundles.py through execute_process, and the Cocoa
options regenerated an Xcode debug wrapper with a Python script. The build of
this port runs no Python at configure time:

- WebKitUnifiedSources.cmake computes the bundles in CMake, with the same
  rules as the script: the attributes of a source list line, the order of
  directory, list and name, a bundle per top-level directory and extension,
  the dense filters, the bundle size and costs, and a bundle file rewritten
  only when its text changes;
- configure neither probes nor looks up an interpreter: Python_EXECUTABLE
  is a cache variable whoever builds sets, for the build-time source
  generators that still run Python, and configure warns when it is empty;
- the Xcode debug wrapper is generated only in developer mode.

Header maps are generated by Python too; a build that must not run it
configures with USE_HEADER_MAPS off.
---
 Source/cmake/OptionsCocoa.cmake         |   2 +-
 Source/cmake/WebKitCommon.cmake         |   7 +-
 Source/cmake/WebKitMacros.cmake         |  43 ++--
 Source/cmake/WebKitUnifiedSources.cmake | 295 ++++++++++++++++++++++++
 4 files changed, 314 insertions(+), 33 deletions(-)
 create mode 100644 Source/cmake/WebKitUnifiedSources.cmake

diff --git a/Source/cmake/OptionsCocoa.cmake b/Source/cmake/OptionsCocoa.cmake
index bfedfcb96d7b3e7fb51c8c0ef71869f43e98cd47..ccf9352ccf718db825df926dddfc144ad511b924 100644
--- a/Source/cmake/OptionsCocoa.cmake
+++ b/Source/cmake/OptionsCocoa.cmake
@@ -548,7 +548,7 @@ endif ()
 # Regenerate the Xcode debug wrapper on every (re)configure so its scheme paths
 # and lldbinit source-map track this binary directory. Runs at configure time
 # (not as a build target) to keep the no-op ninja build at zero actions.
-if (EXISTS ${TOOLS_DIR}/Scripts/generate-cmake-xcode-project)
+if (DEVELOPER_MODE AND EXISTS ${TOOLS_DIR}/Scripts/generate-cmake-xcode-project)
     execute_process(
         COMMAND ${Python_EXECUTABLE}
                 ${TOOLS_DIR}/Scripts/generate-cmake-xcode-project
diff --git a/Source/cmake/WebKitCommon.cmake b/Source/cmake/WebKitCommon.cmake
index d6247301b40ca1e63847d51f05f14920510d8d3a..506148529fbc3b1513bdf5d940265b3770d424f0 100644
--- a/Source/cmake/WebKitCommon.cmake
+++ b/Source/cmake/WebKitCommon.cmake
@@ -260,8 +260,10 @@ if (NOT HAS_RUN_WEBKIT_COMMON)
     find_package(Perl 5.10.0 REQUIRED)
     find_package(PerlModules COMPONENTS English FindBin JSON::PP REQUIRED)
 
-    # This module looks preferably for version 3 of Python. If not found, version 2 is searched.
-    find_package(Python COMPONENTS Interpreter REQUIRED)
+    set(Python_EXECUTABLE "" CACHE FILEPATH "Path to the interpreter of the build-time source generators")
+    if (NOT Python_EXECUTABLE)
+        message(WARNING "Python_EXECUTABLE names no interpreter: configure needs none, the build-time source generators do")
+    endif ()
     # Set the variable with uppercase name to keep compatibility with code and users expecting it.
     set(PYTHON_EXECUTABLE ${Python_EXECUTABLE} CACHE FILEPATH "Path to the Python interpreter")
 
@@ -322,6 +324,7 @@ if (NOT HAS_RUN_WEBKIT_COMMON)
     include(WebKitPackaging)
     include(WebKitHeaderMap)
     include(WebKitMacros)
+    include(WebKitUnifiedSources)
     include(WebKitSwiftPrewarm)
     include(WebKitFS)
     include(WebKitCCache)
diff --git a/Source/cmake/WebKitMacros.cmake b/Source/cmake/WebKitMacros.cmake
index 312af70151396a828cdfa3eaf07d7fda3d1a4f9d..dfbd9224b0699bd5c4eebf2b601e6b9df3198703 100644
--- a/Source/cmake/WebKitMacros.cmake
+++ b/Source/cmake/WebKitMacros.cmake
@@ -139,34 +139,25 @@ macro(WEBKIT_COMPUTE_SOURCES _framework)
       list(APPEND _sourceListFileTruePaths "${_derivedSourcesPath}/${_sourcesListFile}")
     endforeach ()
 
-    set(gusb_args --derived-sources-path ${_derivedSourcesPath} --source-tree-path ${CMAKE_CURRENT_SOURCE_DIR})
-    list(APPEND gusb_args --ignore-header-groups)
-    # Windows needs a larger bundle size because that helps keep WebCore.lib's size below the 4GB maximum in debug builds.
-    if (MSVC AND ${_framework} STREQUAL "WebCore" AND ${_framework}_LIBRARY_TYPE STREQUAL "STATIC")
-        list(APPEND gusb_args --max-bundle-size 16)
+    set(gusb_args DERIVED_SOURCES_PATH ${_derivedSourcesPath} SOURCE_TREE_PATH ${CMAKE_CURRENT_SOURCE_DIR})
+    if (DEFINED WEBKIT_MAX_BUNDLE_SIZE)
+        list(APPEND gusb_args MAX_BUNDLE_SIZE ${WEBKIT_MAX_BUNDLE_SIZE} ENFORCE_COST)
+    elseif (MSVC AND ${_framework} STREQUAL "WebCore" AND ${_framework}_LIBRARY_TYPE STREQUAL "STATIC")
+        list(APPEND gusb_args MAX_BUNDLE_SIZE 16)
     endif ()
     if (${_framework} STREQUAL "WebCore")
-        list(APPEND gusb_args --dense-bundle-filter "JS*=JSBindings" --dense-bundle-filter "bindings/*=JSBindings")
-    endif ()
-    if (DEFINED WEBKIT_MAX_BUNDLE_SIZE)
-        list(APPEND gusb_args --max-bundle-size ${WEBKIT_MAX_BUNDLE_SIZE} --enforce-cost)
+        list(APPEND gusb_args DENSE_BUNDLE_FILTERS "JS*=JSBindings" "bindings/*=JSBindings")
     endif ()
 
     if (ENABLE_UNIFIED_BUILDS)
         # One pass generates the bundles (stdout = files to compile) and writes the
         # bundled member list to a side file via --print-bundled-sources.
         set(_bundledSourcesFile "${CMAKE_CURRENT_BINARY_DIR}/${_framework}BundledSources.txt")
-        execute_process(COMMAND ${Python_EXECUTABLE} ${WTF_SCRIPTS_DIR}/generate-unified-source-bundles.py
-            ${gusb_args}
-            --print-bundled-sources "${_bundledSourcesFile}"
-            ${_sourceListFileTruePaths}
-            RESULT_VARIABLE _resultTmp
+        WEBKIT_GENERATE_UNIFIED_SOURCES(${gusb_args}
+            BUNDLED_SOURCES_FILE "${_bundledSourcesFile}"
+            SOURCE_LISTS ${_sourceListFileTruePaths}
             OUTPUT_VARIABLE _outputTmp)
 
-        if (${_resultTmp})
-             message(FATAL_ERROR "generate-unified-source-bundles.py exited with non-zero status, exiting")
-        endif ()
-
         # Member sources folded into bundles: compiled via the bundle, so mark header-only.
         file(STRINGS "${_bundledSourcesFile}" _bundledSources)
         foreach (_sourceFileTmp IN LISTS _bundledSources)
@@ -193,22 +184,15 @@ macro(WEBKIT_COMPUTE_SOURCES _framework)
             endif ()
         endforeach ()
 
-        unset(_resultTmp)
         unset(_outputTmp)
     else ()
         set(_arcSourcesFile "${CMAKE_CURRENT_BINARY_DIR}/${_framework}ARCSources.txt")
-        execute_process(COMMAND ${Python_EXECUTABLE} ${WTF_SCRIPTS_DIR}/generate-unified-source-bundles.py
-            ${gusb_args}
-            "--print-all-sources"
-            --print-arc-sources "${_arcSourcesFile}"
-            ${_sourceListFileTruePaths}
-            RESULT_VARIABLE _resultTmp
+        WEBKIT_GENERATE_UNIFIED_SOURCES(${gusb_args}
+            PRINT_ALL_SOURCES
+            ARC_SOURCES_FILE "${_arcSourcesFile}"
+            SOURCE_LISTS ${_sourceListFileTruePaths}
             OUTPUT_VARIABLE _outputTmp)
 
-        if (${_resultTmp})
-             message(FATAL_ERROR "generate-unified-source-bundles.py exited with non-zero status, exiting")
-        endif ()
-
         # Without bundles there is no *-ARC.mm to key off, so take the @nonARC
         # annotations straight from the source lists to keep the ARC sources in the
         # OBJECT library whose OBJCXX precompiled header agrees on -fobjc-arc.
@@ -220,7 +204,6 @@ macro(WEBKIT_COMPUTE_SOURCES _framework)
                 list(APPEND ${_framework}_SOURCES ${_file})
             endif ()
         endforeach ()
-        unset(_resultTmp)
         unset(_outputTmp)
     endif ()
 endmacro()
diff --git a/Source/cmake/WebKitUnifiedSources.cmake b/Source/cmake/WebKitUnifiedSources.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..a110d7d033e71ac79bb7b6bd8478a510ad02220a
--- /dev/null
+++ b/Source/cmake/WebKitUnifiedSources.cmake
@@ -0,0 +1,295 @@
