+
+function(_WEBKIT_UNIFIED_GLOB_REGEX _out _glob)
+    string(REGEX REPLACE "([][+.^$(){}|\\\\])" "\\\\\\1" _regex "${_glob}")
+    string(REPLACE "*" ".*" _regex "${_regex}")
+    string(REPLACE "?" "." _regex "${_regex}")
+    set(${_out} "^${_regex}$" PARENT_SCOPE)
+endfunction()
+
+function(_WEBKIT_UNIFIED_SANITIZE _out _text)
+    string(REGEX REPLACE "[^A-Za-z0-9]+" "-" _text "${_text}")
+    string(REGEX REPLACE "^-+" "" _text "${_text}")
+    string(REGEX REPLACE "-+$" "" _text "${_text}")
+    if (_text STREQUAL "")
+        set(_text "root")
+    endif ()
+    set(${_out} "${_text}" PARENT_SCOPE)
+endfunction()
+
+function(_WEBKIT_UNIFIED_FLUSH _manager)
+    math(EXPR _count "${_WUS_${_manager}_COUNT} + 1")
+    set(_WUS_${_manager}_COUNT ${_count} PARENT_SCOPE)
+    set(_bundle "${_WUS_OUTPUT}/${_WUS_PREFIX}UnifiedSource-${_WUS_${_manager}_LAST}-${_count}${_WUS_${_manager}_SUFFIX}")
+    set(_text "${_WUS_${_manager}_TEXT}")
+    set(_old "")
+    if (EXISTS "${_bundle}")
+        file(READ "${_bundle}" _old)
+    endif ()
+    if (NOT EXISTS "${_bundle}" OR NOT _old STREQUAL _text)
+        file(WRITE "${_bundle}" "${_text}")
+    endif ()
+    set(_WUS_GENERATED ${_WUS_GENERATED} "${_bundle}" PARENT_SCOPE)
+    set(_WUS_${_manager}_TEXT "" PARENT_SCOPE)
+    set(_WUS_${_manager}_FILES 0 PARENT_SCOPE)
+endfunction()
+
+macro(_WEBKIT_UNIFIED_ADD _manager _path _cost)
+    set(_top "${_path}")
+    cmake_path(GET _top PARENT_PATH _top)
+    string(FIND "${_top}" "/" _slash)
+    if (_slash GREATER -1)
+        string(SUBSTRING "${_top}" 0 ${_slash} _top)
+    endif ()
+    if (_top STREQUAL "")
+        set(_top ".")
+    endif ()
+    _WEBKIT_UNIFIED_SANITIZE(_prefix "${_top}")
+    set(_size ${_WUS_MAX_SIZE})
+    foreach (_filter IN LISTS _WUS_DENSE)
+        string(FIND "${_filter}" "=" _equals)
+        if (_equals GREATER -1)
+            string(SUBSTRING "${_filter}" 0 ${_equals} _glob)
+            math(EXPR _after "${_equals} + 1")
+            string(SUBSTRING "${_filter}" ${_after} -1 _tag)
+        else ()
+            set(_glob "${_filter}")
+            set(_tag "")
+        endif ()
+        _WEBKIT_UNIFIED_GLOB_REGEX(_regex "${_glob}")
+        if ("${_path}" MATCHES "${_regex}")
+            if (_tag STREQUAL "")
+                _WEBKIT_UNIFIED_SANITIZE(_tag "${_glob}")
+            endif ()
+            set(_prefix "${_tag}")
+            if (_WUS_MAX_SIZE GREATER 64)
+                set(_size ${_WUS_MAX_SIZE})
+            else ()
+                set(_size 64)
+            endif ()
+            break ()
+        endif ()
+    endforeach ()
+    if (NOT DEFINED _WUS_${_manager}_LAST OR NOT _WUS_${_manager}_LAST STREQUAL _prefix)
+        if (NOT _WUS_${_manager}_FILES EQUAL 0)
+            _WEBKIT_UNIFIED_FLUSH(${_manager})
+        endif ()
+        if (DEFINED _WUS_${_manager}_LAST)
+            set(_WUS_${_manager}_COUNT_${_WUS_${_manager}_LAST} ${_WUS_${_manager}_COUNT})
+        endif ()
+        if (DEFINED _WUS_${_manager}_COUNT_${_prefix})
+            set(_WUS_${_manager}_COUNT ${_WUS_${_manager}_COUNT_${_prefix}})
+        else ()
+            set(_WUS_${_manager}_COUNT 0)
+        endif ()
+        set(_WUS_${_manager}_LAST "${_prefix}")
+    endif ()
+    math(EXPR _next "${_WUS_${_manager}_FILES} + ${_cost}")
+    if (_WUS_${_manager}_FILES GREATER 0 AND _next GREATER _size)
+        _WEBKIT_UNIFIED_FLUSH(${_manager})
+    endif ()
+    string(APPEND _WUS_${_manager}_TEXT "#include \"${_path}\"\n")
+    math(EXPR _WUS_${_manager}_FILES "${_WUS_${_manager}_FILES} + ${_cost}")
+endmacro()
+
+function(WEBKIT_GENERATE_UNIFIED_SOURCES)
+    set(options PRINT_ALL_SOURCES ENFORCE_COST)
+    set(oneValueArgs DERIVED_SOURCES_PATH SOURCE_TREE_PATH MAX_BUNDLE_SIZE BUNDLED_SOURCES_FILE ARC_SOURCES_FILE BUNDLE_FILENAME_PREFIX OUTPUT_VARIABLE)
+    set(multiValueArgs DENSE_BUNDLE_FILTERS SOURCE_LISTS)
+    cmake_parse_arguments(opt "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})
+
+    if (NOT EXISTS "${opt_SOURCE_TREE_PATH}")
+        message(FATAL_ERROR "Source tree ${opt_SOURCE_TREE_PATH} does not exist.")
+    endif ()
+    if (DEFINED opt_MAX_BUNDLE_SIZE)
+        set(_WUS_MAX_SIZE ${opt_MAX_BUNDLE_SIZE})
+    else ()
+        set(_WUS_MAX_SIZE 8)
+    endif ()
+    set(_WUS_DENSE ${opt_DENSE_BUNDLE_FILTERS})
+    set(_WUS_PREFIX "${opt_BUNDLE_FILENAME_PREFIX}")
+    set(_WUS_OUTPUT "${opt_DERIVED_SOURCES_PATH}/unified-sources")
+    if (NOT opt_PRINT_ALL_SOURCES)
+        file(MAKE_DIRECTORY "${_WUS_OUTPUT}")
+    endif ()
+
+    set(_managers cpp c mm nonarcmm)
+    set(_WUS_cpp_SUFFIX ".cpp")
+    set(_WUS_c_SUFFIX "-c.c")
+    set(_WUS_mm_SUFFIX "-ARC.mm")
+    set(_WUS_nonarcmm_SUFFIX "-nonARC.mm")
+    foreach (_manager IN LISTS _managers)
+        set(_WUS_${_manager}_COUNT 0)
+        set(_WUS_${_manager}_FILES 0)
+        set(_WUS_${_manager}_TEXT "")
+    endforeach ()
+
+    string(ASCII 1 _end)
+    string(ASCII 2 _separator)
+    set(_entries "")
+    set(_index 0)
+    foreach (_list IN LISTS opt_SOURCE_LISTS)
+        file(STRINGS "${_list}" _lines ENCODING UTF-8)
+        foreach (_line IN LISTS _lines)
+            string(FIND "${_line}" "//" _comment)
+            if (_comment GREATER -1)
+                string(SUBSTRING "${_line}" 0 ${_comment} _line)
+            endif ()
+            string(STRIP "${_line}" _line)
+            if (_line STREQUAL "")
+                continue ()
+            endif ()
+            string(MD5 _key "${_line}")
+            if (DEFINED _WUS_SEEN_${_key})
+                message(FATAL_ERROR "duplicate line: ${_line} in ${_list}")
+            endif ()
+            set(_WUS_SEEN_${_key} TRUE)
+
+            set(_unifiable TRUE)
+            set(_nonarc FALSE)
+            set(_cost 1)
+            set(_path "${_line}")
+            string(FIND "${_line}" "@" _at)
+            if (_at GREATER -1)
+                string(SUBSTRING "${_line}" 0 ${_at} _path)
+                math(EXPR _after "${_at} + 1")
+                string(SUBSTRING "${_line}" ${_after} -1 _attributes)
+                string(REGEX REPLACE "[ \t]*@" ";" _attributes "${_attributes}")
+                foreach (_attribute IN LISTS _attributes)
+                    string(STRIP "${_attribute}" _attribute)
+                    if (_attribute STREQUAL "no-unify")
+                        set(_unifiable FALSE)
+                    elseif (_attribute MATCHES "^no-unify-when\\(")
+                        if (NOT _attribute MATCHES "^no-unify-when\\(bundle<=([0-9]+)\\)$")
+                            message(FATAL_ERROR "malformed attribute: @${_attribute}")
+                        endif ()
+                        if (NOT _WUS_MAX_SIZE GREATER CMAKE_MATCH_1)
+                            set(_unifiable FALSE)
+                        endif ()
+                    elseif (_attribute STREQUAL "nonARC")
+                        set(_nonarc TRUE)
+                    elseif (_attribute MATCHES "^header:")
+                    elseif (_attribute MATCHES "^cost:([0-9]+)$")
+                        if (opt_ENFORCE_COST)
+                            set(_cost ${CMAKE_MATCH_1})
+                        endif ()
+                    else ()
+                        message(FATAL_ERROR "unknown attribute: ${_attribute}")
+                    endif ()
+                endforeach ()
+            endif ()
+            string(STRIP "${_path}" _path)
+            if (IS_ABSOLUTE "${_path}")
+                message(FATAL_ERROR "path parsed from \"${_line}\" is absolute; use a relative path")
+            endif ()
+            get_filename_component(_extension "${_path}" LAST_EXT)
+            set(_manager "")
+            if (_extension STREQUAL ".cpp")
+                set(_manager cpp)
+            elseif (_extension STREQUAL ".c")
+                set(_manager c)
+            elseif (_extension STREQUAL ".mm")
+                if (_nonarc)
+                    set(_manager nonarcmm)
+                else ()
+                    set(_manager mm)
+                endif ()
+            elseif (_nonarc)
+                message(FATAL_ERROR "used @nonARC with source file that does not have a .mm extension")
+            endif ()
+
+            get_filename_component(_directory "${_path}" DIRECTORY)
+            get_filename_component(_name "${_path}" NAME)
+            string(REPLACE "/" "${_separator}" _parts "${_directory}")
+            string(LENGTH "${_index}" _digits)
+            set(_padded "${_index}")
+            while (_digits LESS 6)
+                string(PREPEND _padded "0")
+                math(EXPR _digits "${_digits} + 1")
+            endwhile ()
+            list(APPEND _entries "${_parts}${_end}${_padded}${_end}${_name}${_end}${_path}${_end}${_manager}${_end}${_unifiable}${_end}${_cost}")
+        endforeach ()
+        math(EXPR _index "${_index} + 1")
+    endforeach ()
+    list(SORT _entries COMPARE STRING)
+
+    set(_WUS_GENERATED "")
+    set(_bundled "")
+    set(_arc "")
+    foreach (_entry IN LISTS _entries)
+        string(REPLACE "${_end}" ";" _fields "${_entry}")
+        list(GET _fields 3 _path)
+        list(GET _fields 4 _manager)
+        list(GET _fields 5 _unifiable)
+        list(GET _fields 6 _cost)
+        set(_shown "${_path}")
+        if (NOT EXISTS "${opt_SOURCE_TREE_PATH}/${_path}")
+            set(_derived "${opt_DERIVED_SOURCES_PATH}/${_path}")
+        else ()
+            set(_derived "")
+        endif ()
+        if (opt_PRINT_ALL_SOURCES)
+            if (_derived)
+                set(_shown "${_derived}")
+            endif ()
+            list(APPEND _WUS_GENERATED "${_shown}")
+            if (_manager STREQUAL "mm")
+                list(APPEND _arc "${_shown}")
+            endif ()
+        elseif (_manager STREQUAL "" OR NOT _unifiable)
+            list(APPEND _WUS_GENERATED "${_path}")
+        else ()
+            _WEBKIT_UNIFIED_ADD(${_manager} "${_path}" ${_cost})
+            if (_derived)
+                list(APPEND _bundled "${_derived}")
+            else ()
+                list(APPEND _bundled "${_path}")
+            endif ()
+        endif ()
+    endforeach ()
+
+    if (NOT opt_PRINT_ALL_SOURCES)
+        foreach (_manager IN LISTS _managers)
+            if (NOT _WUS_${_manager}_FILES EQUAL 0)
+                _WEBKIT_UNIFIED_FLUSH(${_manager})
+            endif ()
+        endforeach ()
+    endif ()
+
+    if (DEFINED opt_BUNDLED_SOURCES_FILE AND NOT opt_PRINT_ALL_SOURCES)
+        set(_text "")
+        foreach (_file IN LISTS _bundled)
+            string(APPEND _text "${_file}\n")
+        endforeach ()
+        file(WRITE "${opt_BUNDLED_SOURCES_FILE}" "${_text}")
+    endif ()
+    if (DEFINED opt_ARC_SOURCES_FILE AND opt_PRINT_ALL_SOURCES)
+        set(_text "")
+        foreach (_file IN LISTS _arc)
+            string(APPEND _text "${_file}\n")
+        endforeach ()
+        file(WRITE "${opt_ARC_SOURCES_FILE}" "${_text}")
+    endif ()
+    set(${opt_OUTPUT_VARIABLE} ${_WUS_GENERATED} PARENT_SCOPE)
+endfunction()
