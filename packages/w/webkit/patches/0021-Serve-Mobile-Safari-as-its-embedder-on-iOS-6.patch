     NSData *data = [m_pasteboard dataForPasteboardType:UIColorPboardType];
+#if defined(WEBKIT_IOS6)
+    UIColor *uiColor = dynamic_objc_cast<UIColor>([NSKeyedUnarchiver unarchiveObjectWithData:data]);
