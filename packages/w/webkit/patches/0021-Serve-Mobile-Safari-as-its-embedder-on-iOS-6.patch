From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kern0x1b <kern0x1b@users.noreply.github.com>
Date: Wed, 16 Sep 2026 12:00:00 +0200
Subject: [PATCH] Serve Mobile Safari as its embedder on iOS 6

The pasteboard is written the way this release does it, with the async
clipboard left off; a page's share goes to the system share sheet; an embedder
can add globals without being the frame load delegate; the browser version that
goes with the engine is reported; the user agent rule no longer names a 2012
build; and the Notifications API is on.
---
 .../editing/cocoa/NodeHTMLConverter.mm        |  11 ++
 Source/WebCore/page/Quirks.cpp                |  20 ++-
 .../platform/ios/PlatformPasteboardIOS.mm     |  82 +++++++--
 Source/WebKitLegacy/WebKitLegacy-iOS.exp      |  88 +++++-----
 .../ios/WebCoreSupport/WebChromeClientIOS.mm  | 156 ++++++++++++++++--
 .../WebKitLegacy/mac/WebView/WebViewPrivate.h |  29 ++++
 6 files changed, 322 insertions(+), 64 deletions(-)

diff --git a/Source/WebCore/editing/cocoa/NodeHTMLConverter.mm b/Source/WebCore/editing/cocoa/NodeHTMLConverter.mm
index e9678b1b544345404beb3fb52c63a98fdc011eb4..09dde95aaea4c9be8a43784d05bcd68fa8aeceb0 100644
--- a/Source/WebCore/editing/cocoa/NodeHTMLConverter.mm
+++ b/Source/WebCore/editing/cocoa/NodeHTMLConverter.mm
@@ -869,7 +869,18 @@ static Color normalizedColor(Color color, bool ignoreDefaultColor, Element& elem
     Ref primaryFont = renderer->style().fontCascade().primaryFont();
     if (primaryFont->attributes().origin == FontOrigin::Remote)
         return [PlatformFontClass systemFontOfSize:defaultFontSize];
+#if defined(WEBKIT_IOS6)
+    RetainPtr coreTextFont = primaryFont->ctFont();
+    if (!coreTextFont)
+        return [PlatformFontClass systemFontOfSize:defaultFontSize];
+    CGFloat size = CTFontGetSize(coreTextFont.get());
+    RetainPtr postScriptName = adoptCF(CTFontCopyPostScriptName(coreTextFont.get()));
+    if (RetainPtr platformFont = [PlatformFontClass fontWithName:(__bridge NSString *)postScriptName.get() size:size])
+        return platformFont.autorelease();
+    return [PlatformFontClass systemFontOfSize:size];
+#else
     return (__bridge PlatformFont *)primaryFont->ctFont();
+#endif
 }
 
 NSDictionary *HTMLConverter::computedAttributesForElement(Element& element)
