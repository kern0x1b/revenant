+        get(m_lhs, t0)
+        loadConstantOrVariable(size, t2, t3, t1)
+        loadConstantOrVariable2Reg(size, t0, t2, t0)
+        bineq t2, t3, .slow
+        bieq t2, CellTag, .slow
+        bib t2, LowestTag, .slow
+        integerComparison(t0, t1, .jumpTarget)
+        dispatch()
+
+    .jumpTarget:
+        jump(m_targetLabel)
+
+    .slow:
+        callSlowPath(_llint_slow_path_%opcodeName%)
+        nextInstruction()
+    end)
