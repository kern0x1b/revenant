+    .op1NotInt:
+        bia t0, LowestTag, .slow
+        bib t2, LowestTag, .op1NotIntOp2Double
+        bineq t2, Int32Tag, .slow
+        ci2ds t3, ft1
+        jmp .op1NotIntReady
+    .op1NotIntOp2Double:
+        fii2d t3, t2, ft1
+    .op1NotIntReady:
+        fii2d t1, t0, ft0
+        doubleCompareAndSet(ft0, ft1, t1)
+        return(BooleanTag, t1)
+
+    .op2NotInt:
+        ci2ds t1, ft0
+        bia t2, LowestTag, .slow
+        fii2d t3, t2, ft1
+        doubleCompareAndSet(ft0, ft1, t1)
+        return(BooleanTag, t1)
