+ALWAYS_INLINE static size_t computeUTF8ByteLength(const String& string)
+{
+    if (string.isEmpty())
+        return 0;
+    if (string.is8Bit()) {
+        auto span = string.span8();
+        if (charactersAreAllASCII(span))
+            return span.size();
+    }
+    return string.utf8().length();
