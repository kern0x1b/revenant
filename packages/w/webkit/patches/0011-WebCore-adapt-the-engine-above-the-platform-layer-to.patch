diff --git a/Source/WebCore/Modules/ShapeDetection/Implementation/Cocoa/VisionUtilities.mm b/Source/WebCore/Modules/ShapeDetection/Implementation/Cocoa/VisionUtilities.mm
index a51edfed8515c7a57cc0a6ddaab3965864dbefcd..c12eecb58907728c421fa1aa651a8ee0ab2e5b98 100644
