+static bool scriptBytecodeCacheChatterEnabled()
+{
+    static int enabled = -1;
+    if (enabled < 0)
+        enabled = access("/tmp/native-bytecode-log", F_OK) == 0 ? 1 : 0;
+    return enabled == 1;
+}
