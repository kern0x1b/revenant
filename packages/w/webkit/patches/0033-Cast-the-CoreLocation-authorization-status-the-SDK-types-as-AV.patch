From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kern0x1b <kern0x1b@users.noreply.github.com>
Date: Fri, 30 Oct 2026 13:30:00 +0100
Subject: [PATCH] Cast the CoreLocation authorization status the SDK types as AVFoundation's

The iOS 26.2 SDK types the authorizationStatus class method of CLLocationManager, called through the soft-linked class, as AVAuthorizationStatus, so assigning it to a CLAuthorizationStatus and passing it to isAuthorizationGranted fail to compile. The value is the CLAuthorizationStatus CoreLocation returns, so each call site casts it to that type.

---
--- a/Source/WebKitLegacy/ios/Misc/WebGeolocationCoreLocationProvider.mm
+++ b/Source/WebKitLegacy/ios/Misc/WebGeolocationCoreLocationProvider.mm
@@ -66,7 +66,7 @@
     ASSERT(!_locationManager);
 
     _locationManager = adoptNS([allocCLLocationManagerInstance() init]);
-    _lastAuthorizationStatus = [getCLLocationManagerClassSingleton() authorizationStatus];
+    _lastAuthorizationStatus = (CLAuthorizationStatus)[getCLLocationManagerClassSingleton() authorizationStatus];
 
     [ _locationManager setDelegate:self];
 }
@@ -94,7 +94,7 @@
         return;
     }
 
-    switch ([getCLLocationManagerClassSingleton() authorizationStatus]) {
+    switch ((CLAuthorizationStatus)[getCLLocationManagerClassSingleton() authorizationStatus]) {
     case kCLAuthorizationStatusNotDetermined: {
         if (!_isWaitingForAuthorization) {
             _isWaitingForAuthorization = YES;
@@ -122,7 +122,7 @@
 - (void)start
 {
     if (![getCLLocationManagerClassSingleton() locationServicesEnabled]
-        || !isAuthorizationGranted([getCLLocationManagerClassSingleton() authorizationStatus])) {
+        || !isAuthorizationGranted((CLAuthorizationStatus)[getCLLocationManagerClassSingleton() authorizationStatus])) {
         [_locationManager stopUpdatingLocation];
         [_positionListener resetGeolocation];
         return;
