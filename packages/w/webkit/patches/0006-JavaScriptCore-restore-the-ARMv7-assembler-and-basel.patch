+    static ALWAYS_INLINE bool canEmitJump(void* from, void* to)
+    {
+        intptr_t offset = std::bit_cast<intptr_t>(to) - (std::bit_cast<intptr_t>(from) + 4);
+        return isInt<25>(offset);
+    }
