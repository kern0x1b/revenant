+    void swapDouble(FPRegisterID fr1, FPRegisterID fr2)
+    {
+        if (fr1 == fr2)
+            return;
+        moveDouble(fr1, fpTempRegister);
+        moveDouble(fr2, fr1);
+        moveDouble(fpTempRegister, fr2);
+    }
