+    def printRootAsSwitchC(self, typeName, indent):
+        str = makePadding(indent)
+        seen = {}
+        for k, trie in self.keys:
+            if k[0] in seen:
+                raise Exception("duplicate first character %s at trie root" % k[0])
+            seen[k[0]] = True
+        print(str + "switch (code[0]) {")
+        for k, trie in self.keys:
+            print(str + "case '%s': {" % k[0])
+            if len(k) == 1:
