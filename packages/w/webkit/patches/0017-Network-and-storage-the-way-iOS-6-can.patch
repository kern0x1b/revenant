 .../WebCore/loader/mac/ResourceLoaderMac.mm   |   6 +-
 .../WebCore/platform/sql/SQLiteDatabase.cpp   |  75 +++++++--
 .../Cookies/cocoa/CookieStorageObserver.mm    |   3 +
 .../SocketStreamHandleImplCFNet.cpp           |   6 +
 .../mac/WebCoreSupport/WebFrameLoaderClient.h |   2 +-
 .../WebCoreSupport/WebFrameLoaderClient.mm    | 159 ++++++++++++------
 7 files changed, 186 insertions(+), 68 deletions(-)

