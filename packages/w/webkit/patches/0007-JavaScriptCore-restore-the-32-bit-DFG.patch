+static unsigned envUnsigned(const char* name, unsigned defaultValue)
+{
+    const char* value = getenv(name);
+    if (!value || !value[0])
+        return defaultValue;
+    char* end = nullptr;
+    unsigned long parsed = strtoul(value, &end, 10);
