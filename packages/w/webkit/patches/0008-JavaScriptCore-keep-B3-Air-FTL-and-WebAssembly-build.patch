+        uint32_t fprIndex = 0;
+        uint32_t stackCount = 0;
+        for (uint32_t i = 0; i < signature.argumentCount(); i++) {
+            switch (signature.argumentType(i).kind) {
+            case TypeKind::I64:
+            case TypeKind::Funcref:
+            case TypeKind::Exnref:
+            case TypeKind::Externref:
+            case TypeKind::RefNull:
+            case TypeKind::Ref:
