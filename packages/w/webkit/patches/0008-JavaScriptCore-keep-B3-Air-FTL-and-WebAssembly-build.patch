+#if USE(JSVALUE32_64)
+    case ValueRep::RegisterPair:
+        out.print("SomeRegisterPair");
+        return;
+#endif
     case ValueRep::SomeRegisterWithClobber:
         out.print("SomeRegisterWithClobber");
         return;
