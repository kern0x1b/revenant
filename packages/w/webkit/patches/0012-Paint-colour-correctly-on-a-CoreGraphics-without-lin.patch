+void ImageBufferCGBitmapBackend::transformToColorSpace(const ColorSpace& newColorSpace)
+{
+    if (newColorSpace == colorSpace())
+        return;
+
+    bool toLinear = !(colorSpace() == ColorSpace::LinearSRGB()) && newColorSpace == ColorSpace::LinearSRGB();
+    bool toGammaEncoded = colorSpace() == ColorSpace::LinearSRGB() && !(newColorSpace == ColorSpace::LinearSRGB());
