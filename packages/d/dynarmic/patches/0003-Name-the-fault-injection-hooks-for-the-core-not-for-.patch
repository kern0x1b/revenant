From b86e1a9b2558f02b317e06923eabbafed1e6718a Mon Sep 17 00:00:00 2001
From: kern0x1b <kern0x1b@users.noreply.github.com>
Date: Sat, 19 Sep 2026 19:33:43 +0200
Subject: [PATCH 3/3] Name the fault-injection hooks for the core, not for one
 user of it

The macro, the CMake option and the environment variable that switch the
portable-emit failure hooks were named for the emulator that used them.
They are DYNARMIC_ENABLE_TEST_EMIT_FAILURE and DYNARMIC_TEST_EMIT_FAILURE now.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 CMakeLists.txt                               |  4 ++--
 src/dynarmic/CMakeLists.txt                  |  4 ++--
 src/dynarmic/backend/arm64/a32_interface.cpp | 18 +++++++++---------
 src/dynarmic/backend/x64/a32_interface.cpp   | 18 +++++++++---------
 src/dynarmic/interface/A32/a32.h             |  4 +++-
 src/dynarmic/interface/A32/config.h          |  6 +++++-
 6 files changed, 30 insertions(+), 24 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 336a4f0..2ae232e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -19,8 +19,8 @@ option(DYNARMIC_FATAL_ERRORS "Errors are fatal" OFF)
 option(DYNARMIC_IGNORE_ASSERTS "Ignore asserts" OFF)
 option(DYNARMIC_TESTS "Build tests" ${BUILD_TESTING})
 option(DYNARMIC_TESTS_USE_UNICORN "Enable fuzzing tests against unicorn" OFF)
-option(DYNARMIC_ENABLE_ILEMU_TEST_EMIT_FAILURE
-       "Compile iLEmu portable-emit fault injection hooks" OFF)
+option(DYNARMIC_ENABLE_TEST_EMIT_FAILURE
+       "Compile portable-emit fault injection hooks" OFF)
 option(DYNARMIC_USE_LLVM "Support disassembly of jitted x86_64 code using LLVM" OFF)
 option(DYNARMIC_USE_PRECOMPILED_HEADERS "Use precompiled headers" ON)
 option(DYNARMIC_USE_BUNDLED_EXTERNALS "Use all bundled externals (useful when e.g. cross-compiling)" OFF)
diff --git a/src/dynarmic/CMakeLists.txt b/src/dynarmic/CMakeLists.txt
index 6ef5bdb..30441cd 100644
--- a/src/dynarmic/CMakeLists.txt
+++ b/src/dynarmic/CMakeLists.txt
@@ -522,9 +522,9 @@ endif()
 if (DYNARMIC_ENABLE_NO_EXECUTE_SUPPORT)
     target_compile_definitions(dynarmic PRIVATE DYNARMIC_ENABLE_NO_EXECUTE_SUPPORT=1)
 endif()
-if (DYNARMIC_ENABLE_ILEMU_TEST_EMIT_FAILURE)
+if (DYNARMIC_ENABLE_TEST_EMIT_FAILURE)
     target_compile_definitions(dynarmic PRIVATE
-        DYNARMIC_ENABLE_ILEMU_TEST_EMIT_FAILURE=1)
+        DYNARMIC_ENABLE_TEST_EMIT_FAILURE=1)
 endif()
 if (DYNARMIC_IGNORE_ASSERTS)
     target_compile_definitions(dynarmic PRIVATE MCL_IGNORE_ASSERTS=1)
diff --git a/src/dynarmic/backend/arm64/a32_interface.cpp b/src/dynarmic/backend/arm64/a32_interface.cpp
