BoringSSL's iOS random source (crypto/rand/ios.cc) calls CCRandomGenerateBytes, which the SDK marks ios(8.0) and
which iOS 6 does not have; the only other provider is the CommonCryptoBackports library, a project target a package
cannot depend on. The backport's own CCRandomGenerateBytes is SecRandomCopyBytes
(frameworks/Backports/src/CommonCrypto/CCRandomGenerateBytes.m), so the source calls that directly. The Security
framework is in every iOS release from the first one, and the package links it.

diff --git a/Sources/CCryptoBoringSSL/crypto/rand/ios.cc b/Sources/CCryptoBoringSSL/crypto/rand/ios.cc
index 875e061..7104f39 100644
--- a/Sources/CCryptoBoringSSL/crypto/rand/ios.cc
+++ b/Sources/CCryptoBoringSSL/crypto/rand/ios.cc
@@ -20,12 +20,12 @@
 #if defined(OPENSSL_RAND_IOS)
 #include <stdlib.h>

-#include <CommonCrypto/CommonRandom.h>
+#include <Security/SecRandom.h>

 void CRYPTO_init_sysrand(void) {}

 void CRYPTO_sysrand(uint8_t *out, size_t requested) {
-  if (CCRandomGenerateBytes(out, requested) != kCCSuccess) {
+  if (SecRandomCopyBytes(kSecRandomDefault, requested, out) != errSecSuccess) {
     abort();
   }
 }
