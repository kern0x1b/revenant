+  /// Is this a class of the host, not one of the guest? It lies in neither the guest images nor the arena.
+  bool isOfTheHost() const {
+#if SWIFT_OBJC_INTEROP && defined(__aarch64__)
+    if (xl_guest_image_high) {
+      uintptr_t address = reinterpret_cast<uintptr_t>(this);
+      return address - xl_guest_image_low >= xl_guest_image_high - xl_guest_image_low &&
+             address - xl_guest_arena_low >= xl_guest_arena_high - xl_guest_arena_low;
+    }
+#endif
