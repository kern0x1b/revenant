+    if (!reinterpret_cast<const ClassMetadata *>(bits)->isTypeMetadata()) {
+      id idObject = reinterpret_cast<id>(const_cast<void *>(object));
+      return reinterpret_cast<const ClassMetadata*>(object_getClass(idObject));
+    }
