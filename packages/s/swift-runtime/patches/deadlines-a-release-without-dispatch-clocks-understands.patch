+#if defined(__APPLE__)
+// dispatch_time_t carries which clock it counts from iOS 12 and macOS 10.14 on, the release libdispatch gained workloops:
+// bit 63 says uptime or monotonic and bit 62 says wall time. An older libdispatch reads bit 63 as wall time instead, so a
+// suspending or continuous deadline lands about 292 years ahead and the timer never fires; and the nanoseconds are converted
+// here with the 125/3 timebase Apple's ARM devices have, which iLEmu, for one, does not. Both go away by handing libdispatch
+// what every release understands: how long from now, which it converts with the timebase the machine reports.
+static bool checkDispatchTimeCarriesItsClock() {
+  void *dispatch = dlopen("/usr/lib/system/libdispatch.dylib", RTLD_LAZY | RTLD_NOLOAD);
+  return dispatch != nullptr && dlsym(dispatch, "dispatch_workloop_create") != nullptr;
+}
+
+static bool dispatchTimeCarriesItsClock() {
+  return SWIFT_LAZY_CONSTANT(checkDispatchTimeCarriesItsClock());
+}
+#endif
