@@ -99,2 +98,18 @@
 
+/* A source type a later release brought: NULL where the release has not got its symbol, which is imported weakly. */
+#define SWIFT_DISPATCH_WEAK_SOURCE_TYPE(t, symbol)                             \
+  _Pragma("clang diagnostic push")                                             \
+  _Pragma("clang diagnostic ignored \"-Wunguarded-availability-new\"")         \
+  static inline dispatch_source_type_t _Nullable                               \
+  _swift_dispatch_source_type_##t(void) {                                      \
+    if (&symbol == NULL) {                                                     \
+      return NULL;                                                             \
+    }                                                                          \
+    return DISPATCH_SOURCE_TYPE_##t;                                           \
+  }                                                                            \
+  _Pragma("clang diagnostic pop")
+
+/* The source type that replaces its pending data, which iOS 11 brought. */
+SWIFT_DISPATCH_WEAK_SOURCE_TYPE(DATA_REPLACE, _dispatch_source_type_data_replace)
+
