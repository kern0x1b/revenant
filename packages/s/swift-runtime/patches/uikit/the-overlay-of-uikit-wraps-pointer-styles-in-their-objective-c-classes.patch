+
+// The pointer styles of iOS 13.4. The SDK's Objective-C classes are refined for Swift as `__UIPointerShape`, `__UIPointerEffect`
+// and `__UIPointerEffectTintMode`, and the lowered headers name the factories of UIPointerStyle for Swift as its initializers, so
+// the enums above convert to those objects and the initializers call the factories the backports implement. A release before
+// 13.4 has no pointer interaction to draw a style, so the objects are carried and not drawn.
+//
+// `defaultCornerRadius` is the SDK's own value, measured with a Mac Catalyst program built for arm64-apple-ios26.2-macabi against
+// the iOSSupport UIKit of the macOS SDK: `UIPointerShape.defaultCornerRadius` is `CGFloat.leastNormalMagnitude`. On armv7, where
+// CGFloat is Float, the same expression is `Float.leastNormalMagnitude`.
+extension UIPointerShape {
+    public static let defaultCornerRadius: CGFloat = CGFloat.leastNormalMagnitude
+
+    var revenantObject: __UIPointerShape {
+        switch self {
+        case let .horizontalBeam(length):
+            return __UIPointerShape.beam(withPreferredLength: length, axis: .horizontal)
+        case let .path(path):
+            return __UIPointerShape(path: path)
+        case let .roundedRect(rect, radius):
+            return __UIPointerShape(roundedRect: rect, cornerRadius: radius)
+        case let .verticalBeam(length):
+            return __UIPointerShape.beam(withPreferredLength: length, axis: .vertical)
+        }
+    }
+}
+
+@available(iOS 13.4, *)
+extension UIPointerEffect {
+    var revenantObject: __UIPointerEffect {
+        switch self {
+        case let .automatic(preview):
+            return __UIPointerEffect.automatic(preview)
+        case let .highlight(preview):
+            return __UIPointerEffect.highlight(preview)
+        case let .hover(preview, mode, shadow, scaled):
+            return __UIPointerEffect.hover(preview, preferredTintMode: mode.revenantObject, prefersShadow: shadow, prefersScaledContent: scaled)
+        case let .lift(preview):
+            return __UIPointerEffect.lift(preview)
+        }
+    }
 }
+
+@available(iOS 13.4, *)
+extension UIPointerEffect.TintMode {
+    var revenantObject: __UIPointerEffectTintMode {
+        switch self {
+        case .none:
+            return .none
+        case .overlay:
+            return .overlay
+        case .underlay:
+            return .underlay
+        }
+    }
+}
+
+@available(iOS 13.4, *)
+extension UIPointerStyle {
+    public convenience init(effect: UIPointerEffect, shape: UIPointerShape? = nil) {
+        self.init(revenantEffect: effect.revenantObject, shape: shape?.revenantObject)
+    }
+
+    public convenience init(shape: UIPointerShape, constrainedAxes: UIAxis = []) {
+        self.init(revenantShape: shape.revenantObject, constrainedAxes: constrainedAxes)
+    }
+}
