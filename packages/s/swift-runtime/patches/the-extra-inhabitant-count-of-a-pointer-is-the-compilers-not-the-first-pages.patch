+/// The number of extra inhabitants of a pointer is part of the layout the compiler gave every type that holds one, and the
+/// compiler of arm64 Darwin counts every value below 4GB. The runtime tells an extra inhabitant from a pointer by
+/// LeastValidPointerValue, which this port lowers to the first page, but it must report the count of the compiler: a
+/// tuple, an optional or an enumeration the runtime lays out then picks the extra inhabitant the compiled code reads.
+#if defined(__APPLE__) && defined(__arm64__)
+inline constexpr uintptr_t ExtraInhabitantPointerLimit = 0x100000000ULL;
+#else
+inline constexpr uintptr_t ExtraInhabitantPointerLimit = heap_object_abi::LeastValidPointerValue;
+#endif
+
