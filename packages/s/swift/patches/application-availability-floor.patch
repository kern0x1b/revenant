+AvailabilityContext
+swift::availabilityContextForReference(const Decl *decl,
+                                       const AvailabilityContext &context) {
+  auto &ctx = decl->getASTContext();
+  auto floorVersion = ctx.LangOpts.ApplicationAvailabilityFloor;
+  if (!floorVersion || decl->getModuleContext()->isSystemModule())
+    return context;
+
+  auto domain = ctx.getTargetAvailabilityDomain();
+  if (!domain.supportsContextRefinement())
+    return context;
+
+  auto floored = context;
+  floored.constrainWithAvailabilityRange(AvailabilityRange(*floorVersion),
+                                         domain, ctx);
+  return floored;
+}
