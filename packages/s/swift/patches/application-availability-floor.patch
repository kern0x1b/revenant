 #include "swift/AST/AvailabilityContext.h"
 #include "swift/AST/Decl.h"
+#include "swift/AST/Module.h"
 
 using namespace swift;
 
@@ -365,6 +366,24 @@ swift::getAvailabilityConstraintsForDecl(const Decl *decl,
   return constraints;
