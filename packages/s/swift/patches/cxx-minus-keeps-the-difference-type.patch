+static clang::QualType
+cxxMinusOperatorResult(const clang::FunctionDecl *clangDecl,
+                       clang::QualType returnType) {
+  if (clangDecl->getOverloadedOperator() !=
+          clang::OverloadedOperatorKind::OO_Minus ||
+      clangDecl->getNumParams() != 2)
+    return returnType;
+  auto *record = clangDecl->getParamDecl(0)
+                     ->getType()
+                     .getNonReferenceType()
+                     ->getAsCXXRecordDecl();
+  if (!record || !record->getDefinition())
+    return returnType;
+  clang::ASTContext &clangCtx = clangDecl->getASTContext();
+  auto members = record->getDefinition()->lookup(
+      &clangCtx.Idents.get("difference_type"));
+  auto *difference = members.empty()
+                         ? nullptr
+                         : dyn_cast<clang::TypedefNameDecl>(members.front());
+  if (!difference)
+    return returnType;
+  clang::QualType differenceType = clangCtx.getTypeDeclType(difference);
+  if (differenceType.getCanonicalType() != returnType.getCanonicalType())
+    return returnType;
+  return differenceType;
+}
