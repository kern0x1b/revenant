From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kern0x1b <kern0x1b@users.noreply.github.com>
Date: Mon, 19 Oct 2026 18:09:28 +0200
Subject: [PATCH 3/7] Let the child processes of an addon install see its
 version

The previous commit pins a version installed for a project only in the
installing process, but the on_test scripts of the addons in xmake-repo
run xmake in child processes (avr-devel `xmake create -t avr.blink`,
basic-templates `xmake create`, doxygen-plugin `xmake doxygen --help`),
and a child saw the machine's active version instead, so it tested
another version of the addon.

addon.pin(name, version, {inherit = true}) now also passes the pinned
versions to the child processes in XMAKE_ADDONS_PINNED, and a process
starts from the versions its parent pinned; the installer pins with it.
A version which the parent pinned but which is not installed here,
e.g. a child with another XMAKE_GLOBALDIR, falls back to the active
one instead of hiding the addon. Project pins are still per process.

The release recipes in the addon tests now also check the version in a
child `xmake lua` from on_test; with the scripts of the previous commit
test_autofetch_keep_active_version fails there ("a child process sees
2.0.0 while installing 1.0.0!").

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

Changes-build-output: no

---
 tests/actions/addon/test.lua                  |  5 +++-
 xmake/core/package/addon.lua                  | 24 ++++++++++++++-----
 .../action/require/impl/actions/install.lua   |  2 +-
 3 files changed, 23 insertions(+), 8 deletions(-)

diff --git a/tests/actions/addon/test.lua b/tests/actions/addon/test.lua
index ae3627d..8c51d6b 100644
--- a/tests/actions/addon/test.lua
+++ b/tests/actions/addon/test.lua
@@ -173,7 +173,10 @@ function _release(name, versions, gitdir)
         local addoninfo = addon.addons()[%q]
         assert(addoninfo and addoninfo.version == package:version_str(), "the addon sees %%s while installing %%s!",
             addoninfo and addoninfo.version, package:version_str())
-    end)]]):format(name)
+        local script = ("import('core.package.addon'); print(addon.addons()[%%q].version)"):format(%q)
+        local version = os.iorunv("xmake", {"lua", "-c", script}):trim()
+        assert(version == package:version_str(), "a child process sees %%s while installing %%s!", version, package:version_str())
+    end)]]):format(name, name)
 end
 
 function _with_releases(name, versions, func)
diff --git a/xmake/core/package/addon.lua b/xmake/core/package/addon.lua
index 05c7e5c..f02ccfd 100644
--- a/xmake/core/package/addon.lua
+++ b/xmake/core/package/addon.lua
@@ -479,14 +479,26 @@ end
 -- @note a project locks the versions of its addons, so we need to activate them
 -- when we load it, @see core/project/addons.lua
 --
-function addon.pin(name, version)
+function addon.pin(name, version, opt)
+    local pinned = addon._pinned()
+    pinned[addon.dirname(name)] = version
+    addon._ADDONS = nil
+    if opt and opt.inherit then
+        os.setenv("XMAKE_ADDONS_PINNED", string.serialize(pinned, {strip = true, indent = false}))
+    end
+end
+
+function addon._pinned()
     local pinned = addon._PINNED
     if pinned == nil then
         pinned = {}
+        local inherited = os.getenv("XMAKE_ADDONS_PINNED")
+        if inherited then
+            pinned = inherited:deserialize() or {}
+        end
         addon._PINNED = pinned
     end
-    pinned[addon.dirname(name)] = version
-    addon._ADDONS = nil
+    return pinned
 end
 
 -- get all the installed versions of the given addon, e.g. {"1.0.2", "1.0.3"}
@@ -529,11 +541,11 @@ function addon.addons(opt)
     local addons = addon._ADDONS
     if addons == nil then
         addons = {}
-        local pinned = addon._PINNED or {}
+        local pinned = addon._pinned()
         for dirname, addoninfo in pairs(addon._registry()) do
             -- the project may lock another version of it, @see addon.pin
-            local version = pinned[dirname] or addoninfo.active
-            local versioninfo = addoninfo.versions and addoninfo.versions[version]
+            local versions = addoninfo.versions or {}
+            local versioninfo = versions[pinned[dirname]] or versions[addoninfo.active]
             if versioninfo then
                 addons[dirname] = versioninfo
             end
diff --git a/xmake/modules/private/action/require/impl/actions/install.lua b/xmake/modules/private/action/require/impl/actions/install.lua
index 13a0326..5c52e0b 100644
--- a/xmake/modules/private/action/require/impl/actions/install.lua
+++ b/xmake/modules/private/action/require/impl/actions/install.lua
@@ -336,7 +336,7 @@ function _register_addon(package)
          globalmodules = manifest and #manifest.globalmodules > 0 and manifest.globalmodules or nil})
 
     if not activate then
-        addon.pin(package:name(), version)
+        addon.pin(package:name(), version, {inherit = true})
     end
 end
 
