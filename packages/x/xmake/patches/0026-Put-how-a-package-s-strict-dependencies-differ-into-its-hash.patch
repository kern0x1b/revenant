From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: revenant <revenant@example.invalid>
Date: Wed, 25 Nov 2026 12:00:00 +0200
Subject: [PATCH] Put how a package's strict dependencies differ from their
 defaults into its hash

A package's build hash holds nothing about its dependencies. A dependency with the policy package.strict_compatibility
makes what depends on it be installed again when it changes, into the same folder: a project that asks a library to be
built another way (add_requireconfs) rewrote the package of every other project that shares the store, and a build
could read a package compiled against the other variant of the library.

The configurations of a strict library dependency that differ from their declared defaults, and that the dependent
neither asked for itself nor handed down, are now a term of the dependent's hash, and so is the term of a dependency
that has one. Only what xmake hands down counts as handed down: runtimes and pic to a dependency that is not shared,
lto and asan. A configuration of the same name and value as one of the dependent's is otherwise the project's choice.
A configuration with no declared default adds nothing. A package whose dependencies are built as it asks keeps the
hash it had.

A boolean configuration declared with images_only = true matters only to what links an image or records where the
dependency is. It is a part of the hash of a binary package, of a package with the configuration shared and of a
package with the policy package.links_dependencies. Any other dependent keeps one hash under both values and is not
installed again when only that configuration differs: its manifest records the dependency's hash without such
configurations. A package which declares nothing and still installs an image that loads a library of such a
dependency fails to install.

The hash is computed again after the dependencies are loaded. The manifest and the environments read from the folder
of the first hash are read again from the folder of the new one; what a recipe's on_load reads from
package:buildhash(), package:installdir() or package:manifest_load() is still of the hash without the term.

Changes-build-output: no
---
 xmake/core/package/package.lua            | 87 +++++++++++++++++++++-
 xmake/core/project/policy.lua             |  1 +
 .../action/require/impl/actions/install.lua        | 60 ++++++++++++++-
 .../private/action/require/impl/package.lua        | 63 +++++++++++++++-
 4 files changed, 205 insertions(+), 6 deletions(-)
diff --git a/xmake/core/package/package.lua b/xmake/core/package/package.lua
--- a/xmake/core/package/package.lua
+++ b/xmake/core/package/package.lua
@@ -1152,10 +1152,15 @@
     if self:librarydeps() then
         manifest.deps = {}
         for _, dep in ipairs(self:librarydeps()) do
-            manifest.deps[dep:name()] = {
+            local info = {
                 version = dep:version_str(),
                 buildhash = dep:buildhash()
             }
+            local unlinked = dep:_unlinked_hashes()[1]
+            if unlinked ~= info.buildhash then
+                info.unlinked = unlinked
+            end
+            manifest.deps[dep:name()] = info
         end
     end
 
@@ -1348,6 +1353,7 @@
     local manifest = self:manifest_load()
     if manifest then
         local envs = self:_rawenvs()
+        self._ENVS_BEFORE_MANIFEST = table.copy(envs)
         for name, values in pairs(manifest.envs) do
             envs[name] = values
         end
@@ -1803,6 +1809,68 @@
     self:buildhash()
 end
 
+function _instance:_links_dependencies()
+    return self:policy("package.links_dependencies") == true or self:is_binary() or self:config("shared") == true
+end
+
+function _instance:_deps_variant(linked)
+    if linked then
+        return self._DEPS_LINKED
+    end
+    return self._DEPS_UNLINKED
+end
+
+function _instance:_deps_variant_set(linked, unlinked)
+    self._DEPS_LINKED = linked
+    self._DEPS_UNLINKED = unlinked
+    self._BUILDHASH = nil
+    self._INSTALLDIR = nil
+    self._MANIFEST = nil
+    if self._ENVS_BEFORE_MANIFEST then
+        self._RAWENVS = self._ENVS_BEFORE_MANIFEST
+        self._ENVS_BEFORE_MANIFEST = nil
+    end
+    self:_compute_buildhash()
+    self:_load_envs()
+end
+
+function _instance:_has_images_only_configs()
+    for name in pairs(self:_configs_for_buildhash() or {}) do
+        if self:extraconf("configs", name, "images_only") then
+            return true
+        end
+    end
+    return false
+end
+
+function _instance:_unlinked_hashes()
+    local configs = table.copy(self:_configs_for_buildhash() or {})
+    local images_only = {}
+    for name in pairs(configs) do
+        if self:extraconf("configs", name, "images_only") then
+            configs[name] = self:extraconf("configs", name, "default")
+            table.insert(images_only, name)
+        end
+    end
+    local hashes = {self:buildhash(configs)}
+    for _, name in ipairs(images_only) do
+        local flipped = table.copy(configs)
+        flipped[name] = not configs[name]
+        table.insert(hashes, self:buildhash(flipped))
+    end
+    return hashes
+end
+
+function _instance:_dependency_unchanged(dep, recorded)
+    if recorded.buildhash == dep:buildhash() then
+        return true
+    end
+    if self:_links_dependencies() then
+        return false
+    end
+    return table.contains(dep:_unlinked_hashes(), recorded.unlinked or recorded.buildhash)
+end
+
 -- hash.strhash128 has been switched to xxhash.
 -- For compatibility, the old hash algorithm is still used here.
 function _instance:_strhash128(str)
@@ -1840,6 +1908,12 @@
     return #a < #b
 end
 
+function _instance:_bytes_sorted(list)
+    local sorted = table.copy(list)
+    table.sort(sorted, _bytes_less)
+    return sorted
+end
+
 local function _addons_for_buildhash()
     local addons = addon.addons()
     local terms = {}
@@ -1854,9 +1928,9 @@
 end
 
 -- get the build hash
-function _instance:buildhash()
+function _instance:buildhash(unlinked_configs)
     local buildhash = self._BUILDHASH
-    if buildhash == nil then
+    if buildhash == nil or unlinked_configs then
         if not self._BUILDHASH_PREPARED then
             os.raise("package:buildhash() must be called after loading package")
         end
@@ -1931,6 +2005,10 @@
             if #addons > 0 then
                 str = str .. "_" .. table.concat(addons, "_")
             end
+            local variant = self:_deps_variant(not unlinked_configs and self:_links_dependencies())
+            if variant then
+                str = str .. "_deps_" .. variant
+            end
             return self:_strhash128(str)
         end
         local function _get_installdir(...)
@@ -1944,6 +2022,9 @@
         local function _installed_in(buildhash)
             return os.isfile(_get_installdir(buildhash, "manifest.txt"))
         end
+        if unlinked_configs then
+            return _get_buildhash(unlinked_configs)
+        end
 
         -- we need to be compatible with the hash value string for the previous xmake version
         -- without builtin pic configuration (< 2.5.1).
diff --git a/xmake/core/project/policy.lua b/xmake/core/project/policy.lua
--- a/xmake/core/project/policy.lua
+++ b/xmake/core/project/policy.lua
@@ -182,6 +182,7 @@
             -- if true, then any updates to library dependencies, such as buildhash changes due to version changes,
             -- will force the installed packages to be recompiled and installed. @see https://github.com/xmake-io/xmake/issues/2719
             ["package.librarydeps.strict_compatibility"] = {description = "Set strict compatibility for package and it's all library dependencies.", type = "boolean"},
+            ["package.links_dependencies"]        = {description = "The package installs linked images or writes paths of its dependencies, so a configuration which matters only to those is a part of its hash.", type = "boolean"},
             -- Resolve package dependencies conflict automatically
             -- @see https://github.com/xmake-io/xmake/issues/5745
             ["package.resolve_depconflict"]       = {description = "Automatically resolve package dependencies conflict.", default = true, type = "boolean"},
