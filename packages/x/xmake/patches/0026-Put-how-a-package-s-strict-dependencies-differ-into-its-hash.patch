--- a/xmake/modules/private/action/require/impl/actions/install.lua
+++ b/xmake/modules/private/action/require/impl/actions/install.lua
@@ -21,6 +21,7 @@
 -- imports
 import("core.base.option")
 import("core.base.tty")
+import("core.base.binutils")
 import("core.package.package", {alias = "core_package"})
 import("core.package.addon")
 import("core.project.addons")
@@ -512,6 +513,58 @@
 --
 -- @param package  the package instance
 --
+function _loaded_names(dep)
+    local libraries = os.files(path.join(dep:installdir(), "**.dylib"))
+    local own = {}
+    for _, library in ipairs(libraries) do
+        own[path.filename(library)] = true
+    end
+    local names = {}
+    for _, library in ipairs(libraries) do
+        for _, name in ipairs(binutils.deplibs(library)) do
+            if own[path.filename(name)] then
+                names[name] = true
+            end
+        end
+    end
+    return names
+end
+
+function _macho_files(installdir)
+    local magics = {["\207\250\237\254"] = true, ["\206\250\237\254"] = true, ["\202\254\186\190"] = true}
+    local images = {}
+    for _, file in ipairs(os.files(path.join(installdir, "**"))) do
+        local handle = io.open(file, "rb")
+        local magic = handle:read(4)
+        handle:close()
+        if magics[magic] then
+            table.insert(images, file)
+        end
+    end
+    return images
+end
+
+function _check_linked_images(package)
+    if package:_links_dependencies() then
+        return
+    end
+    local images
+    for _, dep in ipairs(package:librarydeps() or {}) do
+        if dep:_has_images_only_configs() then
+            images = images or _macho_files(package:installdir())
+            local names = #images > 0 and _loaded_names(dep)
+            for _, image in ipairs(images) do
+                for _, name in ipairs(binutils.deplibs(image)) do
+                    if names[name] then
+                        raise("package(%s) installs %s, which loads %s of %s: declare set_policy(\"package.links_dependencies\", true), otherwise a project which builds %s another way shares this folder",
+                              package:name(), path.relative(image, package:installdir()), name, dep:name(), dep:name())
+                    end
+                end
+            end
+        end
+    end
+end
+
 function _reinstalled_meanwhile(package)
     local manifest = package:manifest_reload()
     if not manifest then
@@ -525,7 +578,7 @@
     for _, dep in ipairs(package:librarydeps() or {}) do
         if strict or dep:policy("package.strict_compatibility") then
             local info = recorded[dep:name()]
-            if not info or info.buildhash ~= dep:buildhash() then
+            if not info or not package:_dependency_unchanged(dep, info) then
                 return false
             end
         end
@@ -625,6 +678,8 @@
                 -- patch pkg-config files for package
                 _patch_pkgconfig(package)
 
+                _check_linked_images(package)
+
                 -- test it
                 test(package)
 
diff --git a/xmake/modules/private/action/require/impl/package.lua b/xmake/modules/private/action/require/impl/package.lua
--- a/xmake/modules/private/action/require/impl/package.lua
+++ b/xmake/modules/private/action/require/impl/package.lua
@@ -1198,6 +1198,53 @@
     return package
 end
 
+function _serialized_config(value)
+    if type(value) == "table" then
+        return string.serialize(value, {strip = true, indent = false, orderkeys = true})
+    end
+    return tostring(value)
+end
+
+function _inherited_by_xmake(dep, name)
+    if name == "runtimes" or name == "pic" then
+        local requireinfo = dep:requireinfo()
+        return not (requireinfo and requireinfo.configs and requireinfo.configs.shared)
+    end
+    return name == "lto" or name == "asan"
+end
+
+function _chosen_configs(dep, given, inherited, linked)
+    local chosen = {}
+    for name, value in pairs(dep:_configs_for_buildhash() or {}) do
+        local text = _serialized_config(value)
+        local default = dep:extraconf("configs", name, "default")
+        if name ~= "toolchains" and default ~= nil and text ~= _serialized_config(default)
+            and text ~= _serialized_config(given[name]) and not (_inherited_by_xmake(dep, name) and text == _serialized_config(inherited[name]))
+            and (linked or not dep:extraconf("configs", name, "images_only")) then
+            table.insert(chosen, name .. "=" .. text)
+        end
+    end
+    return dep:_bytes_sorted(chosen)
+end
+
+function _deps_variant(package, edges, linked)
+    local terms = {}
+    local inherited = package:requireinfo() and package:requireinfo().configs or {}
+    for _, edge in ipairs(edges) do
+        local dep = edge.dep
+        if dep:is_library() then
+            local chosen = dep:policy("package.strict_compatibility") and _chosen_configs(dep, edge.given, inherited, linked) or {}
+            local below = dep:_deps_variant(linked)
+            if #chosen > 0 or below then
+                table.insert(terms, dep:name() .. "[" .. table.concat(chosen, ",") .. "]" .. (below and ("(" .. below .. ")") or ""))
+            end
+        end
+    end
+    if #terms > 0 then
+        return table.concat(package:_bytes_sorted(table.unique(terms)), ";")
+    end
+end
+
