From e8261105c3f75209fa8494750e1e85cf28a92b55 Mon Sep 17 00:00:00 2001
From: revenant <revenant@example.invalid>
Date: Fri, 23 Oct 2026 03:33:21 +0200
Subject: [PATCH] Export the generation a published install links to

Patch 0015 publishes an install as a link to its generation, and the export
copied the published folder with the links kept. The exported package was then
a dangling link: its generation was not in the export, so importing it
installed nothing. The export now copies the folder the link names.

Self-review: crutches left

Changes-build-output: no

---
 .../private/action/require/impl/export_packages.lua        | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/xmake/modules/private/action/require/impl/export_packages.lua b/xmake/modules/private/action/require/impl/export_packages.lua
index b4141a7..003b351 100644
--- a/xmake/modules/private/action/require/impl/export_packages.lua
+++ b/xmake/modules/private/action/require/impl/export_packages.lua
@@ -53,7 +53,12 @@ function main(requires, opt)
         if exportpath and count == 1 and instance:fetch({force = true}) then
             print("exporting %s-%s %s", instance:displayname(), instance:version_str(), package.get_configs_str(instance))
             cprint("  ${yellow}->${clear} %s", exportpath)
-            os.cp(installdir, exportpath, {symlink = true})
+            -- a published install is a link to its generation, and the export is the generation's files
+            local source = installdir
+            if os.islink(source) then
+                source = path.join(path.directory(source), os.readlink(source))
+            end
+            os.cp(source, exportpath, {symlink = true})
             os.tryrm(path.join(exportpath, "references.txt"))
             table.insert(packages, instance)
         end
