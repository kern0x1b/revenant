index 224841c..bd8fe2e 100644
--- a/xmake/modules/async/runjobs.lua
+++ b/xmake/modules/async/runjobs.lua
@@ -20,6 +20,7 @@
 
 -- imports
 import("core.base.scheduler")
+import("core.base.jobserver")
 import("utils.progress")
 import("utils.waiting_indicator")
 
@@ -375,6 +376,31 @@ function _waiting_indicator_loop(state)
     state.waiting_indicator_semaphore = nil
 end
 
+function _take_token(state, run_in_remote)
+    if run_in_remote or not jobserver.client() then
+        return
+    end
+    while not state.stop do
+        if not state.implicit_token_held then
+            state.implicit_token_held = true
+            return true
+        end
+        local token = jobserver.take()
+        if token then
+            return token
+        end
+        os.sleep(20)
+    end
+end
+
+function _give_token(state, token)
+    if token == true then
+        state.implicit_token_held = false
+    elseif token then
+        jobserver.give(token)
+    end
+end
+
 -- consume jobs
 function _consume_jobs_loop(state, run_in_remote)
     local jobs = state.jobs
@@ -427,10 +453,16 @@ function _consume_jobs_loop(state, run_in_remote)
             end
         end
 
+        local token
         try
         {
             function ()
 
+                token = _take_token(state, run_in_remote)
+                if state.stop or (not job and state.finished_count >= total) then
+                    return
+                end
+
                 -- mark the current coroutine to run remote job
                 if run_in_remote and co_running then
                     co_running:data_set("distcc.distccjob", job_distcc)
@@ -498,6 +530,7 @@ function _consume_jobs_loop(state, run_in_remote)
             finally
             {
                 function ()
+                    _give_token(state, token)
                     if job then
                         jobs:remove(job)
                     end
