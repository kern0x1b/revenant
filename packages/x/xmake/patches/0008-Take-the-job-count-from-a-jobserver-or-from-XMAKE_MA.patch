diff --git a/core/src/xmake/io/jobserver.c b/core/src/xmake/io/jobserver.c
new file mode 100644
index 0000000..ed43b19
--- /dev/null
+++ b/core/src/xmake/io/jobserver.c
@@ -0,0 +1,67 @@
+#include "prefix.h"
+#if !defined(TB_CONFIG_OS_WINDOWS) || defined(TB_COMPILER_LIKE_UNIX)
+#    include <errno.h>
+#    include <fcntl.h>
+#    include <unistd.h>
+#    define XM_IO_JOBSERVER_FIFO 1
+#endif
+
+tb_int_t xm_io_jobserver_open(lua_State *lua) {
+    tb_assert_and_check_return_val(lua, 0);
+    tb_char_t const *path = luaL_checkstring(lua, 1);
+#ifdef XM_IO_JOBSERVER_FIFO
+    tb_int_t fd = open(path, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+    if (fd >= 0) {
+        lua_pushinteger(lua, fd);
+        return 1;
+    }
+#endif
+    lua_pushnil(lua);
+    return 1;
+}
+
+tb_int_t xm_io_jobserver_take(lua_State *lua) {
+    tb_assert_and_check_return_val(lua, 0);
+    tb_int_t fd = (tb_int_t)luaL_checkinteger(lua, 1);
+#ifdef XM_IO_JOBSERVER_FIFO
+    tb_char_t token = 0;
+    ssize_t   real  = -1;
+    do {
+        real = read(fd, &token, 1);
+    } while (real < 0 && errno == EINTR);
+    if (real == 1) {
+        lua_pushlstring(lua, &token, 1);
+        return 1;
+    }
+#endif
+    lua_pushnil(lua);
+    return 1;
+}
+
+tb_int_t xm_io_jobserver_give(lua_State *lua) {
+    tb_assert_and_check_return_val(lua, 0);
+    tb_int_t         fd    = (tb_int_t)luaL_checkinteger(lua, 1);
+    size_t           size  = 0;
+    tb_char_t const *token = luaL_checklstring(lua, 2, &size);
+    tb_bool_t        ok    = tb_false;
+#ifdef XM_IO_JOBSERVER_FIFO
+    ssize_t real = -1;
+    if (size == 1) {
+        do {
+            real = write(fd, token, 1);
+        } while (real < 0 && errno == EINTR);
+    }
+    ok = real == 1;
+#endif
+    lua_pushboolean(lua, ok);
+    return 1;
+}
+
+tb_int_t xm_io_jobserver_close(lua_State *lua) {
+    tb_assert_and_check_return_val(lua, 0);
+    tb_int_t fd = (tb_int_t)luaL_checkinteger(lua, 1);
+#ifdef XM_IO_JOBSERVER_FIFO
+    close(fd);
+#endif
+    return 0;
+}
diff --git a/xmake/core/base/jobserver.lua b/xmake/core/base/jobserver.lua
new file mode 100644
index 0000000..7b04d40
--- /dev/null
+++ b/xmake/core/base/jobserver.lua
@@ -0,0 +1,92 @@
+local jobserver = jobserver or {}
+local _instance = _instance or {}
+
+local io = require("base/io")
+local os = require("base/os")
+local table = require("base/table")
+
+function _instance:take()
+    if self.fd then
+        return io.jobserver_take(self.fd)
+    end
+end
+
+function _instance:give(token)
+    if self.fd and token then
+        return io.jobserver_give(self.fd, token)
+    end
+end
+
+function _instance:close()
+    if self.fd then
+        io.jobserver_close(self.fd)
+        self.fd = nil
+    end
+end
+
+function jobserver.open(fifo)
+    if fifo and io.jobserver_open then
+        local fd = io.jobserver_open(fifo)
+        if fd then
+            local instance = table.inherit(_instance)
+            instance.fd = fd
+            instance.fifo = fifo
+            return instance
+        end
+    end
+end
+
+function jobserver.auth(makeflags)
+    makeflags = makeflags or os.getenv("MAKEFLAGS")
+    if makeflags then
+        return makeflags:match("%-%-jobserver%-auth=fifo:(%S+)")
+    end
+end
+
+function jobserver.client()
+    local client = jobserver._CLIENT
+    if client == nil then
+        client = jobserver.open(jobserver.auth()) or false
+        jobserver._CLIENT = client
+    end
+    return client or nil
+end
+
+function jobserver.take()
+    local client = jobserver.client()
+    if client then
+        return client:take()
+    end
+end
+
+function jobserver.give(token)
+    local client = jobserver.client()
+    if client then
+        return client:give(token)
+    end
+end
+
+function jobserver.hold(njob, func)
+    njob = math.max(math.floor(tonumber(njob) or 1), 1)
+    if not jobserver.client() then
+        return func(njob)
+    end
+    local tokens = {}
+    while #tokens + 1 < njob do
+        local token = jobserver.take()
+        if not token then
+            break
+        end
+        table.insert(tokens, token)
+    end
+    local ok, result = pcall(func, #tokens + 1)
+    for _, token in ipairs(tokens) do
+        jobserver.give(token)
+    end
+    if not ok then
+        error(result, 0)
+    end
+    return result
+end
+
+return jobserver
