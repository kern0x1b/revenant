diff --git a/tests/actions/addon/projects/autofetch-release/xmake.lua b/tests/actions/addon/projects/autofetch-release/xmake.lua
new file mode 100644
index 0000000..fe8884a
--- /dev/null
+++ b/tests/actions/addon/projects/autofetch-release/xmake.lua
@@ -0,0 +1,6 @@
+add_addons("custom-include 1.0.0")
+
+includes("@addon/custom-include/release")
+
+target("test")
+    set_kind("phony")
diff --git a/tests/actions/addon/test.lua b/tests/actions/addon/test.lua
index f7c4e81..6da1da2 100644
--- a/tests/actions/addon/test.lua
+++ b/tests/actions/addon/test.lua
@@ -149,6 +149,36 @@ function _with_versions(name, versions, func)
     }
 end
 
+function _release(name, versions, gitdir)
+    for _, cachedir in ipairs(os.dirs(path.join(global.cachedir(), "packages", "*", name:sub(1, 1), name))) do
+        os.tryrm(cachedir)
+    end
+    os.cp(_addondir(name), gitdir)
+    local function git(argv)
+        return os.iorunv("git", table.join({"-C", gitdir, "-c", "user.name=xmake", "-c", "user.email=xmake@localhost"}, argv))
+    end
+    git({"init", "-q"})
+    local body = ("add_urls(%q)"):format("file://" .. path.join(path.absolute(gitdir), ".git"))
+    for _, version in ipairs(versions) do
+        io.writefile(path.join(gitdir, "includes", "release", "xmake.lua"),
+            ("print(\"%s: release %s is loaded\")\n"):format(name, version))
+        git({"add", "-A"})
+        git({"commit", "-q", "-m", version})
+        body = body .. ("\n    add_versions(%q, %q)"):format(version, git({"rev-parse", "HEAD"}):trim())
+    end
+    return body
+end
+
+function _active_version(name)
+    local script = ("import(\"core.package.addon\"); local addoninfo = addon.addons()[%q]; print(addoninfo and addoninfo.version)"):format(name)
+    return os.iorunv("xmake", {"lua", "-c", script}, {curdir = os.scriptdir()}):trim()
+end
+
+function _locked_version(projectdir, name)
+    local lockinfo = io.load(path.join(projectdir, "xmake-addons.lock"))
+    return lockinfo and lockinfo[name] and lockinfo[name].version
+end
+
 -- run the given command in a temporary project and return its output
 function _run_project(content, argv, opt)
     opt = opt or {}
@@ -500,6 +530,45 @@ function test_autofetch_declared_version(t)
     end)
 end
 
+function test_autofetch_lock_declared_version(t)
+    local gitdir = os.tmpfile() .. ".addon-release"
+    os.tryrm(gitdir)
+    local recipes = {["custom-include"] = _release("custom-include", {"1.0.0", "2.0.0"}, gitdir)}
+    try
+    {
+        function ()
+            _with_repo(recipes, function ()
+                _remove("custom-include")
+                os.runv("xmake", {"addon", "--install", "-y", "custom-include 1.0.0"})
+                os.runv("xmake", {"addon", "--install", "-y", "custom-include 2.0.0"})
+                t:are_equal(_active_version("custom-include"), "2.0.0")
+                _with_project("autofetch-release", function (projectdir)
+
+                    t:require(os.iorunv("xmake", {"config", "-y"}):find("custom-include: release 1.0.0 is loaded", 1, true))
+                    t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
+
+                    os.runv("xmake", {"addon", "--install", "--force", "-y", "custom-include 2.0.0"})
+                    t:are_equal(_active_version("custom-include"), "2.0.0")
+                    t:require(os.iorunv("xmake", {"config", "-y"}):find("custom-include: release 1.0.0 is loaded", 1, true))
+                    t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
+
+                    os.runv("xmake", {"addon", "--upgrade", "-y"})
+                    t:are_equal(_locked_version(projectdir, "custom-include"), "1.0.0")
+                end)
+            end)
+        end,
+        finally
+        {
+            function (ok, errors)
+                os.tryrm(gitdir)
+                if not ok then
+                    raise(errors)
+                end
+            end
+        }
+    }
+end
+
 -- a locked version which is not installed must not hide the addon
 --
 -- @note the auto-fetch installs the locked version, but the commands which do not load
diff --git a/xmake/core/package/addon.lua b/xmake/core/package/addon.lua
index a274cee..e0b2e3d 100644
--- a/xmake/core/package/addon.lua
+++ b/xmake/core/package/addon.lua
@@ -495,6 +495,11 @@ function addon.versions(name)
     return table.orderkeys(addoninfo and addoninfo.versions or {})
 end
 
+function addon.versioninfo(name, version)
+    local addoninfo = addon._registry()[addon.dirname(name)]
+    return addoninfo and addoninfo.versions and addoninfo.versions[version]
+end
+
 -- get all installed addons, only the active version of each addon
 --
 -- @param opt   the options, e.g. {force = true}, we need it to reload the registry
diff --git a/xmake/core/sandbox/modules/import/core/package/addon.lua b/xmake/core/sandbox/modules/import/core/package/addon.lua
index 16b8620..d967738 100644
--- a/xmake/core/sandbox/modules/import/core/package/addon.lua
+++ b/xmake/core/sandbox/modules/import/core/package/addon.lua
@@ -36,6 +36,7 @@ sandbox_core_package_addon.payloadroot       = addon.payloadroot
 sandbox_core_package_addon.addons            = addon.addons
 sandbox_core_package_addon.versions          = addon.versions
 sandbox_core_package_addon.activate          = addon.activate
+sandbox_core_package_addon.versioninfo       = addon.versioninfo
 sandbox_core_package_addon.unregister        = addon.unregister
 
 -- get the manifest of the given addon directory, e.g. <sourcedir>/addon.lua
diff --git a/xmake/modules/private/action/addon/impl/install_addons.lua b/xmake/modules/private/action/addon/impl/install_addons.lua
index 926a719..aa00788 100644
--- a/xmake/modules/private/action/addon/impl/install_addons.lua
+++ b/xmake/modules/private/action/addon/impl/install_addons.lua
@@ -19,6 +19,7 @@
 --
 
 -- imports
+import("core.base.semver")
 import("core.package.addon")
 import("core.project.addons")
 import("private.action.addon.impl.xrepo", {alias = "xrepo_addon"})
@@ -41,12 +42,30 @@ function _get_requires(declared, locked)
     return requires
 end
 
+function _installed_version(requirestr, installed)
+    local name, range = addons.requirename(requirestr)
+    if not range or range == "latest" then
+        local addoninfo = installed[addon.dirname(name)]
+        return addoninfo and addoninfo.version
+    end
+
+    local versions = {}
+    local branches = {}
+    for _, version in ipairs(addon.versions(name)) do
+        table.insert(semver.is_valid(version) and versions or branches, version)
+        if #range >= 7 and range:match("^%x+$") and range:startswith(version) then
+            return version
+        end
+    end
+    return try { function () return semver.select(range, versions, {}, branches) end }
+end
+
 -- lock the installed addons, so that we always get the same ones
 --
 -- @note we get the installed versions from the addons registry, they are
 -- registered when installing them, @see core/package/addon.lua
 --
-function _lock_addons(projectdir, declared)
+function _lock_addons(projectdir, requires)
     local lockinfo = {}
     local locked = addons.locked(projectdir) or {}
 
@@ -54,9 +73,11 @@ function _lock_addons(projectdir, declared)
     -- and we must not see them through the locked versions, we are locking them right now,
     -- e.g. `xmake addon --upgrade` pins the old ones before loading this project
     local installed = addon.addons({force = true, unpinned = true})
-    for _, requirestr in ipairs(declared) do
+    for _, requirestr in ipairs(requires) do
         local name = addons.requirename(requirestr)
-        local addoninfo = assert(installed[addon.dirname(name)], "addon(%s) is not installed!", name)
+        local version = _installed_version(requirestr, installed)
+        local addoninfo = assert(version and addon.versioninfo(name, version), "addon(%s) is not installed! the installed versions: %s",
+            requirestr, table.concat(addon.versions(name), ", "))
         local oldversion = locked[name] and locked[name].version
         if oldversion and oldversion ~= addoninfo.version then
             cprint("${color.success}upgrade ${bright}%s${clear}: %s -> %s", name, oldversion, addoninfo.version)
@@ -122,10 +143,11 @@ function main(projectdir, datafile, opt)
     end
 
     -- install them with xrepo, it installs the packages in its own working directory
+    local requires = _get_requires(declared, locked)
     try
     {
         function ()
-            xrepo_addon("install", _get_requires(declared, locked), {includes = rcfile})
+            xrepo_addon("install", requires, {includes = rcfile})
         end,
         finally
         {
@@ -142,5 +164,5 @@ function main(projectdir, datafile, opt)
     }
 
     -- and lock them, so that the other users get the same versions
-    _lock_addons(projectdir, declared)
+    _lock_addons(projectdir, requires)
 end
