@@ -79,6 +79,13 @@ tb_filelock_ref_t tb_filelock_init_from_path(tb_char_t const* path, tb_size_t mo
     tb_assert_and_check_return_val(path, tb_null);
     return tb_filelock_init_impl(tb_file_init(path, mode), tb_true);
 }
+tb_file_ref_t tb_filelock_file(tb_filelock_ref_t self)
+{
+    tb_filelock_t* lock = (tb_filelock_t*)self;
+    tb_assert_and_check_return_val(lock, tb_null);
+
+    return lock->file;
+}
