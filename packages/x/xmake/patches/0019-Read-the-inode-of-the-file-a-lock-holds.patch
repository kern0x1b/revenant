+function _filelock:inode()
+    local ok, errors = self:_ensure_opened()
+    if not ok then
+        return nil, errors
+    end
+    return io.filelock_inode(self:cdata())
+end
+
 -- is locked?
 function _filelock:islocked()
     return self._LOCKED_NUM > 0
