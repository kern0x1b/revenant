+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ *
+ * Copyright (C) 2015-present, Xmake Open Source Community.
+ *
+ * @file        filelock_inode.c
+ *
+ */
+/* //////////////////////////////////////////////////////////////////////////////////////
+ * trace
+ */
+#define TB_TRACE_MODULE_NAME "filelock_inode"
+#define TB_TRACE_MODULE_DEBUG (0)
+#include "prefix.h"
+#if !(defined(TB_CONFIG_OS_WINDOWS) && !defined(TB_COMPILER_LIKE_UNIX))
+#    include <sys/stat.h>
+#endif
+tb_int_t xm_io_filelock_inode(lua_State *lua) {
+    tb_assert_and_check_return_val(lua, 0);
+    if (!xm_lua_ispointer(lua, 1)) {
+        lua_pushnil(lua);
+        return 1;
+    }
+    tb_filelock_ref_t lock = (tb_filelock_ref_t)xm_lua_topointer(lua, 1);
+    tb_check_return_val(lock, 0);
+#if defined(TB_CONFIG_OS_WINDOWS) && !defined(TB_COMPILER_LIKE_UNIX)
+    lua_pushnil(lua);
+#else
+    struct stat info;
+    tb_int_t fd = tb_file2fd(tb_filelock_file(lock));
+    if (fd >= 0 && fstat(fd, &info) == 0) {
+        lua_pushinteger(lua, (lua_Integer)info.st_ino);
+    } else {
+        lua_pushnil(lua);
+    }
+#endif
+    return 1;
+}
