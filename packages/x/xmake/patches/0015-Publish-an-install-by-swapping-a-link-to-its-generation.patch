From 17445034d925ee3eb1fb410b3bdd69de69e2a574 Mon Sep 17 00:00:00 2001
From: revenant <revenant@example.invalid>
Date: Fri, 23 Oct 2026 03:06:15 +0200
Subject: [PATCH] Publish an install by swapping a link to its generation

An install cleared its folder and then built into it, so a reader in another
process could find the folder missing or half-written during a forced
reinstall. Readers do not take the package lock, and the lock only ordered
installers.

An install now builds into a new generation folder next to the published
one, named <installdir>.g<token>. The published installdir is a link to the
generation, and publishing swaps the link with one rename, so a reader gets
the old install or the new one, whole. The previous generation stays until
the next publish, so a reader that resolved it still finds its files.

A generation is never renamed: the manifest and the files of the install
record its path, so only the link moves. A failed install removes its
generation and leaves the published install as it was. Uninstall removes the
link and its generation, and import builds into a generation and publishes
it the same way.

Measured with a forced reinstall of a 40-file package while another process
reads it: the unpatched xmake showed an incomplete install in 162 of 204
reads, this one in none of 74.
---
 xmake/core/package/addon.lua                  |  7 +-
 xmake/core/package/package.lua                | 76 ++++++++++++++++++-
 .../action/require/impl/actions/install.lua   | 18 +++--
 .../action/require/impl/import_packages.lua   |  5 +-
 .../require/impl/uninstall_packages.lua       |  2 +-
 5 files changed, 93 insertions(+), 15 deletions(-)

diff --git a/xmake/core/package/addon.lua b/xmake/core/package/addon.lua
index 7c6c8fd..382ca69 100644
--- a/xmake/core/package/addon.lua
+++ b/xmake/core/package/addon.lua
@@ -945,7 +945,12 @@ function addon.remove(name, opt)
         end
     end
     if os.islink(installdir) then
-        return os.rmfile(installdir)
+        os.rmfile(installdir)
+        -- an install is published as a link, and its generations are kept next to the link
+        for _, generation in ipairs(os.dirs(installdir .. ".g*")) do
+            os.rm(generation)
+        end
+        return true
     end
 
     local ok, errors = os.rm(installdir)
diff --git a/xmake/core/package/package.lua b/xmake/core/package/package.lua
index a4499b8..4e7a792 100644
--- a/xmake/core/package/package.lua
+++ b/xmake/core/package/package.lua
@@ -827,7 +827,7 @@ end
 function _instance:filelock()
     local filelock = self._FILELOCK
     if filelock == nil then
-        local lockfile = self:installdir() .. ".lock"
+        local lockfile = self:_publicdir() .. ".lock"
         os.mkdir(path.directory(lockfile))
         filelock = io.openlock(lockfile)
         if not filelock then
@@ -941,7 +941,8 @@ end
 -- @param ...   the subdirectory components (optional)
 -- @return      the install directory path
 --
-function _instance:installdir(...)
+-- get the published install directory, which readers of the store use
+function _instance:_publicdir()
     local installdir = self._INSTALLDIR
     if not installdir then
         installdir = self:get("installdir")
@@ -976,6 +977,13 @@ function _instance:installdir(...)
         end
         self._INSTALLDIR = installdir
     end
+    return installdir
+end
+
+-- get the install directory, or a folder or file in it: while this process installs the package, it is the
+-- generation the install builds into, otherwise it is the published directory
+function _instance:installdir(...)
+    local installdir = self._STAGINGDIR or self:_publicdir()
     local dirs = table.pack(...)
     local opt = dirs[dirs.n]
     if table.is_dictionary(opt) then
@@ -993,6 +1001,68 @@ function _instance:installdir(...)
     return dir
 end
 
+-- begin an install: it builds into a new generation folder next to the published directory, which is left as it
+-- is until the generation is published
+function _instance:staging_begin()
+    local staging = self:_publicdir() .. ".g" .. hash.rand32()
+    os.mkdir(staging)
+    self._STAGINGDIR = staging
+    return staging
+end
+
+-- publish the generation the install built: the published directory is a link to the generation, and the link
+-- is swapped in one rename, so a reader gets the old install or the new one, never a part of either. The old
+-- generation stays until the next publish, so that a reader which resolved it still finds all of its files.
+function _instance:staging_publish()
+    local staging = self._STAGINGDIR
+    if not staging then
+        return
+    end
+    local publicdir = self:_publicdir()
+    local previous
+    if os.islink(publicdir) then
+        previous = os.readlink(publicdir)
+    elseif os.isdir(publicdir) then
+        -- an install folder from before generations existed becomes the previous generation
+        local legacy = publicdir .. ".g" .. hash.rand32()
+        if not os.rename(publicdir, legacy) then
+            os.raise("cannot move the install of %s aside", self:displayname())
+        end
+        previous = path.filename(legacy)
+    end
+    local link = publicdir .. ".t" .. hash.rand32()
+    os.ln(path.filename(staging), link)
+    if not os.rename(link, publicdir) then
+        os.rm(link)
+        os.raise("cannot publish the install of %s", self:displayname())
+    end
+    self._STAGINGDIR = nil
+    local keep = {[path.filename(staging)] = true, [previous or ""] = true}
+    for _, generation in ipairs(os.dirs(publicdir .. ".g*")) do
+        if not keep[path.filename(generation)] then
+            os.rm(generation)
+        end
+    end
+end
+
+-- abandon an install: its generation is removed, and the published directory is left as it was
+function _instance:staging_abort()
+    local staging = self._STAGINGDIR
+    if staging then
+        os.rm(staging)
+        self._STAGINGDIR = nil
+    end
+end
+
+-- remove the install of this package: the published link, which leaves its generation, and every generation
+function _instance:remove_installdir()
+    local publicdir = self:_publicdir()
+    os.rm(publicdir)
+    for _, generation in ipairs(os.dirs(publicdir .. ".g*")) do
+        os.rm(generation)
+    end
+end
+
 -- get the script directory
 function _instance:scriptdir()
     return self._SCRIPTDIR
@@ -1148,7 +1218,7 @@ function _instance:manifest_save()
     -- @see https://github.com/xmake-io/xmake/issues/2210
     --
     manifest.artifacts = {}
-    manifest.artifacts.installdir = self:installdir()
+    manifest.artifacts.installdir = self:_publicdir()
     local current_manifest = self:manifest_load()
     if current_manifest and current_manifest.artifacts then
         manifest.artifacts.remotedir = current_manifest.artifacts.remotedir
diff --git a/xmake/modules/private/action/require/impl/actions/install.lua b/xmake/modules/private/action/require/impl/actions/install.lua
index c2fd45e..3585732 100644
--- a/xmake/modules/private/action/require/impl/actions/install.lua
+++ b/xmake/modules/private/action/require/impl/actions/install.lua
@@ -362,10 +362,11 @@ function _get_installdir_failed(package)
     return path.join(package:cachedir(), "installdir.failed")
 end
 
--- clear install directory
+-- clear install directory: the install builds into a new generation, and the published one stays readable until
+-- the new one is published
 function _clear_installdir(package)
-    os.tryrm(package:installdir())
     os.tryrm(_get_installdir_failed(package))
+    package:staging_begin()
 end
 
 -- clear source directory
@@ -423,11 +424,8 @@ end
 -- leave working directory
 function _leave_workdir(package, oldir)
 
-    -- clean the empty package directory
-    local installdir = package:installdir()
-    if os.emptydir(installdir) then
-        os.tryrm(installdir)
-    end
+    -- an install which did not publish its generation leaves nothing behind
+    package:staging_abort()
 
     -- unlock this package
     package:unlock()
@@ -632,6 +630,9 @@ function main(package)
 
                 -- test it
                 test(package)
+
+                -- publish the install: readers get it whole, or the one it replaces
+                package:staging_publish()
             end
 
             -- leave the package environments
@@ -672,7 +673,8 @@ function main(package)
                     end
                     errorfile = path.join(installdir_failed, "logs", "install.txt")
                 end
-                os.tryrm(installdir)
+                -- nothing was published, so the published install stays as it was
+                package:staging_abort()
 
                 -- the addon is registered before testing it, its `on_test` needs to use it,
                 -- e.g. xmake create -t esp32.blink, so we need to unregister it again here,
diff --git a/xmake/modules/private/action/require/impl/import_packages.lua b/xmake/modules/private/action/require/impl/import_packages.lua
index 134cf63..c43a844 100644
--- a/xmake/modules/private/action/require/impl/import_packages.lua
+++ b/xmake/modules/private/action/require/impl/import_packages.lua
@@ -43,8 +43,9 @@ function main(requires, opt)
         if importpath and count == 1 then
             print("importing %s-%s %s", instance:displayname(), instance:version_str(), package.get_configs_str(instance))
             cprint("  ${yellow}<-${clear} %s", importpath)
-            os.tryrm(installdir)
-            os.cp(importpath, installdir, {symlink = true})
+            instance:staging_begin()
+            os.cp(path.join(importpath, "*"), instance:installdir(), {symlink = true})
+            instance:staging_publish()
             table.insert(packages, instance)
         end
     end
diff --git a/xmake/modules/private/action/require/impl/uninstall_packages.lua b/xmake/modules/private/action/require/impl/uninstall_packages.lua
index 685b5c9..2d7ebf8 100644
--- a/xmake/modules/private/action/require/impl/uninstall_packages.lua
+++ b/xmake/modules/private/action/require/impl/uninstall_packages.lua
@@ -45,7 +45,7 @@ function main(requires, opt)
         if os.isfile(instance:manifest_file()) then
             table.insert(packages, instance)
         end
-        os.tryrm(instance:installdir())
+        instance:remove_installdir()
     end
     return packages
 end
