+++ b/tests/actions/addon/test.lua
@@ -680,6 +680,47 @@ function test_inherited_pin_missing_version(t)
     end)
 end
 
+function test_sourcedir_addons(t)
+    local names = {"custom-rule", "custom-include", "custom-module", "custom-toolchain", "custom-plugin"}
+    local declarations = {}
+    for _, name in ipairs(names) do
+        _remove(name)
+        table.insert(declarations, ("add_addons(%q, {sourcedir = %q})"):format(name, _addondir(name)))
+    end
+    local projectfile = table.concat(declarations, "\n") .. [[
+
+includes("@addon/custom-include/check")
+target("test")
+    set_kind("phony")
+    add_rules("@addon/custom-rule/hello")
+    on_config(function (target)
+        import("core.package.addon")
+        import("core.tool.toolchain")
+        import("core.tools.mycl6x")
+        import("@addon.custom-module.greeting")
+        assert(mycl6x.compargv)
+        print(greeting("project"))
+        print(toolchain.load("@addon/custom-toolchain/my-c6000"):get("description"))
+        local script = "import(\"@addon.custom-module.greeting\"); print(greeting(\"child\"))"
+        print(os.iorunv("xmake", {"lua", "-c", script}, {curdir = addon.workdir()}))
+    end)
+]]
+    local output = _config_project(projectfile)
+    t:require(output:find("custom-include: includes check is loaded", 1, true))
+    t:require(output:find("custom-rule: hello from custom-rule: test", 1, true))
+    t:require(output:find("hello from custom-module: project", 1, true))
+    t:require(output:find("the custom toolchain of the tests", 1, true))
+    t:require(output:find("hello from custom-module: child", 1, true))
+    t:require_not(output:find("this project needs the addons", 1, true))
+    t:require(_run_project(projectfile, {"hello_addon", "-n", "xmake"}):find("hello from custom-plugin: xmake", 1, true))
+    for _, name in ipairs(names) do
+        t:require_not(os.isdir(path.join(global.directory(), "addons", name)))
+    end
+    t:require_not(try { function () os.runv("xmake", {"hello_addon"}); return true end })
+    local mismatched = ("add_addons(\"custom-rule\", {sourcedir = %q})"):format(_addondir("custom-include"))
+    t:require_not(try { function () _config_project(mismatched); return true end })
+end
+
