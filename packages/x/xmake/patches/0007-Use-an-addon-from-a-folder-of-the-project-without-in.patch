diff --git a/xmake/core/project/project.lua b/xmake/core/project/project.lua
index a208567..78698c9 100644
--- a/xmake/core/project/project.lua
+++ b/xmake/core/project/project.lua
@@ -263,6 +263,33 @@ function project._pin_addons()
     end
 end
 
+function project._use_addons(rootinfo)
+    local used = false
+    local printed = false
+    local configs = rootinfo:extraconf("addons") or {}
+    for _, requirestr in ipairs(table.wrap(rootinfo:get("addons"))) do
+        local sourcedir = configs[requirestr] and configs[requirestr].sourcedir
+        if sourcedir then
+            local name = addons.requirename(requirestr)
+            local ok, errors = addon.use(name, path.absolute(sourcedir, os.projectdir()))
+            if ok == nil then
+                return nil, errors
+            end
+            if baseoption.get("verbose") and not project._ADDONS_PRINTED then
+                utils.print("addon(%s): %s", name, addon.addondir(name))
+                printed = true
+            end
+            used = used or ok
+        end
+    end
+    project._ADDONS_PRINTED = project._ADDONS_PRINTED or printed
+    if used then
+        rule.clear()
+        task.clear()
+    end
+    return used
+end
+
 -- do install the addons which this project declares
 -- install the addons which this project declares, e.g. add_addons("esp32-devel 1.0.x")
 --
@@ -279,6 +306,10 @@ function project._do_install_addons(rootinfo)
     if not ok then
         return {ok = false, errors = errors}
     end
+    requires = addons.installable(requires, rootinfo:extraconf("addons"))
+    if #requires == 0 then
+        return {ok = true}
+    end
 
     -- they have been installed already?
     if addons.satisfied(requires) then
@@ -401,16 +432,25 @@ function project._load(opt)
     -- @note we do not install them for the option menu, it merges the project tasks in a
     -- best-effort way and every command builds it, @see project._load_tasks()
     --
+    local used, errors = project._use_addons(rootinfo)
+    if used == nil then
+        os.cd(oldir)
+        return false, errors
+    end
     if not opt.skip_addons and not opt.addons_installed then
         local result = project._install_addons(rootinfo)
         if not result.ok then
             os.cd(oldir)
             return false, result.errors
         end
-        if result.installed then
+        if result.installed or used then
             os.cd(oldir)
             return project._load({force = true, disable_filter = opt.disable_filter, addons_installed = true})
         end
+    elseif used then
+        os.cd(oldir)
+        return project._load({force = true, disable_filter = opt.disable_filter, skip_addons = opt.skip_addons,
+                              addons_installed = opt.addons_installed})
     end
 
     -- load the root info of the target
