+function addon._load_sourcedir(name, sourcedir)
+    local manifest, errors = addon.manifest(sourcedir)
+    if errors then
+        return nil, errors
+    end
+    local dirname = addon.dirname(name)
+    if manifest and addon.dirname(manifest.name) ~= dirname then
+        return nil, string.format("addon(%s): %s provides the addon(%s)!", name, sourcedir, manifest.name)
+    end
+    local rootdir = addon.payloadroot(sourcedir)
+    if not rootdir then
+        return nil, string.format("addon(%s): no payload directory found in %s, e.g. plugins!", name, sourcedir)
+    end
+    local addoninfo = {version = "latest",
+                       name = name ~= dirname and name or nil,
+                       description = manifest and manifest.description,
+                       globalmodules = manifest and #manifest.globalmodules > 0 and manifest.globalmodules or nil,
+                       sourcedir = sourcedir,
+                       rootdir = rootdir,
+                       payloads = addon.payloads_of(rootdir),
+                       plugins = addon._plugins_of(rootdir),
+                       templates = addon._templates_of(rootdir)}
+    errors = addon._check_conflicts(dirname, addoninfo)
+    if errors then
+        return nil, errors
+    end
+    return addoninfo
+end
+
+function addon._used()
+    local used = addon._USED
+    if used == nil then
+        used = {}
+        addon._USED = used
+        local envsourcedirs = os.getenv("XMAKE_ADDONS_SOURCEDIRS")
+        if envsourcedirs then
+            local sourcedirs, errors = envsourcedirs:deserialize()
+            if not sourcedirs then
+                utils.warning("XMAKE_ADDONS_SOURCEDIRS(%s) is ignored, %s", envsourcedirs, errors or "it is invalid")
+            end
+            for name, sourcedir in pairs(sourcedirs or {}) do
+                local addoninfo, errors = addon._load_sourcedir(name, sourcedir)
+                if addoninfo then
+                    used[addon.dirname(name)] = addoninfo
+                else
+                    utils.warning(errors)
+                end
+            end
+            addon._ADDONS = nil
+            addon._GLOBALMODULES = nil
+        end
+    end
+    return used
+end
+
+function addon.use(name, sourcedir)
+    sourcedir = path.absolute(sourcedir)
+    local dirname = addon.dirname(name)
+    local used = addon._used()
+    if used[dirname] and used[dirname].sourcedir == sourcedir then
+        return false
+    end
+    local addoninfo, errors = addon._load_sourcedir(name, sourcedir)
+    if not addoninfo then
+        return nil, errors
+    end
+    used[dirname] = addoninfo
+    addon._ADDONS = nil
+    addon._GLOBALMODULES = nil
+    local sourcedirs = {}
+    for usedname, usedinfo in pairs(used) do
+        sourcedirs[usedinfo.name or usedname] = usedinfo.sourcedir
+    end
+    os.setenv("XMAKE_ADDONS_SOURCEDIRS", string.serialize(sourcedirs, {strip = true, indent = false}))
+    return true
+end
+
