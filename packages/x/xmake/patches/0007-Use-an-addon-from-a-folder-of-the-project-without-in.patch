diff --git a/xmake/core/project/addons.lua b/xmake/core/project/addons.lua
index b7d098b..9e9a551 100644
--- a/xmake/core/project/addons.lua
+++ b/xmake/core/project/addons.lua
@@ -82,6 +82,16 @@ function addons.requirename(requirestr)
     return splitinfo[1], splitinfo[2]
 end
 
+function addons.installable(requires, configs)
+    local result = {}
+    for _, requirestr in ipairs(requires) do
+        if not (configs and configs[requirestr] and configs[requirestr].sourcedir) then
+            table.insert(result, requirestr)
+        end
+    end
+    return result
+end
+
