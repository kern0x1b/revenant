From 30601a3b2e0a4934e9d30941d4a28a58cf948cd5 Mon Sep 17 00:00:00 2001
From: revenant <revenant@localhost>
Date: Mon, 2 Nov 2026 01:00:30 +0100
Subject: [PATCH] Keep the SDK the toolchain selects unless an Apple target
 platform names one

---
 CMakeLists.txt | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3479d8c..bf34c7d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -47,7 +47,9 @@ endif()
 
 # Has to be set before `project` as per documentation
 # https://cmake.org/cmake/help/latest/variable/CMAKE_OSX_SYSROOT.html
-set(CMAKE_OSX_SYSROOT ${HERMES_APPLE_TARGET_PLATFORM})
+if(HERMES_APPLE_TARGET_PLATFORM)
+  set(CMAKE_OSX_SYSROOT ${HERMES_APPLE_TARGET_PLATFORM})
+endif()
 
 if(HERMES_APPLE_TARGET_PLATFORM MATCHES "catalyst")
   set(CMAKE_OSX_SYSROOT "macosx")
