+  // iOS 6 has no feedback generators. An iPhone has a vibration motor, so every call becomes one system vibration;
+  // the call does not tell the pattern (impact style, notification type) apart. An iPad has no motor and a simulator
+  // has no hardware, so there the call returns without doing anything.
+  static func legacyVibrate() {
+    #if targetEnvironment(simulator)
+    NSLog("rn-host: haptics: simulator has no vibration motor; the call returns")
+    #else
+    if UIDevice.current.userInterfaceIdiom == .phone {
+      NSLog("rn-host: haptics: iOS 6 iPhone, AudioServicesPlaySystemSound(kSystemSoundID_Vibrate)")
+      AudioServicesPlaySystemSound(kSystemSoundID_Vibrate)
+    } else {
+      NSLog("rn-host: haptics: no vibration motor on this idiom; the call returns")
+    }
+    #endif
+  }
