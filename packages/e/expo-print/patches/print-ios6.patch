+++ b/ios/ExpoPrintWithPrinter.swift	2026-11-17 20:48:25
@@ -1,11 +1,57 @@
 import ExpoModulesCore
 
+private final class PrintDataConnection: NSObject, NSURLConnectionDataDelegate {
+  private var completion: ((Data?) -> Void)?
+  private var connection: NSURLConnection?
+  private var received = NSMutableData()
+  private var keepAlive: PrintDataConnection?
+
+  static func fetch(_ request: URLRequest, completion: @escaping (Data?) -> Void) -> PrintDataConnection {
+    let loader = PrintDataConnection(completion: completion)
+    loader.keepAlive = loader
+    DispatchQueue.main.async {
+      loader.connection = NSURLConnection(request: request, delegate: loader, startImmediately: true)
+      if loader.connection == nil {
+        loader.finish(nil)
+      }
+    }
+    return loader
+  }
+
+  private init(completion: @escaping (Data?) -> Void) {
+    self.completion = completion
+    super.init()
+  }
+
+  func connection(_ connection: NSURLConnection, didReceive data: Data) {
+    received.append(data)
+  }
+
+  func connection(_ connection: NSURLConnection, didFailWithError error: Error) {
+    finish(nil)
+  }
+
+  func connectionDidFinishLoading(_ connection: NSURLConnection) {
+    finish(received as Data)
+  }
+
+  private func finish(_ data: Data?) {
+    guard let completion else {
+      return
+    }
+    self.completion = nil
+    connection?.cancel()
+    connection = nil
+    keepAlive = nil
+    completion(data)
+  }
+}
