 import ExpoModulesCore
 
+private func printBase64EncodedData(_ data: Data) -> String {
+  let alphabet = Array("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
+  let bytes = Array(data)
+  var result = ""
+  var index = 0
+  while index + 2 < bytes.count {
+    let value = (Int(bytes[index]) << 16) | (Int(bytes[index + 1]) << 8) | Int(bytes[index + 2])
+    result.append(alphabet[(value >> 18) & 63])
+    result.append(alphabet[(value >> 12) & 63])
+    result.append(alphabet[(value >> 6) & 63])
+    result.append(alphabet[value & 63])
+    index += 3
+  }
+  if bytes.count - index == 1 {
+    let value = Int(bytes[index]) << 16
+    result.append(alphabet[(value >> 18) & 63])
+    result.append(alphabet[(value >> 12) & 63])
+    result.append("==")
+  } else if bytes.count - index == 2 {
+    let value = (Int(bytes[index]) << 16) | (Int(bytes[index + 1]) << 8)
+    result.append(alphabet[(value >> 18) & 63])
+    result.append(alphabet[(value >> 12) & 63])
+    result.append(alphabet[(value >> 6) & 63])
+    result.append("=")
+  }
+  return result
+}
