-  let (_, response) = try await URLSession.shared.bytes(for: request)
+  private init(completion: @escaping (Result<URLResponse, any Error>) -> Void) {
+    self.completion = completion
+    super.init()
+  }
 
+  static func fetch(_ request: URLRequest, completion: @escaping (Result<URLResponse, any Error>) -> Void) {
+    let probe = HeaderProbe(completion: completion)
+    probe.keepAlive = probe
+    DispatchQueue.main.async {
+      guard let connection = NSURLConnection(request: request, delegate: probe, startImmediately: true) else {
+        probe.finish(.failure(NSError(domain: NSURLErrorDomain, code: NSURLErrorCannotConnectToHost, userInfo: nil)))
+        return
+      }
+      probe.connection = connection
+    }
+  }
+
+  func connection(_ connection: NSURLConnection, didReceive response: URLResponse) {
+    finish(.success(response))
+  }
+
+  func connection(_ connection: NSURLConnection, didFailWithError error: any Error) {
+    finish(.failure(error))
+  }
+
+  func connectionDidFinishLoading(_ connection: NSURLConnection) {
+    finish(.failure(NSError(domain: NSURLErrorDomain, code: NSURLErrorBadServerResponse, userInfo: nil)))
+  }
+
+  private func finish(_ result: Result<URLResponse, any Error>) {
+    guard let completion else {
+      return
+    }
+    self.completion = nil
+    connection?.cancel()
+    connection = nil
+    DispatchQueue.main.async {
+      self.keepAlive = nil
+    }
+    completion(result)
+  }
+}
