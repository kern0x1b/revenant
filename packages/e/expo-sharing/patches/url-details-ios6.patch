+private final class HeaderProbe: NSObject, NSURLConnectionDataDelegate {
+  private var completion: ((Result<URLResponse, any Error>) -> Void)?
+  private var connection: NSURLConnection?
+  private var keepAlive: HeaderProbe?
 
-  // Allows us to get just the http response header without unnecessarily downloading data.
-  // This may seem like a weird way of doing this, but:
-  // 1. Doing:
-  //   var request = URLRequest(url: url)
-  //   request.httpMethod = "HEAD"
