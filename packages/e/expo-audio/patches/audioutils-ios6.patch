diff --git a/ios/AVPlayerCompat.swift b/ios/AVPlayerCompat.swift
new file mode 100644
index 0000000..7b7ae64
--- /dev/null
+++ b/ios/AVPlayerCompat.swift
@@ -0,0 +1,39 @@
+import AVFoundation
+
+extension AVPlayer {
+  var isPlayingNow: Bool {
+    if #available(iOS 10.0, *) {
+      return timeControlStatus == .playing
+    }
+    return rate != 0
+  }
+
+  var isWaitingForRate: Bool {
+    if #available(iOS 10.0, *) {
+      return timeControlStatus == .waitingToPlayAtSpecifiedRate
+    }
+    return false
+  }
+
+  var timeControlStatusName: String {
+    if #available(iOS 10.0, *) {
+      return timeControlStatusString(status: timeControlStatus)
+    }
+    return rate != 0 ? "playing" : "paused"
+  }
+
+  var waitingReasonName: String {
+    if #available(iOS 10.0, *) {
+      return reasonForWaitingToPlayString(status: reasonForWaitingToPlay)
+    }
+    return "unknown"
+  }
+
+  func playNow(atRate playbackRate: Float) {
+    if #available(iOS 10.0, *) {
+      playImmediately(atRate: playbackRate)
+    } else {
+      rate = playbackRate
+    }
+  }
+}
