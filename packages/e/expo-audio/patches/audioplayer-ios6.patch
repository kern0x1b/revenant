diff --git a/ios/AudioKeyPathObserver.swift b/ios/AudioKeyPathObserver.swift
new file mode 100644
index 0000000..9d6298f
--- /dev/null
+++ b/ios/AudioKeyPathObserver.swift
@@ -0,0 +1,43 @@
+import Foundation
+
+final class AudioKeyPathObserver: NSObject {
+  private let object: NSObject
+  private let keyPath: String
+  private let onChange: (AudioKeyPathObserver) -> Void
+  private(set) var isActive = false
+
+  init(
+    object: NSObject,
+    keyPath: String,
+    options: NSKeyValueObservingOptions,
+    onChange: @escaping (AudioKeyPathObserver) -> Void
+  ) {
+    self.object = object
+    self.keyPath = keyPath
+    self.onChange = onChange
+    super.init()
+    isActive = true
+    object.addObserver(self, forKeyPath: keyPath, options: options, context: nil)
+  }
+
+  deinit {
+    invalidate()
+  }
+
+  func invalidate() {
+    guard isActive else {
+      return
+    }
+    isActive = false
+    object.removeObserver(self, forKeyPath: keyPath)
+  }
+
+  override func observeValue(
+    forKeyPath keyPath: String?,
+    of object: Any?,
+    change: [NSKeyValueChangeKey: Any]?,
+    context: UnsafeMutableRawPointer?
+  ) {
+    onChange(self)
+  }
+}
