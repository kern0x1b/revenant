 @interface UIImage (ImageEffects)
 
diff --git a/ios/UIImage+ImageEffects.m b/ios/UIImage+ImageEffects.m
index 4d19e3a..d6988f9 100644
--- a/ios/UIImage+ImageEffects.m
+++ b/ios/UIImage+ImageEffects.m
@@ -95,7 +95,7 @@ OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
 
 #import "UIImage+ImageEffects.h"
 
